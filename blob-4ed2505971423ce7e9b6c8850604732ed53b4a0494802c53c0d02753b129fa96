import { afterEach, beforeEach, expect, it } from "vitest";
import { CardActionEngine } from "../../../src/card/actions/card-action-engine.js";
import { CommittedSaveCleanupError } from "../../../src/card/actions/save-outcome.js";
import type { AttachmentStore, AttachmentStoreInput } from "../../../src/card/attachments/attachment-store.js";
import { WasmAssetLoadError } from "../../../src/server/verified-wasm-asset.js";
import { configureStrictParity, strictParityFlags } from "../../../src/card/parity/strict-parity-flags.js";
import { createActionsTestStorage, seedCard, seedStandardDeck, JOE, SET_TYPE_ID, fakeClock, type ActionsTestStorage } from "./actions-test-storage.js";

let storage: ActionsTestStorage;
const ids = { pointer: 400, file: 401, skinType: 402, style: 410, assetInput: 411, assetOutput: 412, skin: 420, rule: 430, output: 431 };
class OutputStore implements AttachmentStore {
  files = new Map<string, Uint8Array>();
  failNextStore: Error | undefined;
  storeCalls = 0;
  failStoreAt = new Map<number, Error>();
  key(cardId: number, actionId: number, ext: string) { return `${cardId}/${actionId}${ext}`; }
  async read(cardId: number, actionId: number, ext: string) { return this.files.get(this.key(cardId, actionId, ext))?.slice(); }
  async store(input: AttachmentStoreInput) {
    this.storeCalls++;
    const key = this.key(input.cardId, input.actionId, input.ext);
    const owned = new Uint8Array(input.bytes);
    this.files.set(key, owned);
    const discardIfOwned = async () => {
      if (this.files.get(key) !== owned) return false;
      return this.files.delete(key);
    };
    const failure = this.failNextStore ?? this.failStoreAt.get(this.storeCalls);
    if (failure !== undefined) {
      const error = failure;
      this.failNextStore = undefined;
      Object.assign(error, { discardIfOwned });
      throw error;
    }
    return { identifier: `~${key}`, size: input.bytes.length, discardIfOwned };
  }
  async restoreIfUnchanged(input: AttachmentStoreInput, expected: Uint8Array) {
    const current = this.files.get(this.key(input.cardId, input.actionId, input.ext));
    if (current === undefined || current.length !== expected.length || current.some((byte, i) => byte !== expected[i])) return false;
    // This fixture's store mutates its actual Map before its first yield.
    await this.store(input);
    return true;
  }
  async discard(input: AttachmentStoreInput) { this.files.delete(this.key(input.cardId, input.actionId, input.ext)); }
}
beforeEach(async () => {
  storage = await createActionsTestStorage();
  await seedStandardDeck(storage);
  for (const row of [
    { id: ids.pointer, name: "Pointer", codename: "pointer" },
    { id: ids.file, name: "File", codename: "file" },
    { id: ids.skinType, name: "Bootswatch skin", codename: "bootswatch_skin" },
    { id: ids.style, name: "*style", codename: "style" },
    { id: ids.assetInput, name: "*asset input", codename: "asset_input" },
    { id: ids.assetOutput, name: "*asset output", codename: "asset_output" },
    { id: ids.skin, name: "Recovery Skin", typeId: ids.skinType },
    { id: ids.rule, name: "*all+*style", leftId: 7, rightId: ids.style, typeId: ids.pointer, dbContent: "Other Skin" },
    { id: ids.output, name: "*all+*style+*asset output", leftId: ids.rule, rightId: ids.assetOutput, typeId: ids.file, dbContent: "previous.css" },
  ]) await seedCard(storage, row);
});
afterEach(() => { configureStrictParity(undefined); storage.close(); });
async function snapshot() {
  const tables = ["cards", "card_acts", "card_actions", "card_changes", "card_references", "card_revisions", "card_virtuals", "sqlite_sequence"];
  return Promise.all(tables.map(table => storage.selectAll(`SELECT * FROM ${table} ORDER BY rowid`)));
}

it.each(["update", "use skin"])("retries the same %s after compiler transport failure with no partial database save or integration", async (entry) => {
  const store = new OutputStore();
  const failure = new WasmAssetLoadError("response", "synthetic first load failure");
  let broken = true, calls = 0, integrations = 0;
  const engine = new CardActionEngine(storage.engine, { actor: JOE, now: fakeClock(), attachmentStore: store,
    scssCompiler: async () => { calls++; if (broken) throw failure; return ".recovery{color:red}"; },
    integrationHooks: [{ stage: "integrate", event: "observe_save", notable: () => true, fire: async () => { integrations++; } }],
  });
  const save = () => entry === "update" ? engine.updateCard({ cardId: ids.rule, content: "Recovery Skin" }) : engine.useAsCurrentSkin(ids.skin);
  const before = await snapshot();
  await expect(save()).rejects.toBe(failure);
  expect(await snapshot()).toEqual(before);
  expect(store.files.size).toBe(0);
  expect(integrations).toBe(0);
  const failedCalls = calls;
  broken = false;
  expect(await save()).not.toBeNull();
  expect(calls).toBeGreaterThan(failedCalls);
  expect(integrations).toBeGreaterThan(0);
  expect((await storage.selectOne<{ db_content: string }>("SELECT db_content FROM cards WHERE id=?", [ids.rule]))?.db_content).toBe("Recovery Skin");
  expect([...store.files.values()].map(bytes => new TextDecoder().decode(bytes))).toEqual([".recovery{color:red}"]);
});

it("rolls back virtual inputs and removes a partially stored new output before an exact retry", async () => {
  const store = new OutputStore();
  const failure = new Error("synthetic partial output store failure");
  store.failNextStore = failure;
  const engine = new CardActionEngine(storage.engine, { actor: JOE, now: fakeClock(), attachmentStore: store, scssCompiler: async () => ".recovery{color:red}" });
  const save = () => engine.updateCard({ cardId: ids.rule, content: "Recovery Skin" });
  const before = await snapshot();
  await expect(save()).rejects.toBe(failure);
  expect(await snapshot()).toEqual(before);
  expect(store.files.size).toBe(0);
  expect(await save()).not.toBeNull();
  expect(store.files.size).toBe(1);
});

