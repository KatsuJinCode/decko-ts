it("restores previous file bytes when a strict clock identifier is reused and its store fails part way", async () => {
  configureStrictParity({ ...strictParityFlags(), scriptBundleClockNames: true });
  const date = new Date("2026-10-29T12:00:00Z");
  const stamp = Math.floor(date.getTime() / 1000);
  const store = new OutputStore();
  const key = store.key(ids.output, stamp, ".css");
  const old = new TextEncoder().encode(".previous{color:blue}");
  store.files.set(key, old);
  await storage.driver.query("UPDATE cards SET db_content=? WHERE id=?", [`~${key}`, ids.output]);
  const failure = new Error("synthetic partial replacement failure");
  store.failNextStore = failure;
  const engine = new CardActionEngine(storage.engine, { actor: JOE, now: () => date, attachmentStore: store, scssCompiler: async () => ".recovery{color:red}" });
  const before = await snapshot();
  const save = () => engine.updateCard({ cardId: ids.rule, content: "Recovery Skin" });
  await expect(save()).rejects.toBe(failure);
  expect(await snapshot()).toEqual(before);
  expect([...store.files.entries()]).toEqual([[key, old]]);
  expect(await save()).not.toBeNull();
  expect(new TextDecoder().decode(store.files.get(key))).toBe(".recovery{color:red}");
});

it("compensates the first successful output when another output in the same act fails", async () => {
  await seedCard(storage, { id: 460, name: "Additional Set", typeId: SET_TYPE_ID });
  await seedCard(storage, { id: 461, name: "Additional Set+*style", leftId: 460, rightId: ids.style, typeId: ids.pointer, dbContent: "Other Skin" });
  await seedCard(storage, { id: 462, name: "Additional Set+*style+*asset output", leftId: 461, rightId: ids.assetOutput, typeId: ids.file, dbContent: "additional-previous.css" });
  const store = new OutputStore();
  const failure = new Error("synthetic second output failure");
  store.failStoreAt.set(2, failure);
  const engine = new CardActionEngine(storage.engine, { actor: JOE, now: fakeClock(), attachmentStore: store, scssCompiler: async () => ".recovery{color:red}" });
  const save = () => engine.updateCard({ cardId: ids.rule, content: "Recovery Skin", subcards: { "Additional Set+*style": { content: "Recovery Skin" } } });
  const before = await snapshot();
  await expect(save()).rejects.toBe(failure);
  expect(store.storeCalls).toBe(2);
  expect(await snapshot()).toEqual(before);
  expect(store.files.size).toBe(0);
  expect(await save()).not.toBeNull();
  expect(store.files.size).toBe(2);
});

it("exposes a file-restoration failure with the original save error while still rolling back database state", async () => {
  configureStrictParity({ ...strictParityFlags(), scriptBundleClockNames: true });
  const date = new Date("2026-10-29T12:00:00Z");
  const store = new OutputStore();
  const key = store.key(ids.output, Math.floor(date.getTime() / 1000), ".css");
  store.files.set(key, new TextEncoder().encode("previous"));
  const failure = new Error("synthetic failed store");
  const restoreFailure = new Error("synthetic failed restoration");
  store.failStoreAt.set(1, failure);
  store.failStoreAt.set(2, restoreFailure);
  const engine = new CardActionEngine(storage.engine, { actor: JOE, now: () => date, attachmentStore: store, scssCompiler: async () => ".recovery{color:red}" });
  const before = await snapshot();
  let observed: unknown;
  try { await engine.updateCard({ cardId: ids.rule, content: "Recovery Skin" }); } catch (error) { observed = error; }
  expect(observed).toBeInstanceOf(AggregateError);
  const errors = (observed as AggregateError).errors;
  expect(errors[0]).toBe(failure);
  expect(errors[1]).toBeInstanceOf(AggregateError);
  expect(errors[1].errors).toContain(restoreFailure);
  expect(await snapshot()).toEqual(before);
});

it("compiles inside the real transaction and runs integration only after that transaction returns", async () => {
  const transaction = storage.driver.transaction!.bind(storage.driver);
  let active = false;
  storage.driver.transaction = async <R>(work: () => Promise<R>): Promise<R> => {
    active = true;
    try { return await transaction(work); } finally { active = false; }
  };
  const compilerPhases: boolean[] = [], integrationPhases: boolean[] = [];
  const engine = new CardActionEngine(storage.engine, { actor: JOE, now: fakeClock(), attachmentStore: new OutputStore(),
    scssCompiler: async () => { compilerPhases.push(active); return ".recovery{color:red}"; },
    integrationHooks: [{ stage: "integrate", event: "observe_commit_phase", notable: () => true, fire: async () => { integrationPhases.push(active); } }],
  });
  await engine.updateCard({ cardId: ids.rule, content: "Recovery Skin" });
  expect(compilerPhases.length).toBeGreaterThan(0);
  expect(compilerPhases.every(value => value)).toBe(true);
  expect(integrationPhases.length).toBeGreaterThan(0);
  expect(integrationPhases.every(value => !value)).toBe(true);
});

it("reports a committed save if removing a recovery copy fails, without reverting its output", async () => {
  configureStrictParity({ ...strictParityFlags(), scriptBundleClockNames: true });
  const date = new Date("2026-10-29T12:00:00Z");
  const store = new OutputStore();
  const key = store.key(ids.output, Math.floor(date.getTime() / 1000), ".css");
  store.files.set(key, new TextEncoder().encode("previous"));
  store.discard = async () => { throw new Error("injected recovery cleanup failure"); };
  const engine = new CardActionEngine(storage.engine, { actor: JOE, now: () => date, attachmentStore: store,
    scssCompiler: async () => ".replacement{color:red}" });
  const failure = await engine.updateCard({ cardId: ids.rule, content: "Recovery Skin" })
    .then(() => undefined, (error: unknown) => error);
  expect(failure).toBeInstanceOf(CommittedSaveCleanupError);
  expect(failure).toMatchObject({ outcome: "committed", retrySafe: false });
  expect((failure as CommittedSaveCleanupError).reconciliation.recoveries).toHaveLength(1);
  expect(new TextDecoder().decode(store.files.get(key))).toBe(".replacement{color:red}");
  expect((await storage.selectOne<{ db_content: string }>("SELECT db_content FROM cards WHERE id=?", [ids.rule]))?.db_content).toBe("Recovery Skin");
  expect([...store.files.values()].some((bytes) => new TextDecoder().decode(bytes) === "previous")).toBe(true);
});

it("owns the action-engine rollback preimage when a custom store returns a reused Buffer", async () => {
  configureStrictParity({ ...strictParityFlags(), scriptBundleClockNames: true });
  const date = new Date("2026-10-29T12:00:00Z");
  const key = `${ids.output}/${Math.floor(date.getTime() / 1000)}.css`;
  const borrowed = Buffer.from(".old{}");
  const files = new Map<string, Uint8Array>([[key, borrowed]]);
  let failed = false;
  const failure = new Error("partial custom-store replacement");
  const store: AttachmentStore = {
    read: async (cardId, actionId, ext) => files.get(`${cardId}/${actionId}${ext}`),
    store: async (input) => {
      const name = `${input.cardId}/${input.actionId}${input.ext}`;
      if (name === key && !failed) {
        failed = true;
        // A valid store may reuse a buffer returned by a prior read.
        borrowed.set(input.bytes);
        throw failure;
      }
      files.set(name, new Uint8Array(input.bytes));
      return { identifier: `~${name}`, size: input.bytes.length };
    },
    discard: async (input) => { files.delete(`${input.cardId}/${input.actionId}${input.ext}`); },
    restoreIfUnchanged: async (input, expected) => {
      const name = `${input.cardId}/${input.actionId}${input.ext}`;
      const current = files.get(name);
      if (current === undefined || current.length !== expected.length || current.some((byte, i) => byte !== expected[i])) return false;
      files.set(name, new Uint8Array(input.bytes));
      return true;
    },
  };
  const engine = new CardActionEngine(storage.engine, { actor: JOE, now: () => date,
    attachmentStore: store, scssCompiler: async () => ".new{}" });
  const before = await snapshot();
  await expect(engine.updateCard({ cardId: ids.rule, content: "Recovery Skin" })).rejects.toBe(failure);
  expect(await snapshot()).toEqual(before);
  expect(files.get(key)).toEqual(new TextEncoder().encode(".old{}"));
  expect(files.size).toBe(1);
});
