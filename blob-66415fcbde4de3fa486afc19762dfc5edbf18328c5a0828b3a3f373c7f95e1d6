// Independent review of 8581752693bfaf511fe331eeaef99339dd56653b.
// Ruby signup.rb:12-14 checks an unnamed NEW default-accounted card.
import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
import { createActionsTestStorage, seedCard, seedReference, seedStandardDeck, type ActionsTestStorage } from "../card/actions/actions-test-storage.js";
import { CardActionEngine } from "../../src/card/actions/card-action-engine.js";
import { runAuthMigrations, SessionStore } from "../../src/card/auth/index.js";
import { handleWriteRequest } from "../../src/server/write-routes.js";
import { CaptureTransport } from "../../src/card/notify/transport.js";
import { RenderEngine } from "../../src/card/render.js";
import { generatedPassword } from "../../src/testing/generated-credentials.js";
import { signupApprovalAllowed, taskVerdictForCard, viewTaskPermissionStatements, viewTaskStateFromResults } from "../../src/card/permissions/view-task-rules.js";
import { readPermissionStatements, readPermissionStateFromViewerResults } from "../../src/card/permissions/read-rules.js";

type Policy = "anyone" | "member" | "administrator";
type Who = "guest" | "member" | "administrator";
let storage: ActionsTestStorage | undefined;
beforeEach(() => vi.stubGlobal("fetch", vi.fn(() => { throw new Error("Network forbidden in independent signup controls"); })));
afterEach(() => { storage?.close(); storage = undefined; vi.unstubAllGlobals(); });

async function fixture(policy: Policy, missingUser = false) {
  const s = storage = await createActionsTestStorage();
  await seedStandardDeck(s);
  for (const [id, name, codename, typeId] of [
    [400, "Role", "role", 3], [401, "Administrator", "administrator", 400],
    [404, "*members", "members", 2], [410, "*account", "account", 2],
    [411, "*status", "status", 2], [414, "*email", "email", 2],
    [415, "*password", "password", 2], [416, "*salt", "salt", 2],
    [412, "Person", missingUser ? "" : "user", 3], [413, "Sign up", "signup", 3],
    [420, "Candidate", "", 413], [430, "Member", "", 412],
    [431, "Owner", "", 412], [432, "Anonymous", "anonymous", 412],
    [440, "Anyone Signed In", "anyone_signed_in", 400],
    [450, "*type", "type", 2], [453, "*read", "read", 2],
    [455, "*self", "self", 2],
  ] as const) await seedCard(s, { id, name, codename: codename || undefined, typeId });
  await seedCard(s, { id: 403, leftId: 401, rightId: 404, dbContent: "[[Owner]]" });
  await seedReference(s, 403, 431, "owner");
  await seedCard(s, { id: 421, leftId: 420, rightId: 410 });
  await seedCard(s, { id: 422, leftId: 421, rightId: 411, dbContent: "unapproved" });
  await seedCard(s, { id: 423, leftId: 421, rightId: 414, dbContent: "synthetic@example.test" });
  await seedCard(s, { id: 433, leftId: 430, rightId: 410 });
  await seedCard(s, { id: 434, leftId: 433, rightId: 411, dbContent: "active" });
  const party = policy === "administrator" ? [401, "Administrator"] as const
    : policy === "member" ? [440, "Anyone Signed In"] as const : [304, "Anyone"] as const;
  await seedCard(s, { id: 451, leftId: 412, rightId: 450, typeId: 300 });
  await seedCard(s, { id: 452, leftId: 451, rightId: 301, dbContent: `[[${party[1]}]]` });
  await seedReference(s, 452, party[0], party[1].toLowerCase().replaceAll(" ", "_"));
  await seedCard(s, { id: 454, leftId: 7, rightId: 453, dbContent: "[[Anyone]]" });
  await seedReference(s, 454, 304, "anyone");
  s.engine.installNameEnvironment();
  await runAuthMigrations(s.driver);
  const sessions = new SessionStore({ driver: s.driver });
  const tokens = { member: (await sessions.createSession(430)).token, administrator: (await sessions.createSession(431)).token };
  const transport = new CaptureTransport("independent-signup");
  const actor = (who: Who) => who === "guest" ? null : { id: who === "member" ? 430 : 431, name: who === "member" ? "Member" : "Owner" };
  const viewer = (who: Who) => who === "guest" ? { signedIn: false } : { signedIn: true, actorId: actor(who)!.id };
  const state = async (who: Who) => {
    const v = viewer(who);
    const read = readPermissionStateFromViewerResults(await s.driver.batch(readPermissionStatements(v)), v);
    return viewTaskStateFromResults(await s.driver.batch(viewTaskPermissionStatements()), read);
  };
  const request = (trigger: string, who: Who) => handleWriteRequest(
    { driver: s.driver, fetcher: s.engine, accountMail: { transport, token: { secret: "synthetic-independent-signing-secret" }, origin: "http://deck.example", siteTitle: "Synthetic" } },
    { method: "PATCH", pathname: "/update/Candidate.json", host: "deck.example",
      headers: { "content-type": "application/json", ...(who === "guest" ? {} : { authorization: `Bearer ${tokens[who]}` }) }, body: JSON.stringify({ card: { trigger } }) },
  );
  const snapshot = async () => {
    const tables = ["cards", "card_references", "card_acts", "card_actions", "card_changes"];
    return Object.fromEntries(await Promise.all(tables.map(async table => [table, await s.selectAll(`SELECT * FROM ${table} ORDER BY rowid`)])));
  };
  return { s, actor, viewer, state, request, snapshot, transport };
}

function permitted(policy: Policy, who: Who) {
  return who === "administrator" || policy === "anyone" || (policy === "member" && who === "member");
}

describe("independent signup approval role matrix", () => {
  for (const policy of ["anyone", "member", "administrator"] as const) {
    for (const who of ["guest", "member", "administrator"] as const) {
      for (const trigger of ["approve_with_verification", "approve_without_verification"]) {
        it(`${policy} / ${who} / ${trigger}: shared verdict, links, mutation and mail`, async () => {
          const f = await fixture(policy);
          const allowed = permitted(policy, who);
          const engine = new CardActionEngine(f.s.engine, { actor: f.actor(who) });
          expect(await engine.canApproveSignups()).toBe(allowed);
          expect(await signupApprovalAllowed(f.s.engine, await f.state(who))).toBe(allowed);
          const render = new RenderEngine(f.s.engine);
          render.viewer = f.viewer(who);
          const html = await render.render("Candidate", "core");
          expect(html.includes("approve_with_verification")).toBe(allowed);
          expect(html.includes("approve_without_verification")).toBe(allowed);
          const before = await f.snapshot();
          const response = await f.request(trigger, who);
          expect(response?.status).toBe(allowed ? 200 : 422);
          if (!allowed) {
            expect(response?.body).toContain("illegal approval");
            expect(await f.snapshot()).toEqual(before);
            expect(f.transport.captured()).toHaveLength(0);
          } else {
            expect(await f.s.selectOne("SELECT db_content FROM cards WHERE id = 422")).toEqual({ db_content: trigger === "approve_with_verification" ? "unverified" : "active" });
            expect(f.transport.captured()).toHaveLength(1);
          }
          expect(fetch).not.toHaveBeenCalled();
        });
      }
      it(`${policy} / ${who}: actual signup creation uses the same decision`, async () => {
        const f = await fixture(policy);
        const engine = new CardActionEngine(f.s.engine, { actor: f.actor(who) });
        await engine.createCard({ name: "Independent Applicant", typeCode: "signup", subcards: {
          "+*account": { subcards: { "+*email": { content: "independent@example.test" }, "+*password": { content: generatedPassword("independent-signup") } } },
        } });
        expect((await f.s.engine.fetchByName("Independent Applicant+*account+*status"))?.dbContent).toBe(permitted(policy, who) ? "unverified" : "unapproved");
        expect(fetch).not.toHaveBeenCalled();
      });
    }
  }
  for (const who of ["guest", "member", "administrator"] as const) {
    for (const trigger of ["approve_with_verification", "approve_without_verification"]) {
    it(`missing user codename refuses ${who} / ${trigger}, leaves records and mail untouched`, async () => {
      const f = await fixture("anyone", true);
      expect(await new CardActionEngine(f.s.engine, { actor: f.actor(who) }).canApproveSignups()).toBe(false);
      const render = new RenderEngine(f.s.engine); render.viewer = f.viewer(who);
      const html = await render.render("Candidate", "core");
      expect.soft(html).not.toContain("approve_with_verification");
      expect.soft(html).not.toContain("approve_without_verification");
      const before = await f.snapshot();
      expect((await f.request(trigger, who))?.status).toBe(422);
      expect(await f.snapshot()).toEqual(before);
      expect(f.transport.captured()).toHaveLength(0);
      expect(fetch).not.toHaveBeenCalled();
    });
    }
  }
  it("missing permission state denies even with an Administrator in the deck", async () => {
    const f = await fixture("anyone");
    expect(await signupApprovalAllowed(f.s.engine, undefined)).toBe(false);
  });
  it("a named existing card's self grant cannot authorize the nameless new accounted card", async () => {
    const f = await fixture("administrator");
    await seedCard(f.s, { id: 460, name: "Special Person", typeId: 412 });
    await seedCard(f.s, { id: 461, leftId: 460, rightId: 455, typeId: 300 });
    await seedCard(f.s, { id: 462, leftId: 461, rightId: 301, dbContent: "[[Anyone]]" });
    await seedReference(f.s, 462, 304, "anyone");
    const state = await f.state("guest");
    expect(await taskVerdictForCard(f.s.engine, { name: "Special Person", id: 460, typeId: 412, typeName: "Person" }, "create", state)).toBe(true);
    expect(await taskVerdictForCard(f.s.engine, { name: "", isNew: true, typeId: 412, typeName: "Person" }, "create", state)).toBe(false);
    expect(await signupApprovalAllowed(f.s.engine, state)).toBe(false);
  });
});
