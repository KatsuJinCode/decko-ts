  "sources": {
    "route": [
      {
        "line": 45,
        "text": "  # for super-explicit over-achievers"
      },
      {
        "line": 46,
        "text": "  match \"(card)/create(/:mark(.:format))\" => \"card#create\", via: %i[post patch]"
      },
      {
        "line": 47,
        "text": "  match \"(card)/update(/:mark(.:format))\" => \"card#update\", via: %i[post put patch]"
      },
      {
        "line": 48,
        "text": "  match \"(card)/delete(/:mark(.:format))\" => \"card#delete\", via: :delete"
      }
    ],
    "create": [
      {
        "line": 6,
        "text": "    def create"
      },
      {
        "line": 7,
        "text": "      handle { card.save! }"
      },
      {
        "line": 8,
        "text": "    end"
      }
    ],
    "handle": [
      {
        "line": 74,
        "text": "    def handle"
      },
      {
        "line": 75,
        "text": "      Card::Env.success card.name"
      },
      {
        "line": 76,
        "text": "      yield ? cud_success : raise(Card::Error::UserError)"
      },
      {
        "line": 77,
        "text": "    end"
      }
    ],
    "uriFetch": [
      {
        "line": 104,
        "text": "      def uri_fetch params"
      },
      {
        "line": 105,
        "text": "        card_opts = uri_fetch_opts params"
      },
      {
        "line": 106,
        "text": "        if params[:action] == \"create\""
      },
      {
        "line": 107,
        "text": "          # FIXME: we currently need a \"new\" card to catch duplicates"
      },
      {
        "line": 108,
        "text": "          # (otherwise save will just act like a normal update)"
      },
      {
        "line": 109,
        "text": "          # We may need a \"#create\" instance method to handle this checking?"
      },
      {
        "line": 110,
        "text": "          Card.new card_opts"
      },
      {
        "line": 111,
        "text": "        else"
      },
      {
        "line": 112,
        "text": "          standard_uri_fetch params, card_opts"
      },
      {
        "line": 113,
        "text": "        end"
      },
      {
        "line": 114,
        "text": "      end"
      },
      {
        "line": 115,
        "text": ""
      }
    ],
    "uriFetchOpts": [
      {
        "line": 128,
        "text": "      def uri_fetch_opts params"
      },
      {
        "line": 129,
        "text": "        Env.hash(params[:card]).tap do |opts|"
      },
      {
        "line": 130,
        "text": "          opts[:type] ||= params[:type] if params[:type] # for /new/:type shortcut."
      },
      {
        "line": 131,
        "text": "          opts[:name] ||= Name[params[:mark]]&.tr \"_\", \" \""
      },
      {
        "line": 132,
        "text": "        end"
      },
      {
        "line": 133,
        "text": "      end"
      }
    ],
    "beforeActions": [
      {
        "line": 20,
        "text": "  before_action :setup, except: [:asset]"
      },
      {
        "line": 21,
        "text": "  before_action :authenticate, except: [:asset]"
      },
      {
        "line": 22,
        "text": "  before_action :load_mark, only: [:read]"
      },
      {
        "line": 23,
        "text": "  before_action :load_card, except: [:asset]"
      },
      {
        "line": 24,
        "text": "  before_action :load_action, only: [:read]"
      },
      {
        "line": 25,
        "text": "  before_action :refresh_card, only: %i[create update delete]"
      }
    ],
    "pinnedVerbMatcher": [
      {
        "line": 14,
        "text": "      module VerbMatchers"
      },
      {
        "line": 15,
        "text": "        VERBS = %w{ DELETE GET HEAD OPTIONS LINK PATCH POST PUT TRACE UNLINK }"
      },
      {
        "line": 16,
        "text": "        VERBS.each do |v|"
      },
      {
        "line": 17,
        "text": "          class_eval <<-eoc, __FILE__, __LINE__ + 1"
      },
      {
        "line": 18,
        "text": "            # frozen_string_literal: true"
      },
      {
        "line": 19,
        "text": "            class #{v}"
      },
      {
        "line": 20,
        "text": "              def self.verb; name.split(\"::\").last; end"
      },
      {
        "line": 21,
        "text": "              def self.call(req); req.#{v.downcase}?; end"
      },
      {
        "line": 22,
        "text": "            end"
      },
      {
        "line": 23,
        "text": "          eoc"
      },
      {
        "line": 24,
        "text": "        end"
      },
      {
        "line": 170,
        "text": "      def requires_matching_verb?"
      },
      {
        "line": 171,
        "text": "        !@request_method_match.all? { |x| x == VerbMatchers::All }"
      },
      {
        "line": 172,
        "text": "      end"
      },
      {
        "line": 183,
        "text": "        def match_verb(request)"
      },
      {
        "line": 184,
        "text": "          @request_method_match.any? { |m| m.call request }"
      },
      {
        "line": 185,
        "text": "        end"
      }
    ],
