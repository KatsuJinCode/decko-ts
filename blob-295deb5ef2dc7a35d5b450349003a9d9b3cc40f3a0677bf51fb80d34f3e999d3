import test from 'node:test';
import assert from 'node:assert/strict';
import {copyFileSync,existsSync,mkdirSync,readFileSync,writeFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {dirname,join} from 'node:path';
import {fileURLToPath} from 'node:url';
import {scratchDir,removeScratchDir} from '../support/scratch-dir.mjs';
import {isTestFile} from '../../tools/test-file-inventory.mjs';
import {classify,listTestFiles,testInventoryProblems} from '../../tools/test-gates.mjs';
import {nodeTestFiles,testRunner} from '../../tools/node-test-runners.mjs';
