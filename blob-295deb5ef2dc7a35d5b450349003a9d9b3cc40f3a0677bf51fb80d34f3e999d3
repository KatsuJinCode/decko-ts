  mkdirSync(join(dir,'tests','card'),{recursive:true});
  writeFileSync(join(dir,'tests','card','owned.test.mjs'),'import test from "node:test";');
  assert.deepEqual(listTestFiles(dir),['tests/card/owned.test.mjs']);
}));

test('real Git ignores generated gate configs without hiding ordinary source files',async()=>{
  const generated='vitest.gate.123.00000000-0000-4000-8000-000000000000.generated.ts';
  const ignored=await runCommand('git',['check-ignore','--no-index','--',generated],{cwd:root});
  assert.equal(ignored.code,0,ignored.stderr.toString());assert.equal(ignored.stdout.toString().trim(),generated);
  for(const file of ['vitest.gate.feature.ts','tests/card/ordinary.test.ts']) {
    const visible=await runCommand('git',['check-ignore','--no-index','--',file],{cwd:root});
    assert.equal(visible.code,1,visible.stderr.toString());
  }
});
