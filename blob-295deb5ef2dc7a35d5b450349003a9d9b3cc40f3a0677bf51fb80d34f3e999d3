test('release admission records the actual private routing manifest bytes',()=>fixture(async dir=>{
  const file='tools/test-gate-routing/private-inputs.json';
  const {report}=await runReleaseCheck({'--admission-only':true,'--out':join(dir,'admission')},{root});
  const expected=createHash('sha256').update(readFileSync(join(root,file))).digest('hex');
  assert.equal(report.checkerSources[file],expected);
}));

test('archived native PostgreSQL source remains byte-bound evidence rather than an executable test',()=>{
  const folder='docs/runs/engine-checks-decko256-2026-11-02';
  const name='decko256-native-postgres.fixture';
  assert.equal(isTestFile(folder+'/'+name),false);
  const manifest=JSON.parse(readFileSync(join(root,folder,'manifest.json'),'utf8'));
  const entry=manifest.files.find(file=>file.path===name);
  assert.ok(entry,'the renamed source remains in its evidence manifest');
  const bytes=readFileSync(join(root,folder,name));
  assert.equal(bytes.length,entry.bytes);
  assert.equal(createHash('sha256').update(bytes).digest('hex'),entry.sha256);
});

