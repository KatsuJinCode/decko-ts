import { afterEach, describe, expect, it } from "vitest";
import { parseDocument } from "htmlparser2";
import { getElementById, textContent } from "domutils";
import { defaultDeckLoader } from "../../../src/card/mod-loader/default-mod-deck.js";
import { modEngineHost } from "../../../src/card/mod-loader/mod-engine-host.js";
import { getDefaultModLoader, setDefaultModLoader } from "../../../src/card/mod-loader.js";
import { bindModLoaderToEngine, createRenderTestStorage, seedCard, seedReference } from "./render-test-storage.js";
import { bootEdgeServingEngines } from "../../../deploy/bunny-worker-src/bunny-edge-deck-boot.js";
import { handleEngineRequest } from "../../../deploy/bunny-worker-src/bunny-edge-engine-request.js";

const originalLoader = getDefaultModLoader();
afterEach(() => setDefaultModLoader(originalLoader));

async function signupDeck(traits: { account?: string; email?: string; password?: string } = {}) {
  const storage = await createRenderTestStorage();
  for (const card of [
    { id: 2, name: "RichText", codename: "basic", typeId: 5 },
    { id: 5, name: "Cardtype", codename: "cardtype", typeId: 5 },
    { id: 10, name: "*all", codename: "all", typeId: 13 },
    { id: 12, name: "Sign up", codename: "signup", typeId: 5 },
    { id: 13, name: "Set", codename: "set", typeId: 5 },
    { id: 14, name: "Setting", codename: "setting", typeId: 5 },
    { id: 15, name: "*type", codename: "type", typeId: 14 },
    { id: 16, name: "*read", codename: "read", typeId: 14 },
    { id: 17, name: "*create", codename: "create", typeId: 14 },
    { id: 18, name: "Anyone", codename: "anyone", typeId: 5 },
    { id: 19, name: "Anyone Signed In", codename: "anyone_signed_in", typeId: 5 },
    { id: 20, name: "Anonymous", codename: "anonymous", typeId: 5 },
    { id: 52, name: "Phrase", codename: "phrase", typeId: 5 },
    { id: 60, name: traits.account ?? "*account", codename: "account", typeId: 2 },
    { id: 61, name: traits.email ?? "*email", codename: "email", typeId: 52 },
    { id: 62, name: traits.password ?? "*password", codename: "password", typeId: 52 },
    { id: 70, name: "Sign up+*type", leftId: 12, rightId: 15, typeId: 13 },
    { id: 71, name: "Sign up+*type+*create", leftId: 70, rightId: 17, typeId: 14, dbContent: "[[Anyone]]" },
    { id: 72, name: "Sign up+*type+*read", leftId: 70, rightId: 16, typeId: 14, dbContent: "[[Anyone Signed In]]" },
    { id: 73, name: "*thanks", codename: "thanks", typeId: 14 },
    { id: 74, name: "Sign up+*type+*thanks", leftId: 70, rightId: 73, typeId: 14, dbContent: "signup_destination" },
    { id: 200, name: "Html", codename: "html", typeId: 5 },
    { id: 201, name: "*title", codename: "title", typeId: 52, dbContent: "Acceptance Site" },
    { id: 202, name: "*layout", codename: "layout", typeId: 14 },
    { id: 203, name: "Default Layout", typeId: 200, dbContent: '<body><header>deck-header-fixture</header><article>{{_main|titled}}</article><footer>deck-footer-fixture</footer></body>' },
    { id: 204, name: "*all+*layout", leftId: 10, rightId: 202, typeId: 14, dbContent: "Default Layout" },
    { id: 205, name: "*header", codename: "header", typeId: 200 },
    { id: 206, name: "*footer", codename: "footer", typeId: 200 },
  ]) await seedCard(storage, card);
  await seedReference(storage, 71, 18, "anyone");
  await seedReference(storage, 72, 19, "anyone_signed_in");
  const loader = defaultDeckLoader();
  bindModLoaderToEngine(storage, loader);
  await loader.installInto(modEngineHost(storage.engine, storage.fetcher));
  return storage;
}

describe("unnamed signup form with create permission and restricted read", () => {
  for (const traits of [
    { account: "*credentials", email: "*email", password: "*password" },
    { account: "*credentials", email: "*inbox", password: "*passphrase" },
  ]) {
    it(`uses the codenamed ${traits.account}/${traits.email}/${traits.password} namespace`, async () => {
      const storage = await signupDeck(traits);
      try {
        const html = await storage.engine.render("", "new", {
          absentCard: true, focalRoot: true, newCard: { typeId: 12, typePreset: true },
        });
        expect(html).toContain(`name="card[subcards][+${traits.account}][subcards][+${traits.email}][content]"`);
        expect(html).toContain(`name="card[subcards][+${traits.account}][subcards][+${traits.password}][content]"`);
        expect(html).not.toContain('name="card[subcards][+*account]');
      } finally {
        storage.close();
      }
    });
  }

  it("renders the account editors through the composed new view", async () => {
    const storage = await signupDeck();
    try {
      const html = await storage.engine.render("", "new", {
        absentCard: true, focalRoot: true, newCard: { typeId: 12, typePreset: true },
      });
      expect(html).toContain('name="card[subcards][+*account][subcards][+*email][content]"');
      expect(html).toContain('name="card[subcards][+*account][subcards][+*password][content]"');
      expect(html).toContain('name="success[mark]" id="success_mark" value="signup_destination"');
      const form = getElementById("new_card", parseDocument(html).children);
      expect(form).not.toBeNull();
      expect(textContent(form!)).not.toContain("to read this");
      expect(html).toContain('title="Sign up"');
      expect(html).not.toContain('title="New\nSign up"');
    } finally {
      storage.close();
    }
  });

  it("still refuses the outer new view when create permission is absent", async () => {
    const storage = await signupDeck();
    try {
      await storage.counting.query("UPDATE cards SET db_content = ? WHERE id = ?", ["[[Anyone Signed In]]", 71]);
      await storage.counting.query("DELETE FROM card_references WHERE referer_id = ?", [71]);
      await seedReference(storage, 71, 19, "anyone_signed_in");
      const html = await storage.engine.render("", "new", {
        absentCard: true, focalRoot: true, newCard: { typeId: 12, typePreset: true },
      });
      expect(html).not.toContain('name="card[subcards][+*account][subcards][+*email][content]"');
      expect(html).not.toContain('name="card[subcards][+*account][subcards][+*password][content]"');
      expect(html).toContain("to create this");
    } finally {
      storage.close();
    }
  });

  it("keeps a named new holder's account subform relative to that holder", async () => {
    const storage = await signupDeck();
    try {
      const html = await storage.engine.render("Future Member", "new", {
        absentCard: true, focalRoot: true, newCard: { typeId: 12, typePreset: true },
      });
      expect(html).toContain('name="card[name]"');
      expect(html).toContain('value="Future Member"');
      expect(html).toContain('name="card[subcards][+*account][subcards][+*email][content]"');
      expect(html).toContain('name="card[subcards][+*account][subcards][+*password][content]"');
      const form = getElementById("new_card", parseDocument(html).children);
      expect(form).not.toBeNull();
      expect(textContent(form!)).not.toContain("to read this");
    } finally {
      storage.close();
    }
  });

  it("serves the unnamed signup through the native page head and layout", async () => {
    const storage = await signupDeck();
    try {
      const deck = await bootEdgeServingEngines(storage.counting);
      const response = await handleEngineRequest(new Request("https://copy.invalid/new/Sign_up"), deck, { anonymous: true });
      const html = await response.text();
      expect(response.status).toBe(200);
      expect(html).toContain("<title>Acceptance Site</title>");
      expect(html).toContain("<meta content='noindex' name='robots'>");
      expect(html).toContain("deck-header-fixture");
      expect(html).toContain("deck-footer-fixture");
      expect(html).toContain('name="card[subcards][+*account][subcards][+*email][content]"');
      expect(html).toContain('name="card[subcards][+*account][subcards][+*password][content]"');
      expect(html).not.toContain('title="New\nSign up"');
    } finally {
      storage.close();
    }
  });

  it("does not expose a private existing applicant's email through a named create route", async () => {
    const storage = await signupDeck();
    try {
      await seedCard(storage, { id: 400, name: "Existing Applicant", typeId: 12, dbContent: "private-holder-sentinel" });
      await seedCard(storage, { id: 401, name: "Existing Applicant+*account", leftId: 400, rightId: 60, typeId: 2, dbContent: "private-account-sentinel" });
      await seedCard(storage, { id: 402, name: "Existing Applicant+*account+*email", leftId: 401, rightId: 61, typeId: 52, dbContent: "private-email@fixture.invalid" });
      await seedCard(storage, { id: 403, name: "Existing Applicant+*account+*password", leftId: 401, rightId: 62, typeId: 52, dbContent: "private-password-sentinel" });
      const deck = await bootEdgeServingEngines(storage.counting);
      const email = await deck.fetcher.fetchByName("Existing Applicant+*account+*email");
      expect(email).toBeDefined();
      expect(await deck.render.canReadCard(email!)).toBe(false);
      const before = (await storage.counting.query("SELECT id, db_content FROM cards ORDER BY id", [])).rows;
      const response = await handleEngineRequest(new Request("https://copy.invalid/new/Sign_up?card%5Bname%5D=Existing%20Applicant"), deck, { anonymous: true });
      const html = await response.text();
      expect(response.status).toBe(403);
      expect(html).not.toContain("private-email@fixture.invalid");
      expect(html).not.toContain("private-password-sentinel");
      expect(html).not.toContain("private-account-sentinel");
      expect(html).not.toContain("private-holder-sentinel");
      expect(await deck.render.canReadCard(email!)).toBe(false);
      expect((await storage.counting.query("SELECT id, db_content FROM cards ORDER BY id", [])).rows).toEqual(before);
    } finally {
      storage.close();
    }
  });
});
