test('revision observation retains the actual current Git identity and working state',()=>{
  const value=observeRevision(root);
  assert.match(value.commit,/^[a-f0-9]{40}$/);assert.equal(typeof value.status,'string');
});

test('a new undeclared test surface is refused before selecting its runner',()=>{
  assert.throws(()=>testPlan(root,['tests/undeclared/new.test.cts']),/No declared test gate/);
});
test('unknown, repeated or conflicting CLI scopes refuse admission',()=>{
  for(const args of [['--unknown'],['--out'],['--out','a','--out','b'],['--markers-only','--admission-only']])assert.throws(()=>parseOptions(args));
});
test('invalid provided capture keeps exact input identities and cannot pass',()=>fixture(async dir=>{
  const capture=join(dir,'capture.json'),expected=join(dir,'expected.json');
  writeFileSync(capture,'null');writeFileSync(expected,'{}');
  const row=captureAdmission({'--api-key-capture':capture,'--api-key-expected':expected});
  assert.equal(row.result,'INCOMPLETE');assert.equal(row.inputs.length,2);
  assert.equal(row.inputs[0].bytes,4);assert.match(row.inputs[0].sha256,/^[a-f0-9]{64}$/);
}));
test('default battery refuses missing capture evidence before starting test stages',()=>fixture(async dir=>{
  let launches=0;
  const {report,exitCode}=await runReleaseCheck({'--out':join(dir,'admission')},{root,execute:async()=>{launches++;throw Error('A test stage must not start');}});
  assert.equal(exitCode,3);assert.equal(report.mode,'battery');assert.equal(report.batteryPassed,false);assert.equal(launches,0);
  assert.equal(report.rows.find(row=>row.stage==='api-key-capture').result,'INCOMPLETE');
  assert.deepEqual(report.notRun,['source-inventory','test-inventory','framework-execution']);
  assert.equal(report.inventory,undefined,'missing evidence must refuse before parsing every test');
  assert.deepEqual(report.sourceQualification.problems,['Battery did not run because admission was incomplete']);
}));

test('a preflight with refused source still records its lack of qualification',()=>fixture(async dir=>{
  const {report}=await runReleaseCheck({'--out':join(dir,'preflight'),'--markers-only':true},{root:dir});
  assert.equal(report.batteryPassed,false);assert.equal(report.sourceQualified,false);
  assert.match(report.sourceQualification.problems.join('; '),/Preflight only/);
}));

test('one source observation retains both byte identities and actual conflict markers',()=>fixture(async dir=>{
  writeFileSync(join(dir,'source.mjs'),'<<<<<<< branch\nconst value=1;\n=======\n>>>>>>> other\n');
  const result=inspectSource(dir,['source.mjs'],{scanMarkers:true});
  assert.deepEqual(result.markers,['source.mjs:1','source.mjs:3','source.mjs:4']);
  assert.equal(result.manifest.length,1);assert.match(result.manifest[0].sha256,/^[a-f0-9]{64}$/);
}));
