  {
    "label": "permission rule resolver",
    "sql": "WITH RECURSIVE\nanc(id) AS (\n  SELECT r.left_id FROM cards r\n    JOIN cards st ON st.id = r.right_id\n    WHERE +r.trash = 0 AND st.\"key\" IN (?, ?, ?, ?)\n      AND r.left_id IS NOT NULL\n  UNION\n  SELECT j.left_id FROM anc a\n    JOIN cards j ON j.id = a.id\n    WHERE j.left_id IS NOT NULL\n),\ntc(id) AS MATERIALIZED (\n  SELECT c.id FROM cards c\n    WHERE substr(c.\"key\", -1) IN ('d', 'D', 'e', 'E')\n      AND (c.\"key\" LIKE '%+*read' OR c.\"key\" LIKE '*read'\n        OR c.\"key\" LIKE '%+*create' OR c.\"key\" LIKE '*create'\n        OR c.\"key\" LIKE '%+*update' OR c.\"key\" LIKE '*update'\n        OR c.\"key\" LIKE '%+*delete' OR c.\"key\" LIKE '*delete')\n),\ntl(parent, child) AS MATERIALIZED (\n  SELECT j.id, j.left_id FROM tc CROSS JOIN cards j ON j.right_id = tc.id\n    WHERE j.left_id IS NOT NULL\n),\nd(id) AS (\n  SELECT child FROM tl\n  UNION\n  SELECT c.left_id FROM d CROSS JOIN cards c ON c.id = d.id WHERE c.left_id IS NOT NULL\n  UNION\n  SELECT c.right_id FROM d CROSS JOIN cards c ON c.id = d.id WHERE c.right_id IS NOT NULL\n),\ndl(parent, child) AS MATERIALIZED (\n  SELECT c.id, c.left_id FROM d CROSS JOIN cards c ON c.id = d.id WHERE c.left_id IS NOT NULL\n),\ndr(parent, child) AS MATERIALIZED (\n  SELECT c.id, c.right_id FROM d CROSS JOIN cards c ON c.id = d.id WHERE c.right_id IS NOT NULL\n),\nresolved(id, ckey) AS (\n  SELECT c.id, c.\"key\" FROM anc CROSS JOIN cards c ON c.id = anc.id\n    WHERE c.\"key\" IS NOT NULL AND +c.trash = 0\n  UNION\n  SELECT c.id, c.\"key\" FROM tc CROSS JOIN cards c ON c.id = tc.id\n    WHERE c.\"key\" IS NOT NULL AND +c.trash = 0\n      AND (c.\"key\" LIKE '%+*read' OR c.\"key\" LIKE '%+*create' OR c.\"key\" LIKE '%+*update' OR c.\"key\" LIKE '%+*delete')\n  UNION\n  SELECT j.id, l.ckey || '+' || r.\"key\" FROM resolved l\n    JOIN dl ON dl.child = l.id\n    JOIN cards j ON j.id = dl.parent AND +j.trash = 0\n    JOIN cards r ON r.id = j.right_id AND r.\"key\" IS NOT NULL\n  UNION\n  SELECT j.id, l.ckey || '+' || r.\"key\" FROM resolved l\n    JOIN tl ON tl.child = l.id\n    JOIN cards j ON j.id = tl.parent AND +j.trash = 0\n    JOIN cards r ON r.id = j.right_id AND r.\"key\" IS NOT NULL\n  UNION\n  SELECT j.id, l.\"key\" || '+' || r.ckey FROM resolved r\n    JOIN dr ON dr.child = r.id\n    JOIN cards j ON j.id = dr.parent AND +j.trash = 0\n    JOIN cards l ON l.id = j.left_id AND l.\"key\" IS NOT NULL\n  UNION\n  SELECT j.id, l.\"key\" || '+' || r.ckey FROM resolved r\n    JOIN cards j ON j.right_id = r.id AND +j.trash = 0\n    JOIN cards l ON l.id = j.left_id AND l.\"key\" IS NOT NULL\n    WHERE ('+' || r.ckey) LIKE '%+*read' OR ('+' || r.ckey) LIKE '%+*create' OR ('+' || r.ckey) LIKE '%+*update' OR ('+' || r.ckey) LIKE '%+*delete'\n)\nSELECT rs.ckey, rs.id FROM resolved rs\nWHERE rs.ckey LIKE '%+*read' OR rs.ckey LIKE '%+*create' OR rs.ckey LIKE '%+*update' OR rs.ckey LIKE '%+*delete'",
    "args": [
