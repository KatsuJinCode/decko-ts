// Launches a hidden (headless) Chromium-family browser with a throwaway
// profile, through playwright-core, using a browser already installed on the
// machine. Nothing is downloaded.
//
//   HARNESS_PLAYWRIGHT_CORE  directory of an installed playwright-core package
//                            (default: resolve "playwright-core" from here)
//   HARNESS_CHROME           browser executable (default: the first installed
//                            Chrome, Edge or Chromium found in the usual places)

import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { createRequire } from "node:module";
import { pathToFileURL } from "node:url";

export async function loadPlaywright() {
  const dir = process.env.HARNESS_PLAYWRIGHT_CORE;
  if (dir) {
    const entry = path.join(dir, "index.mjs");
    return import(pathToFileURL(fs.existsSync(entry) ? entry : path.join(dir, "index.js")).href);
  }
  try {
    return await import("playwright-core");
  } catch {
    const require = createRequire(import.meta.url);
    return require("playwright-core");
  }
}

const LOCAL_HOSTS = new Set(["127.0.0.1", "localhost", "[::1]"]);
const STOCK_LAYOUT_CDNS = new Set([
  "code.jquery.com",
  "cdnjs.cloudflare.com",
  "fonts.googleapis.com",
  "fonts.gstatic.com",
  "kit.fontawesome.com",
  "ka-f.fontawesome.com",
]);

// The library's own video pull zone (the recordings the class pages embed).
// The class-pages-final lane's visitor check proves the published class
// pages' embedded Bunny stream PLAYS signed out; the stream serves only
// family referrers (the pull zone answers 403 to a referrerless client,
// probed 2026-10-26), so this host can serve nothing to a page that does
// not already carry it. The exact hostname, not the zone.
// demos.culturesmith.help rides beside it for the same reason: the visitor
// check loads the PUBLISHED page itself, and the demos zone is the family's
// own static host (the same law the local host already rides).
// culturesmith-demos.b-cdn.net is the pull zone's own routing name; since the
// hub-session-gate lane (2026-10-26) answers the public demos host's HTML
// with the family sign-in redirect, the visitor check reads the published
// bytes from this origin host (the library-finish lane's public pass).
// library.culturesmith.help rides for the same family reason: the gated
// journey signs in once at the library's one sign-in page, whose form posts
// to the library's own /api/auth/signin (the library-finish lane's gate
// journey).
const CLASS_STREAM_HOSTS = new Set(["vz-177c889c-f94.b-cdn.net", "demos.culturesmith.help", "culturesmith-demos.b-cdn.net", "library.culturesmith.help"]);

// Google's documented reCAPTCHA script/frame/connect paths. Keep every
// unrelated Google path blocked, and retain the explicit offline policy.
export function allowedBrowserRequest(url, offline = false) {
  if (LOCAL_HOSTS.has(url.hostname)) return true;
  if (CLASS_STREAM_HOSTS.has(url.hostname)) return true;
  if (offline) return false;
  if (STOCK_LAYOUT_CDNS.has(url.hostname)) return true;
  return url.protocol === "https:" &&
    ["www.google.com", "www.gstatic.com", "recaptcha.google.com"].includes(url.hostname) &&
    url.pathname.startsWith("/recaptcha/");
}

const CANDIDATES = [
  "C:/Program Files/Google/Chrome/Application/chrome.exe",
  "C:/Program Files (x86)/Google/Chrome/Application/chrome.exe",
  "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe",
  "C:/Program Files/Microsoft/Edge/Application/msedge.exe",
  "/usr/bin/google-chrome",
  "/usr/bin/google-chrome-stable",
  "/usr/bin/chromium",
  "/usr/bin/chromium-browser",
  "/usr/bin/microsoft-edge",
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
];

export function findBrowser() {
  if (process.env.HARNESS_CHROME) return process.env.HARNESS_CHROME;
  const found = CANDIDATES.find((p) => fs.existsSync(p));
  if (!found) {
    throw new Error("no installed Chrome, Edge or Chromium found; set HARNESS_CHROME to a browser executable");
  }
  return found;
}

const PROFILE_PREFIX = "decko-browser-profile-";
const OWNER_FILE = ".decko-owner.json";

function processAlive(pid) {
  try { process.kill(pid, 0); return true; } catch (err) {
    if (err.code === "EPERM") return true;
    if (err.code === "ESRCH") return false;
    throw err;
  }
}

// A dead recorded owner does not make another run's browser ours. Diagnose
// retained profiles without enumerating or stopping processes or deleting data.
// Only the context returned by this run's launch is closed by this run.
export function findOrphanedBrowserProfiles({ tmp = os.tmpdir() } = {}) {
  let names;
  try { names = fs.readdirSync(tmp).filter((n) => n.startsWith(PROFILE_PREFIX)); } catch (error) {
    if (error.code === "ENOENT") return [];
    throw error;
  }
  return names.map((n) => path.join(tmp, n)).filter((profile) => {
    try {
      const { pid } = JSON.parse(fs.readFileSync(path.join(profile, OWNER_FILE), "utf8"));
      return Number.isInteger(pid) && pid > 0 && !processAlive(pid);
    } catch {
      return false; // unknown ownership is retained as well
    }
  });
}

// Returns { context, close }. The profile directory is created empty and
// removed on close, whatever happened in between.
export async function launchBrowser({ viewport = { width: 1280, height: 900 } } = {}) {
  const { chromium } = await loadPlaywright();
  const retained = findOrphanedBrowserProfiles();
  if (retained.length) process.stderr.write(`[browser] Prior-run profiles retained; current run has no process ownership: ${retained.join(", ")}\n`);
  const profile = fs.mkdtempSync(path.join(os.tmpdir(), PROFILE_PREFIX));
  fs.writeFileSync(path.join(profile, OWNER_FILE), JSON.stringify({ pid: process.pid }));
  let context;
  try {
    context = await chromium.launchPersistentContext(profile, {
      headless: true,
      executablePath: findBrowser(),
      viewport,
      acceptDownloads: false,
      args: ["--no-first-run", "--no-default-browser-check", "--disable-extensions", "--mute-audio"],
    });
  } catch (err) {
    fs.rmSync(profile, { recursive: true, force: true });
    throw err;
  }
  // Requests leave the machine only for the public script and font CDNs a
  // stock Decko layout itself links (jQuery, jquery-ujs, ace, select2, icon
  // fonts); without them Decko's editors and forms do not run, on any engine.
  // Every other outside host is refused in the browser. HARNESS_OFFLINE=1
  // refuses the CDNs too.
  const offline = process.env.HARNESS_OFFLINE === "1";
  await context.route(
    (url) =>
      /^(https?|wss?):$/.test(url.protocol) &&
      !allowedBrowserRequest(url, offline),
    (route) => route.abort("blockedbyclient"),
  );
  const close = async () => {
    try {
      await context.close();
    } finally {
      fs.rmSync(profile, { recursive: true, force: true, maxRetries: 5, retryDelay: 200 });
    }
  };
  return { context, close, version: context.browser()?.version() ?? "" };
}
