import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {tmpdir} from 'node:os';
import {createRequire} from 'node:module';
import {spawnSync} from 'node:child_process';
import {createHash} from 'node:crypto';
import {inspectDeclaredRuntime,inspectMatrixSource,verifyMatrixProfile} from '../../tools/runtime-db-matrix/source-profile.mjs';
const base=fs.mkdtempSync(path.join(tmpdir(),'decko-peer-controls-'));
console.log('Owned peer dependency controls: '+base);
let serial=0;
function fixture(packages,installed=Object.keys(packages).filter(Boolean)){
 const root=path.join(base,String(++serial));fs.mkdirSync(root);fs.mkdirSync(path.join(root,'node_modules'));
 fs.writeFileSync(path.join(root,'package-lock.json'),JSON.stringify({packages}));
 for(const key of installed){const dir=path.join(root,key),name=key.slice(key.lastIndexOf('node_modules/')+13);fs.mkdirSync(dir,{recursive:true});fs.writeFileSync(path.join(dir,'package.json'),JSON.stringify({name,version:packages[key].version,main:'./index.js'}));fs.writeFileSync(path.join(dir,'index.js'),'throw Error("identity fixture; package must never execute");\n');}
 return{root,packages};
}
const key=name=>'node_modules/'+name;
function peers(peerDependencies={beta:'1.0.0'},peerDependenciesMeta){return{'':{dependencies:{alpha:'1.0.0'}},[key('alpha')]:{version:'1.0.0',peerDependencies,peerDependenciesMeta},[key('beta')]:{version:'1.0.0',peer:true}};}
function snapshot(f){
 const git=args=>{const r=spawnSync('git',args,{cwd:f.root,windowsHide:true,encoding:'utf8',env:{...process.env,GIT_AUTHOR_NAME:'Peer Identity Fixture',GIT_AUTHOR_EMAIL:'fixture@example.invalid',GIT_COMMITTER_NAME:'Peer Identity Fixture',GIT_COMMITTER_EMAIL:'fixture@example.invalid',GIT_OPTIONAL_LOCKS:'0'}});assert.equal(r.status,0,r.stderr);return r.stdout.trim();};
 git(['init']);git(['add','--','package-lock.json']);git(['commit','-m','Synthetic peer identity input','--','package-lock.json']);
 const closure=inspectDeclaredRuntime(f.root),file=path.join(f.root,'package-lock.json'),b=fs.readFileSync(file);
 const profile={source:inspectMatrixSource(f.root,git(['rev-parse','HEAD'])),runtime:{...closure,node:{path:file,physicalPath:fs.realpathSync.native(file),sha256:createHash('sha256').update(b).digest('hex')},entries:[],nativeInventory:[]},tools:[],obligations:[]};assert.equal(verifyMatrixProfile(profile),true);return profile;
}
test('required peer-only Vite is included, matching the installed Vitest failure shape',()=>{const f=fixture({'':{devDependencies:{vitest:'5.0.1'}},[key('vitest')]:{version:'5.0.1',peerDependencies:{vite:'^8.0.0'},peerDependenciesMeta:{vite:{optional:false}}},[key('vite')]:{version:'8.3.0',peer:true}});assert(inspectDeclaredRuntime(f.root).packages.some(p=>p.name==='vite'));});
test('required peer missing from disk refuses rather than disappearing from the closure',()=>{const f=fixture(peers(),[key('alpha')]);assert.throws(()=>inspectDeclaredRuntime(f.root),/required.*beta|ENOENT/i);});
test('required peer missing from the immutable lock refuses',()=>{const p=peers();delete p[key('beta')];const f=fixture(p);assert.throws(()=>inspectDeclaredRuntime(f.root),/immutable lock.*beta|beta.*immutable lock/i);});
test('optional peer absent without a lock entry is recorded and does not refuse',()=>{const p=peers({absent:'*'},{absent:{optional:true}});delete p[key('beta')];const f=fixture(p),c=inspectDeclaredRuntime(f.root);assert.equal(c.packages.length,1);assert(c.missingOptional.some(x=>x.path.includes('absent')));});
test('installed optional peer is fully inventoried',()=>{const f=fixture(peers({beta:'*'},{beta:{optional:true}}));assert(inspectDeclaredRuntime(f.root).files.some(p=>p.path.endsWith(path.join('beta','index.js'))));});
test('peer metadata optional false and omitted both keep a peer required',()=>{for(const meta of [{beta:{optional:false}},undefined]){const f=fixture(peers({beta:'*'},meta),[key('alpha')]);assert.throws(()=>inspectDeclaredRuntime(f.root),/required.*beta|ENOENT/i);}});
test('an optional peer that is also an ordinary dependency remains required',()=>{const p=peers({beta:'*'},{beta:{optional:true}});p[key('alpha')].dependencies={beta:'*'};const f=fixture(p,[key('alpha')]);assert.throws(()=>inspectDeclaredRuntime(f.root),/required.*beta|ENOENT/i);});
test('nearest actual installed locked peer wins even when a closer locked copy is absent',()=>{const p=peers();p['node_modules/alpha/node_modules/beta']={version:'2.0.0'};const f=fixture(p,[key('alpha'),key('beta')]);const resolved=createRequire(path.join(f.root,'node_modules/alpha/package.json')).resolve('beta');assert(resolved.endsWith(path.join('node_modules','beta','index.js')));assert(inspectDeclaredRuntime(f.root).packages.some(p=>p.key===key('beta')));});
test('nearest installed nested locked peer wins over the root copy',()=>{const p=peers();p['node_modules/alpha/node_modules/beta']={version:'2.0.0'};const f=fixture(p);const c=inspectDeclaredRuntime(f.root);assert(c.packages.some(p=>p.key==='node_modules/alpha/node_modules/beta'));assert(!c.packages.some(p=>p.key===key('beta')));});
test('scoped package resolution checks intermediate scope node_modules',()=>{const p={'':{dependencies:{'@scope/alpha':'1.0.0'}},'node_modules/@scope/alpha':{version:'1.0.0',peerDependencies:{beta:'*'}},'node_modules/@scope/node_modules/beta':{version:'1.0.0'}};const f=fixture(p);const resolved=createRequire(path.join(f.root,'node_modules/@scope/alpha/package.json')).resolve('beta');assert(resolved.includes(path.join('@scope','node_modules','beta')));assert.equal(inspectDeclaredRuntime(f.root).packages.length,2);});
test('peer cycles and duplicate ordinary/peer edges terminate and inventory each package once',()=>{const p=peers();p[key('alpha')].dependencies={beta:'*'};p[key('beta')].peerDependencies={alpha:'*'};const f=fixture(p),c=inspectDeclaredRuntime(f.root);assert.equal(c.packages.length,2);assert.equal(new Set(c.files.map(x=>x.physicalPath)).size,c.files.length);});
test('optional peer appearance changes membership',()=>{const p=peers({absent:'*'},{absent:{optional:true}});delete p[key('beta')];const f=fixture(p),profile=snapshot(f),dir=path.join(f.root,'node_modules/absent');fs.mkdirSync(dir);fs.writeFileSync(path.join(dir,'package.json'),'{"name":"absent","version":"1.0.0"}');assert.throws(()=>verifyMatrixProfile(profile),/lock|membership|optional/i);});
test('required peer payload addition and same-byte physical replacement invalidate custody',()=>{for(const mutation of ['addition','replacement']){const f=fixture(peers()),profile=snapshot(f),file=path.join(f.root,'node_modules/beta/index.js');if(mutation==='addition')fs.writeFileSync(path.join(f.root,'node_modules/beta/new.js'),'throw Error("never execute");');else{const b=fs.readFileSync(file);fs.renameSync(file,path.join(base,'retained-'+serial));fs.writeFileSync(file,b);}assert.throws(()=>verifyMatrixProfile(profile),/runtime.*membership|runtime.*identity/i);}});
test('optional peer directory with missing metadata refuses instead of treating it as absent',()=>{const p=peers({absent:'*'},{absent:{optional:true}});delete p[key('beta')];const f=fixture(p);fs.mkdirSync(path.join(f.root,'node_modules/absent'));fs.writeFileSync(path.join(f.root,'node_modules/absent/index.js'),'throw Error("never execute");');assert.throws(()=>inspectDeclaredRuntime(f.root),/optional|lock/i);});
test('non-ENOENT optional peer lookup failures propagate',t=>{const p=peers({absent:'*'},{absent:{optional:true}});delete p[key('beta')];const f=fixture(p),original=fs.lstatSync;t.mock.method(fs,'lstatSync',(file,...args)=>{if(file===path.join(f.root,'node_modules/alpha/node_modules/absent'))throw Object.assign(Error('injected optional lookup denial'),{code:'EACCES'});return original(file,...args);});assert.throws(()=>inspectDeclaredRuntime(f.root),{code:'EACCES'});});
test('a required peer remains required when the same edge is also an optional dependency',()=>{const p=peers();p[key('alpha')].optionalDependencies={beta:'*'};const f=fixture(p,[key('alpha')]);assert.throws(()=>inspectDeclaredRuntime(f.root),/required.*beta|ENOENT/i);});
test('an earlier optional miss cannot suppress a later required peer miss',()=>{const p={'':{dependencies:{alpha:'*',gamma:'*'}},[key('alpha')]:{version:'1.0.0',peerDependencies:{beta:'*'},peerDependenciesMeta:{beta:{optional:true}}},[key('gamma')]:{version:'1.0.0',peerDependencies:{beta:'*'}},[key('beta')]:{version:'1.0.0'}};const f=fixture(p,[key('alpha'),key('gamma')]);assert.throws(()=>inspectDeclaredRuntime(f.root),/required.*beta|ENOENT/i);});
test('a new nearer locked peer directory invalidates the previous hoisted resolution',()=>{const p=peers();p['node_modules/alpha/node_modules/beta']={version:'2.0.0'};const f=fixture(p,[key('alpha'),key('beta')]),profile=snapshot(f),dir=path.join(f.root,'node_modules/alpha/node_modules/beta');fs.mkdirSync(dir,{recursive:true});fs.writeFileSync(path.join(dir,'package.json'),'{"name":"beta","version":"2.0.0"}');assert.throws(()=>verifyMatrixProfile(profile),/runtime.*membership|runtime.*identity/i);});
test('an unlocked nearer peer cannot silently shadow a locked root peer',()=>{const f=fixture(peers()),dir=path.join(f.root,'node_modules/alpha/node_modules/beta');fs.mkdirSync(dir,{recursive:true});fs.writeFileSync(path.join(dir,'package.json'),'{"name":"beta","version":"1.0.0"}');assert.throws(()=>inspectDeclaredRuntime(f.root),/shadows locked resolution/i);});
test('a package junction uses its physical importer search directories',()=>{const f=fixture(peers()),dir=path.join(f.root,'node_modules/alpha'),external=path.join(base,'external-'+serial);fs.renameSync(dir,external);fs.symlinkSync(external,dir,process.platform==='win32'?'junction':'dir');assert.throws(()=>inspectDeclaredRuntime(f.root),/required.*beta|immutable lock.*beta|shadows locked resolution/i);});
