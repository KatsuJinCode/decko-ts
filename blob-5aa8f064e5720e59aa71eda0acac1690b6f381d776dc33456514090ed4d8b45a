 for(const text of ['copied from C^:/Ruby33-x64/lib/ruby/gems/3.3.0',String.raw`built in D^:\build\out`,'e^:/work/tree','see `C^:/Ruby33-x64`',String.raw`"Z^:\\share\\deck"`].map(unmask))
  assert.ok(rules(text).includes('drive-letter-path'),text);
