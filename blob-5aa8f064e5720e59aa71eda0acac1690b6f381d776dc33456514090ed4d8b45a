const sha=bytes=>createHash('sha256').update(bytes).digest('hex');
// Scanner inputs carry a '^' break so this source never holds a marker itself;
// unmask() restores the exact value the scanner receives at runtime.
const unmask=text=>text.replaceAll('^','');
test('snapshot provenance works without Git and records modified files',()=>{
 const root=mkdtempSync(path.join(tmpdir(),'decko-source-manifest-'));
 try {
  writeFileSync(path.join(root,'source.ts'),'export const value=1;');
  writeFileSync(path.join(root,'HANDOVER-MANIFEST.json'),JSON.stringify({sourceCommit:'a'.repeat(40),files:[{path:'source.ts',sha256:sha('export const value=1;')}]}));
  assert.equal(sourceProvenance(root).changedSnapshotFiles,0);
  writeFileSync(path.join(root,'source.ts'),'export const value=2;');
  assert.equal(sourceProvenance(root).changedSnapshotFiles,1);
 }finally{rmSync(root,{recursive:true});}
});
test('source snapshot refuses traversal in its provenance manifest',()=>{
