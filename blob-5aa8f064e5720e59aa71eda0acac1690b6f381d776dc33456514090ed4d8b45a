test('privacy tripwires refuse JSON-escaped drive paths, tracker ids, ruling phrases and private-deck card names',()=>{
 const rules=(text,file='docs/x.md')=>scan(Buffer.from(text),file).map(hit=>hit.rule);
 for(const text of [JSON.stringify({path:unmask(String.raw`C^:\work\deck`)}),unmask('{"path":"C^:\\/work/deck"}')])
  assert.ok(rules(text).includes('drive-letter-path'),text);
 for(const text of ['see AC^T-123','DEC^KO-45 closed','RO^W-2','F^D-279','OP^S-6'].map(unmask))assert.ok(rules(text).includes('tracker-id'),text);
 for(const text of ['UTF-8 and SHA-256','decko-0','TINY-1234','LGPL-2.1'])assert.ok(!rules(text).includes('tracker-id'),text);
 for(const text of ["the operator^'s decision",'the lead’s rul^ing','Release-lead deci^sion, 2026-10-15','recorded ver^batim','was explicitly over^ruled'].map(unmask))
  assert.ok(rules(text).includes('ruling-phrase'),text);
 for(const text of ['a lead pipe','copied as written','the decision table'])assert.ok(!rules(text).includes('ruling-phrase'),text);
 for(const text of ['{{H^BQ logo}}','ZQ^VT+*self+*head','Martial Con^cordance Public Module','martial con^cordance','C^M 20100614','C^M20101113'].map(unmask))
  assert.ok(rules(text).includes('private-deck-name'),text);
 for(const text of ['HBQX','ACME 2010','CM 20 pages'])assert.ok(!rules(text).includes('private-deck-name'),text);
 for(const text of ['TYPE-Basic^Cs','{typeName: "Basic^Cs"}','child.target === "Admin^u"','[[Admin^u|Admin]]'].map(unmask))
  assert.ok(rules(text).includes('private-deck-name'),text);
