test('privacy tripwires decompress gzip content before scanning, and refuse gzip they cannot read',()=>{
 const hits=scan(gzipSync(Buffer.from(unmask('a ZQ^VT card and C^:/Ruby33-x64/lib'))),'reference-harness/fixtures/x/expected/render.jsonl.gz');
 assert.ok(hits.some(hit=>hit.rule==='private-deck-name'&&hit.encoding==='gzip-utf8'));
 assert.ok(hits.some(hit=>hit.rule==='drive-letter-path'&&hit.encoding==='gzip-utf8'));
 assert.ok(scan(gzipSync(Buffer.from(unmask('Jul^ian'),'utf16le')),'fixture.gz').some(hit=>hit.rule==='private-identity'&&hit.encoding==='gzip-utf16le'));
 assert.ok(scan(gzipSync(Buffer.from(unmask('DEC^KO-7'))),'blob.bin').some(hit=>hit.rule==='tracker-id'),'gzip magic without a .gz name');
 assert.deepEqual(scan(gzipSync(Buffer.from('nothing private')),'clean.jsonl.gz'),[]);
 for(const [bytes,file] of [[Buffer.from('not gzip'),'broken.gz'],[Buffer.from([0x1f,0x8b,0,1,2,3]),'truncated.bin']])
  assert.ok(scan(bytes,file).some(hit=>hit.rule==='unreadable-gzip'),file);
});
test('a complete gzip stream is scanned through its content, and bytes after the stream are still scanned as text',()=>{
 const file='reference-harness/fixtures/synthetic-v1/expected/render.jsonl.gz';
 const stream=readFileSync(fileURLToPath(new URL(`../../${file}`,import.meta.url)));
 // Read as text, this compressed stream holds drive-letter-shaped byte runs
 // by chance; its decompressed content holds none.
 assert.deepEqual(scan(stream,file),[]);
 const trailing=scan(Buffer.concat([stream,Buffer.from('\nC:/Users/someone/secret Julian\n')]),file);
 assert.ok(trailing.some(hit=>hit.rule==='machine-path'&&hit.encoding==='utf8'),'a path appended after the stream');
 assert.ok(trailing.some(hit=>hit.rule==='private-identity'&&hit.encoding==='utf8'),'a name appended after the stream');
 assert.ok(scan(stream,'reference-harness/fixtures/brandon/render.jsonl.gz').some(hit=>hit.rule==='private-identity'),'the file name is still scanned');
 const padded=scan(Buffer.concat([stream,Buffer.from('\0C:/Users/someone/secret Julian\n')]),file);
 assert.ok(!padded.some(hit=>hit.rule==='unreadable-gzip'),'zero padding after the stream decompresses');
 assert.ok(padded.some(hit=>hit.rule==='machine-path'&&hit.encoding==='utf8'),'a path after zero padding is scanned as raw text');
 assert.ok(padded.some(hit=>hit.rule==='private-identity'&&hit.encoding==='utf8'),'a name after zero padding is scanned as raw text');
 const named=Buffer.concat([stream.subarray(0,3),Buffer.from([stream[3]|0x08]),stream.subarray(4,10),Buffer.from('Julian-render.jsonl\0'),stream.subarray(10)]);
 const namedHits=scan(named,file);
 assert.ok(!namedHits.some(hit=>hit.rule==='unreadable-gzip'),'a header with an FNAME field still decompresses');
 assert.ok(namedHits.some(hit=>hit.rule==='private-identity'&&hit.encoding==='utf8'),'a name in the gzip header FNAME field is scanned');
 const stamped=Buffer.concat([stream.subarray(0,4),Buffer.from('Julian'),stream.subarray(10)]);
 assert.ok(scan(stamped,file).some(hit=>hit.rule==='private-identity'),'text in the six fixed header bytes is scanned');
});
