function execFileSyncResult(executable, args, cwd) {
  const result = spawnSync(executable, args, { cwd, windowsHide: true, shell: false, encoding: 'utf8', maxBuffer: Infinity });
  return { status: result.status, signal: result.signal, error: result.error?.message ?? null, stdout: result.stdout, stderr: result.stderr };
}

