    const file = path.join(dir, 'consumer.ts'), config = path.join(dir, 'tsconfig.json');
    fs.writeFileSync(config, JSON.stringify({ extends: path.join(root, 'tsconfig.json'), compilerOptions: { rootDir: dir }, files: [file], include: [], exclude: [] }));
