test('actual TS5097 source import retains fresh/owned suppression while strict fails', () => {
  const dir = scratchDir('native-typescript-source-import-');
  try {
    for (const file of ['scripts/check-scoped.mjs', 'tools/platform/native-typescript-compiler.mjs']) {
      fs.mkdirSync(path.dirname(path.join(dir, file)), { recursive: true });fs.writeFileSync(path.join(dir, file), source(file));
    }
    fs.writeFileSync(path.join(dir, 'package.json'), '{"type":"module","private":true}\n');
    const imported = path.join(dir, 'source.ts');
    fs.writeFileSync(imported, 'import {value} from "./exported.ts";\nexport const result = value;\n');
    fs.writeFileSync(path.join(dir, 'exported.ts'), 'export const value: string = "valid";\n');
    const config = JSON.stringify({ compilerOptions: { noEmit: true, strict: true, types: [], module: 'NodeNext', moduleResolution: 'NodeNext' }, files: [imported, path.join(dir, 'exported.ts')], include: [] }, null, 2) + '\n';
    fs.writeFileSync(path.join(dir, 'tsconfig.json'), config);
    const native = spawnNativeTypeScript(dir, ['--noEmit', '--pretty', 'false'], { cwd: dir, encoding: 'utf8' });
    assert.equal(native.status, 1);assert.match(native.stdout + native.stderr, /source\.ts\(1,21\): error TS5097:/);
    const scoped = [];
    for (const args of [[], ['--running', 'source.ts=review-source'], ['--strict']]) {
      const result = execFileSyncResult(process.execPath, [path.join(dir, 'scripts/check-scoped.mjs'), ...args], dir);
      assert.equal(result.status, args.includes('--strict') ? 1 : 0, result.stderr);assert.match(result.stderr, /TS5097/);assert.equal(result.signal, null);assert.equal(result.error, null);
      assert.equal(result.stderr.includes('[check-scoped] PASS'), !args.includes('--strict'));scoped.push({ args, ...result });
    }
    fs.writeFileSync(imported, 'import {value} from "./exported.js";\nexport const result = value;\n');
    const valid = spawnNativeTypeScript(dir, ['--noEmit', '--pretty', 'false'], { cwd: dir, encoding: 'utf8' });
    assert.equal(valid.status, 0, valid.stdout + valid.stderr);assert.equal(valid.signal, null);assert.equal(valid.error, undefined);
    assert.equal(fs.readFileSync(path.join(dir, 'tsconfig.json'), 'utf8'), config);
    console.info(JSON.stringify({ kind: 'actual-native-TS5097-source-boundary', native: { status: native.status, stdout: native.stdout, stderr: native.stderr }, scoped, correctedImport: { status: valid.status, stdout: valid.stdout, stderr: valid.stderr }, configurationUnchanged: true }));
  } finally { removeScratchDir(dir); }
});

