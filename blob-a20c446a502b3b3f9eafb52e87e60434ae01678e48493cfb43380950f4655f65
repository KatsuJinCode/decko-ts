      fs.mkdirSync(path.dirname(path.join(dir, file)), { recursive: true });fs.writeFileSync(path.join(dir, file), source(file));
    }
    fs.writeFileSync(path.join(dir, 'package.json'), '{"type":"module","private":true}\n');
    fs.writeFileSync(path.join(dir, 'valid.ts'), 'export const answer: string = "valid";\n');
    fs.writeFileSync(path.join(dir, 'tsconfig.json'), JSON.stringify({ compilerOptions: { noEmit: true, strict: true, types: [], declarationMap: true, declaration: false }, files: [path.join(dir, 'valid.ts')], include: [] }, null, 2) + '\n');
    const native = spawnNativeTypeScript(dir, ['--noEmit', '--pretty', 'false'], { cwd: dir, encoding: 'utf8' });
    assert.equal(native.status, 1);assert.match(native.stdout + native.stderr, /error TS5069:/);
    const receipts = [];
    for (const args of [[], ['--running', 'tsconfig.json=review-fixture'], ['--strict']]) {
      const result = execFileSyncResult(process.execPath, [path.join(dir, 'scripts/check-scoped.mjs'), ...args], dir);
      assert.equal(result.status, 1, result.stderr);assert.equal(result.signal, null);assert.equal(result.error, null);assert.match(result.stderr, /TS5069/);assert(!result.stderr.includes('[check-scoped] PASS'));
      receipts.push({ args, ...result });
