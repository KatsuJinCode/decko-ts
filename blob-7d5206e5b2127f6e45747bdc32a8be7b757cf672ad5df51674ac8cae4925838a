    // Node legitimately omits fields such as type/testNumber on some events.
    // Compare every supplied identity field without filling in absent fields.
    for(const field of ['name','file','parentId','nesting','line','column','testNumber'])if(Object.hasOwn(data,field)){
      if(Object.hasOwn(identity.fields,field))assert.deepEqual(data[field],identity.fields[field],'Lifecycle '+field+' changed within stream/testId');
      else identity.fields[field]=data[field];
    }
    identity.phases.set(event.type,(identity.phases.get(event.type)??0)+1);
    assert.ok(!data.skip&&!data.todo,'Lifecycle skip/todo contradicts PASS');
    assert.notEqual(event.type,'test:fail','Lifecycle contains a failed assertion');
