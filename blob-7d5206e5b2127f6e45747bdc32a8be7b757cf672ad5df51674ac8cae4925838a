export function verifyControllerStreams(out,runs){
  assert.ok(Array.isArray(runs));exactSet(runs.map(row=>row.stage),['host','deployment'],'Controller stream identities mismatch');
  for(const run of runs)for(const channel of ['stdout','stderr']){
    assert.equal(typeof run[channel],'string','Captured controller stream missing');
    const raw=read(out,run.stage+'.'+channel+'.log');
