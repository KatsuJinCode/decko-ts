const json=(out,file)=>JSON.parse(read(out,file));
const lines=(out,file)=>read(out,file).toString().trim().split(/\r?\n/).filter(Boolean).map(JSON.parse);
const exactSet=(actual,expected,message)=>{assert.equal(new Set(actual).size,actual.length,message);assert.deepEqual([...actual].sort(),[...expected].sort(),message);};
