    for(const identity of cases){let matches=true,known=true;for(const field of ['parentId','nesting'])if(Object.hasOwn(plan,field)){assert.ok(Number.isSafeInteger(plan[field])&&plan[field]>=0,'Invalid plan scope');if(supplied(identity,field)){if(identity.fields[field]!==plan[field])matches=false;}else known=false;}
      if(matches){possible++;if(known)definite++;}
    }
    if(Object.hasOwn(plan,'parentId')&&plan.parentId!==0)assert.ok(namespaces.get(stream).has(plan.parentId),'Plan parent does not exist');
    assert.ok(Number.isSafeInteger(plan.count)&&plan.count>=definite&&plan.count<=possible,'Plan count contradicts actual assertions');
