  const prefix='full-host/'+runs[0].name;
  exactSet(fs.readdirSync(path.join(out,prefix)),['subject.json',...HOST_LABELS.flatMap(label=>[label+'.json',label+'-observations.jsonl'])],'Missing, duplicate or extra host case files');
  return {prefix,subject:json(out,prefix+'/subject.json'),cases:HOST_LABELS.map(label=>({row:json(out,prefix+'/'+label+'.json'),events:lines(out,prefix+'/'+label+'-observations.jsonl')}))};
}
