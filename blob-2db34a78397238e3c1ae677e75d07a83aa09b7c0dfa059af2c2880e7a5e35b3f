// The edge write surface's compilers, against the bytes the Node hosts and
// the Ruby oracle produce.
//
//   1. the WebAssembly LibSass (src/server/libsass-wasm.ts, the module
//      tools/libsass/build-wasm.mjs builds and vendor/libsass-wasm/ vendors)
//      compiles every Bootswatch skin's assembled SCSS to exactly the
//      stylesheet the oracle stored (tests/card/assets/fixtures/
//      skin-stylesheet-oracle.json) and exactly the bytes the Node host's
//      native program (tools/libsass/build-native.mjs) produces — the
//      import fails when the vendored module is absent, so these cases
//      CANNOT pass without it (that is the point: the edge compile rides
//      the artifact);
//   2. the embedded asset-source snapshots (vendor/edge-*-snapshot.js,
//      generated by tools/vendor/build-edge-asset-source-snapshot.mjs) are
//      byte-identical to fixtures/vendor/ — the edge fallback can never
//      quietly serve stale sources.

import { describe, it, expect } from "vitest";
import { createHash } from "node:crypto";
import { readFileSync, readdirSync, statSync } from "node:fs";
import { join, relative, sep } from "node:path";
import { fileURLToPath } from "node:url";
import { libsassWasmCompiler } from "../../src/server/libsass-wasm.js";
import { libsassProcessCompiler } from "../../src/server/libsass-process.js";
import { coffeeNpmCompiler } from "../../src/server/coffee-npm-compiler.js";
import {
  bootswatchSkinContent,
  renderStyleChunks,
  type StyleAssetDeps,
  type StyleCard,
} from "../../src/card/assets/skin-stylesheet.js";
import { DeckoName } from "../../src/card/name.js";

// The snapshot modules (generated); each pinned against the tree below.
import { edgeAssetSources as bootstrapSnapshot } from "../../vendor/edge-bootstrap-scss-snapshot.js";
import { edgeAssetSources as styleSnapshot } from "../../vendor/edge-style-source-snapshot.js";
import { edgeAssetSources as scriptSnapshot } from "../../vendor/edge-script-source-snapshot.js";

const REPO = join(fileURLToPath(new URL("../..", import.meta.url)));
const ORACLE = JSON.parse(
  readFileSync(join(REPO, "tests", "card", "assets", "fixtures", "skin-stylesheet-oracle.json"), "utf8"),
) as {
  mod_style_cards: { name: string }[];
  skins: { name: string; codename: string; colors: string | null; variables: string | null; stylesheets: [string, string][] | null; content: { sha256: string; length: number }; compressed: { sha256: string; length: number } }[];
};

const sha256 = (text: string) => createHash("sha256").update(text, "utf8").digest("hex");
const digest = (text: string) => ({ sha256: sha256(text), length: text.length });
const modName = (modStyleCard: string) => modStyleCard.replace(/^mod: /, "").replace(/\+\*style$/, "").replace(/ /g, "_");

/** The oracle deck as the skin assembly reads it — the same shape
 *  tests/card/assets/skin-stylesheet.test.ts builds for its compile cases. */
function oracleDeckDeps(): StyleAssetDeps {
  const cards = new Map<string, StyleCard>();
  let id = 1;
  const add = (name: string, typeCode: string, dbContent = "", codename?: string) => {
    const card: StyleCard = { id: id++, name, key: DeckoName.parse(name).key, typeCode, codename, dbContent, leftId: undefined, rightId: undefined };
    cards.set(card.key, card);
    return card;
  };
  add("bootstrap: functions", "bootstrap_code_file", "", "bootstrap_functions");
  add("bootstrap: core", "bootstrap_code_file", "", "bootstrap_core");
  add("style: mods", "pointer", ORACLE.mod_style_cards.map((m) => m.name).join("\n"), "style_mods");
  for (const m of ORACLE.mod_style_cards) {
    add(m.name, "pointer");
    add(m.name.replace(/\+\*style$/, ""), "mod", "", `mod_${modName(m.name)}`);
  }
  for (const skin of ORACLE.skins) {
    add(skin.name, "bootswatch_skin", "", skin.codename === "" ? undefined : skin.codename);
    if (skin.colors !== null) add(`${skin.name}+*colors`, "scss", skin.colors);
    if (skin.variables !== null) add(`${skin.name}+*variables`, "scss", skin.variables);
    if (skin.stylesheets !== null) {
      add(`${skin.name}+*stylesheets`, "skin", skin.stylesheets.map(([n]) => n).join("\n"));
      for (const [n, content] of skin.stylesheets) add(n, "scss", content);
    }
  }
  const byCodename = new Map([...cards.values()].filter((c) => c.codename).map((c) => [c.codename!, c]));
  return {
    card: async (name) => cards.get(DeckoName.parse(name).key),
    cardByCodename: async (code) => byCodename.get(code),
    compile: undefined,
  };
}

/** Each skin's assembled SCSS (the stored-content digest Ruby pins) and the
 *  compile input the write path derives from it (links rendered, exactly what
 *  tests/card/assets/skin-stylesheet.test.ts compiles with the Node host). */
async function skinScss(skinName: string): Promise<{ assembled: string; input: string }> {
  const deps = oracleDeckDeps();
  const card = await deps.card(skinName);
  const assembled = await bootswatchSkinContent(deps, card!);
  return { assembled, input: renderStyleChunks(assembled, deps.relativeRoot) };
}

const SASSC = join(REPO, "tools", "libsass", "build", process.platform === "win32" ? "sassc-stdin.exe" : "sassc-stdin");
const haveNativeLibsass = (() => {
  try {
    statSync(SASSC);
    return true;
  } catch {
    return false;
  }
})();

describe("the WebAssembly LibSass compiles Ruby's stylesheets byte for byte", () => {
  const compile = libsassWasmCompiler();

  for (const skin of ORACLE.skins) {
    it(`${skin.name}: wasm == oracle,${haveNativeLibsass ? " wasm == node program," : ""} byte for byte`, async () => {
      const { assembled, input } = await skinScss(skin.name);
      expect(digest(assembled)).toEqual(skin.content);
      const wasmCss = await compile(input, "compressed");
      expect(digest(wasmCss)).toEqual(skin.compressed);
      if (haveNativeLibsass) {
        const nativeCss = await libsassProcessCompiler(SASSC)(input, "compressed");
        expect(wasmCss).toBe(nativeCss);
      }
    }, 60_000);
  }

  it("compiles small styles the node program agrees with", async () => {
    const scss = "$primary: #123456; a { color: $primary; b { weight: bold; } }";
    const wasmCss = await compile(scss, "compressed");
    // LibSass's compressed output carries a final newline (the native
    // program's bytes too — sassc-stdin compressed, od -c).
    expect(wasmCss).toBe("a{color:#123456}a b{weight:bold}\n");
    if (haveNativeLibsass) {
      expect(wasmCss).toBe(await libsassProcessCompiler(SASSC)(scss, "compressed"));
    }
  });

  it("rejects a broken stylesheet with LibSass's message, as the node compiler does", async () => {
    await expect(compile("a { color: ; }", "compressed")).rejects.toThrow(/LibSass compile failed/);
  });

  it("compiles the empty template to nothing without instantiating a compile", async () => {
    expect(await compile("", "compressed")).toBe("");
  });
});

describe("the CoffeeScript compiler is the same bytes on every host", () => {
  it("the npm compile the edge bundles carry matches the no_wrap contract", () => {
    const compile = coffeeNpmCompiler();
    // 02_coffee_script.rb:26-27 — no_wrap: bare_compile, the {bare:} option.
    expect(compile("x = 1", true)).toBe("var x;\n\nx = 1;\n");
    expect(compile("x = 1", false)).toBe("(function() {\n  var x;\n\n  x = 1;\n\n}).call(this);\n");
  });
});

describe("the embedded asset-source snapshots equal fixtures/vendor byte for byte", () => {
  const cases = [
    ["edge-bootstrap-scss-snapshot.js", bootstrapSnapshot, ["bootstrap-scss"]],
    ["edge-style-source-snapshot.js", styleSnapshot, ["mod-style-assets", "bootswatch"]],
    ["edge-script-source-snapshot.js", scriptSnapshot, ["mod-script-assets"]],
  ] as const;

  for (const [name, snapshot, subtrees] of cases) {
    it(`${name}: every file matches the tree, and the tree has no strays`, () => {
      const tree = new Map<string, string>();
      const vendorDir = join(REPO, "fixtures", "vendor");
      const walk = (dir: string) => {
        for (const entry of readdirSync(dir)) {
          const full = join(dir, entry);
          if (statSync(full).isDirectory()) walk(full);
          else tree.set(relative(vendorDir, full).split(sep).join("/"), readFileSync(full, "utf8"));
        }
      };
      for (const subtree of subtrees) walk(join(vendorDir, subtree));

      const keys = [...Object.keys(snapshot)].sort();
      expect(keys).toEqual([...tree.keys()].sort());
      for (const [path, text] of tree) {
        expect(snapshot[path]).toBe(text);
      }
    });
  }
});
