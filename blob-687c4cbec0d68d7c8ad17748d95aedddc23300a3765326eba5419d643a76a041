import {afterEach, describe, expect, it} from "vitest";
import {bunnyEdgeWriteFlags, type BunnyEdgeEnv} from "../../deploy/bunny-worker-src/bunny-edge-signin-session-surface.js";
import {applySecuritySettings} from "../../src/server/cloudflare-write-routes.js";
import {configurePasswordHashing} from "../../src/card/auth/password-hash.js";
import {configureSigninSecurity} from "../../src/card/auth/signin-security.js";
import {configureStrictParity, STRICT_PARITY_ENV_NAMES, strictParityFlags} from "../../src/card/parity/strict-parity-flags.js";

afterEach(() => {
  configureStrictParity(undefined);
  configurePasswordHashing(undefined);
  configureSigninSecurity(undefined);
});

describe("Bunny strict settings through its actual shared-security bridge", () => {
  for (const [property, name] of Object.entries(STRICT_PARITY_ENV_NAMES)) {
    it(`${name} honors explicit settings and its declared default`, () => {
      for (const value of ["on", "off", undefined]) {
        applySecuritySettings(bunnyEdgeWriteFlags({[name]: value}));
        const expected = value === "on" || (value === undefined && property === "mailUnfollowRefusal");
        expect(strictParityFlags()[property as keyof ReturnType<typeof strictParityFlags>]).toBe(expected);
      }
    });
    it(`${name} reaches named malformed-value rejection`, () => {
      for (const value of ["maybe", null, true, false, 1, {}, []]) {
        const env = {[name]: value} as unknown as BunnyEdgeEnv;
        expect(() => applySecuritySettings(bunnyEdgeWriteFlags(env))).toThrow(new RegExp(`${name} must be`));
      }
    });
  }
});
