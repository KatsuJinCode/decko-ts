#!/usr/bin/env bash
# Runs one oracle session for the browser journeys harness on the VM: the
# second instance of the vm-ruby application (the same code the shadow
# router records) over a private copy of the synthetic-v1 fixture deck.
# Lives beside ruby-server.sh in the second instance's browser/engines/
# directory; the instance root is two levels up.
#
#   vm-session.sh stage <session-id> <port>   stage a fresh deck copy and
#                                             boot the reference server
#   vm-session.sh stop <session-id>           touch the session's stop file;
#                                             the boot watcher ends the
#                                             server, the session stays
#   vm-session.sh cleanup <session-id>        remove the session directory
#
# The server's lifecycle is the stop file: stage starts a watcher beside the
# server that ends the server when sessions/<id>/stop appears. Nothing here
# touches the vm-ruby instance the shadow router records: different port,
# own fixture seed, own process, own directory.
set -euo pipefail
ENGINES="$(cd "$(dirname "$0")" && pwd)"
INSTANCE="$(cd "$ENGINES/../.." && pwd)"
SESSIONS="$INSTANCE/sessions"
SEED_DB="$INSTANCE/seed/deck.sqlite3"
SEED_FILES="$INSTANCE/seed/files"
SEED_DECK_JSON="$INSTANCE/seed/deck.json"
# The reference application on the VM. stock (default): the harness's own
# stock oracle app (reference-harness/oracle/app), the same card 1.110.0 /
# decko 0.20.0 code the vm-ruby application carries, WITHOUT the site's
# custom mods and custom root route (the deployed vm-ruby application serves
# a demo landing page at "/" and 15 library mods, so its pages are not the
# stock Decko pages the journeys grade). vmruby: the deployed application's
# own copy (for inspection; not a grading reference).
APP="${HARNESS_VM_APP:-stock}"
case "$APP" in
  stock) APP_DIR="$INSTANCE/oracle-stock/app" ;;
  vmruby) APP_DIR="$INSTANCE/oracle/app" ;;
  *) echo "HARNESS_VM_APP must be stock or vmruby, got $APP" >&2; exit 2 ;;
esac

cmd="${1:-}"
id="${2:-}"
case "$cmd" in
  stage)
    port="${3:?port required}"
    dir="$SESSIONS/$id"
    [ ! -e "$dir" ] || { echo "session $id already exists" >&2; exit 2; }
    mkdir -p "$dir/work" "$dir/files"
    cp "$SEED_DB" "$dir/deck.sqlite3"
    cp -r "$SEED_FILES/." "$dir/files/"
    cp "$SEED_DECK_JSON" "$dir/deck.json"
    (
      while [ ! -f "$dir/stop" ]; do sleep 1; done
      sleep 1
      term_pid="$(cat "$dir/pid" 2>/dev/null || true)"
      if [ -n "$term_pid" ]; then
        kill -TERM "$term_pid" 2>/dev/null || true
      fi
    ) > /dev/null 2>&1 < /dev/null &
    echo $! > "$dir/watcher.pid"
    nohup env \
      RAILS_ENV=development \
      DISABLE_SPRING=1 \
      BUNDLE_GEMFILE="$APP_DIR/Gemfile" \
      BUNDLE_PATH=/opt/site-demo/shared/gems \
      HARNESS_ORACLE_APP_DIR="$APP_DIR" \
      HARNESS_DECK="$dir/deck.sqlite3" \
      HARNESS_FILES="$dir/files" \
      HARNESS_DECK_JSON="$dir/deck.json" \
      HARNESS_WORK="$dir/work" \
      HARNESS_PORT="$port" \
      bash "$ENGINES/ruby-server.sh" > "$dir/server.log" 2>&1 < /dev/null &
    echo $! > "$dir/pid"
    echo "staged $id on port $port (server pid $(cat "$dir/pid"))"
    ;;
  stop)
    dir="$SESSIONS/$id"
    [ -d "$dir" ] || { echo "no session $id" >&2; exit 2; }
    touch "$dir/stop"
    for _ in $(seq 1 30); do
      server_pid="$(cat "$dir/pid" 2>/dev/null || true)"
      if [ -z "$server_pid" ] || ! kill -0 "$server_pid" 2>/dev/null; then
        echo "session $id server ended"
        exit 0
      fi
      sleep 1
    done
    echo "session $id server did not end within 30s" >&2
    exit 3
    ;;
  cleanup)
    dir="$SESSIONS/$id"
    [ -d "$dir" ] || exit 0
    watcher_pid="$(cat "$dir/watcher.pid" 2>/dev/null || true)"
    if [ -n "$watcher_pid" ]; then
      touch "$dir/stop" 2>/dev/null || true
      kill -TERM "$watcher_pid" 2>/dev/null || true
    fi
    rm -rf "$dir"
    echo "cleaned $id"
    ;;
  *)
    echo "usage: vm-session.sh stage|stop|cleanup <session-id> [port]" >&2
    exit 2
    ;;
esac
