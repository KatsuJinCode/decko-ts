require "minitest/autorun"
require "digest"
require "json"
require "sqlite3"
gem_root = File.realpath(ARGV.shift || ENV.fetch("DECKO_RUBY_GEMSET"))
Dir.glob(File.join(gem_root, "*", "lib")).each do |lib|
  next if File.basename(File.dirname(lib)).start_with?("minitest-")
  $LOAD_PATH.unshift(lib)
end
require "active_support"
require "active_support/core_ext"
require "cardname"
name_source = File.join(gem_root, "cardname-1.110.0/lib/cardname.rb")
cache_source = File.join(gem_root, "card-1.110.0/lib/card/rule/cache.rb")
raise "native-name-source-changed" unless Digest::SHA256.file(name_source).hexdigest == "67a84cf2cfdede50632587419f60dea8311735245052cda87d8dac4efc979c19"
raise "native-rule-cache-source-changed" unless Digest::SHA256.file(cache_source).hexdigest == "17a240a32aed7c2ea07c69df21bfb78190a4cd501583171f2b23403de1f7736d"

# Only storage/codename dependencies are inert fixtures. The full original
# Rule::Cache class, including its SQL and lookup-key methods, is loaded.
class Card
  SetID = 13
  SettingID = 14
  module Codename
    def self.[](id) = {10 => "all", 15 => "type", 73 => "thanks"}[id]
  end
  class << self; attr_accessor :connection; end
end
load cache_source

class AccountBootstrapNativeControls < Minitest::Test
  def setup
    @db = SQLite3::Database.new(":memory:")
    @db.results_as_hash = true
    @db.execute_batch("CREATE TABLE cards(id INTEGER PRIMARY KEY,key TEXT,left_id INTEGER,right_id INTEGER,type_id INTEGER,db_content TEXT,trash INTEGER,codename TEXT);")
    [[12,nil,nil,5,nil],[15,nil,nil,14,"type"],[70,12,15,13,nil],[73,nil,nil,14,"thanks"],[74,70,73,52,nil]].each do |id,left,right,type,code|
      @db.execute("INSERT INTO cards VALUES(?,NULL,?,?,?,'signup_destination',0,?)",[id,left,right,type,code])
    end
    database = @db
    Card.connection = Object.new
    Card.connection.define_singleton_method(:select_all) { |sql| database.execute(sql) }
  end

  def teardown
    Card.connection = nil
    @db.close
  end

  def rules = Card::Rule::Cache.__send__(:lookup_hash)

  def test_actual_cardname_keeps_stars_and_singularizes_members
    assert_equal "*account", Cardname.new("*account").key
    assert_equal "*email", Cardname.new("*email").key
    assert_equal "*member", Cardname.new("*members").key
    assert_equal Cardname.new("Administrator").key, Cardname.new("Administrators").key
  end

  def test_incorrect_stored_key_is_not_found_by_native_name_key
    @db.execute("INSERT INTO cards VALUES(1202,'*members',NULL,NULL,2,'',0,'members')")
    assert_empty @db.execute("SELECT id FROM cards WHERE key=?",[Cardname.new("*members").key])
    @db.execute("UPDATE cards SET key='*member' WHERE id=1202")
    assert_equal [1202], @db.execute("SELECT id FROM cards WHERE key=?",[Cardname.new("*members").key]).map { |row| row["id"] }
  end

  def test_actual_rule_cache_qualifies_the_signup_type_thanks_rule
    assert_equal({"12+type+thanks" => 74}, rules)
  end

  def test_actual_rule_cache_rejects_untyped_set
    @db.execute("UPDATE cards SET type_id=2 WHERE id=70")
    assert_empty rules
  end

  def test_actual_rule_cache_rejects_untyped_setting
    @db.execute("UPDATE cards SET type_id=2 WHERE id=73")
    assert_empty rules
  end

  def test_actual_rule_cache_rejects_trashed_rule
    @db.execute("UPDATE cards SET trash=1 WHERE id=74")
    assert_empty rules
  end

  def test_actual_rule_cache_requires_the_registered_pattern_code
    @db.execute("UPDATE cards SET right_id=999 WHERE id=70")
    assert_empty rules
  end
end
