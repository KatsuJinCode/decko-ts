// Counterfactual build receipts are deliberately rejected controls, never
// substitutes for a real build or accepted native evidence.
for (const failure of ['no-new-receipt', 'foreign-commit']) test('real setup cannot admit a ' + failure + ' browser build', () => providerFixture(async ({ root, output, gemsDir, provider }) => {
  const source = { sourceCommit: 'a'.repeat(40), sourceDiffSha256: 'b'.repeat(64) };
  const stale = { ...source, sourceCommit: 'c'.repeat(40), config: 'tsconfig.browser-hosts.json', distSha256: 'd'.repeat(64) };
  const browserReceipt = path.join(root, '.runtime/browser-build.json');
  writeFileSync(browserReceipt, JSON.stringify(stale));
  const calls = [];
  await assert.rejects(prepareGateInputs({ root, directory: output, files: ['tests/server/owned.test.ts'] }, {
    resolveGemSource: () => gemsDir, observeSource: () => source, log() {},
    // Synthetic HTTP bytes are only an isolated refusal control. No browser or
    // Miniflare runs with them; actual CLI acceptance fetches the public URL.
    fetchMetadata: async () => new Response('{"control":"fresh fixture"}', { status: 200 }),
    execute(command) {
      calls.push(command.args);
      if (command.args[0].endsWith('setup-oracle-mod-public.mjs')) return realSetup(command);
      assert.equal(existsSync(browserReceipt), false, 'a previous receipt must be retired before build');
      if (failure === 'foreign-commit') writeFileSync(browserReceipt, JSON.stringify(stale));
      return { status: 0, signal: null, error: null, stdout: Buffer.alloc(0), stderr: Buffer.alloc(0) };
    },
  }), failure === 'foreign-commit' ? /stale or foreign build/ : /ENOENT/);
  assert.equal(calls.length, 2);
  assert.equal(existsSync(provider), false, 'own junctions must be unlinked on preflight failure');
  assert.equal(readFileSync(path.join(output, 'project-preflight/previous-browser-build.json'), 'utf8'), JSON.stringify(stale));
  const manifest = JSON.parse(readFileSync(path.join(output, 'project-preflight/mod-provider-manifest.json'), 'utf8'));
  assert.ok(manifest.complete && manifest.files.length > 0);
}));

test('fresh mod output refuses an existing provider and cleanup preserves source files and unknown data', () => providerFixture(async ({ root, output, gemsDir, provider, prepared }) => {
  mkdirSync(path.dirname(provider));
  const args = [path.join(root, 'tools/setup-oracle-mod-public.mjs'), '--gem-dir', gemsDir, '--public-dir', provider];
  assert.equal(realSetup({ root, args, env: process.env }).status, 0);
  const manifest = JSON.parse(readFileSync(path.join(provider, 'mod-provider-manifest.json'), 'utf8'));
  const sample = manifest.files[0], source = path.join(provider, sample.file), before = readFileSync(source);
  const again = realSetup({ root, args, env: process.env });
  assert.notEqual(again.status, 0); assert.match(again.stderr.toString(), /fresh public directory already exists/);
  const unknown = path.join(provider, 'unknown.txt'); writeFileSync(unknown, 'must retain');
  try {
    assert.throws(() => cleanupGateInputs(prepared), /Unknown public provider/);
    assert.equal(readdirSync(path.join(provider, 'mod')).length, 4);
  } finally { unlinkSync(unknown); }
  cleanupGateInputs(prepared);
  assert.equal(existsSync(provider), false);
  const mod = manifest.mods.find(mod => sample.file.startsWith('mod/' + mod.name + '/'));
  assert.deepEqual(readFileSync(path.join(mod.target, sample.file.slice(('mod/' + mod.name + '/').length))), before);
}));

test('source-bound build admission rejects source drift even with a plausible dist hash', () => {
  const source = { sourceCommit: 'a'.repeat(40), sourceDiffSha256: 'b'.repeat(64) };
  const receipt = { ...source, config: 'tsconfig.browser-hosts.json', distSha256: 'c'.repeat(64) };
  assert.doesNotThrow(() => assertFreshBrowserBuild(receipt, source));
  assert.throws(() => assertFreshBrowserBuild(receipt, { ...source, sourceCommit: 'd'.repeat(40) }), /stale or foreign/);
  assert.throws(() => assertFreshBrowserBuild(receipt, { ...source, sourceDiffSha256: 'e'.repeat(64) }), /stale or foreign/);
});

test('fresh metadata is fetched once and replaces an owned stale cache with exact readback bytes', () => providerFixture(async ({ root, output }) => {
  const cache = path.join(root, 'node_modules/.mf'); mkdirSync(cache);
  writeFileSync(path.join(cache, 'cf.json'), '{"control":"stale"}');
  const body = '{"control":"fresh UTF8 bytes é"}\n', phases = []; let requests = 0;
  const receipt = await prepareMiniflareMetadata({ root, directory: output, observeTiming: phase => phases.push(phase) }, {
    async fetchMetadata(url, options) {
      requests++; assert.equal(url, 'https://workers.cloudflare.com/cf.json');
      assert.equal(options.redirect, 'error'); assert.equal(options.credentials, 'omit');
      return new Response(body, { status: 200 });
    },
  });
  assert.equal(requests, 1); assert.equal(receipt.requests, 1); assert.equal(receipt.previousCacheUsed, false);
  assert.equal(readFileSync(receipt.file, 'utf8'), body);
  assert.equal(readFileSync(path.join(output, 'previous-cf.json'), 'utf8'), '{"control":"stale"}');
  assert.ok(phases.some(phase => phase.name === 'miniflare-metadata-fetch' && phase.wallMs >= 0));
}));

for (const failure of ['network', 'http', 'malformed']) test('metadata ' + failure + ' refuses old cache fallback', () => providerFixture(async ({ root, output }) => {
  const cache = path.join(root, 'node_modules/.mf'); mkdirSync(cache);
  const file = path.join(cache, 'cf.json'); writeFileSync(file, '{"control":"stale"}');
  let calls = 0;
  await assert.rejects(prepareMiniflareMetadata({ root, directory: output }, { fetchMetadata: async () => {
    calls++; if (failure === 'network') throw Error('inert fetch connection failed');
    return new Response(failure === 'malformed' ? 'not JSON' : 'provider failure', { status: failure === 'http' ? 503 : 200 });
  } }));
  assert.equal(calls, 1); assert.equal(readFileSync(file, 'utf8'), '{"control":"stale"}');
}));

test('shared root junction is refused before any metadata request or cache write', async () => {
  const root = scratchDir('shared-runtime-control-'), shared = scratchDir('shared-runtime-target-');
  const link = path.join(root, 'node_modules');
  try {
    symlinkSync(shared, link, process.platform === 'win32' ? 'junction' : 'dir');
    let calls = 0;
    await assert.rejects(prepareMiniflareMetadata({ root, directory: root }, { fetchMetadata: async () => { calls++; throw Error('must not fetch'); } }), /ordinary owned directory/);
    assert.equal(calls, 0); assert.equal(existsSync(path.join(shared, '.mf')), false);
  } finally { unlinkDirectoryLink(link, shared); removeScratchDir(root); removeScratchDir(shared); }
});

for (const name of ['link', 'link with spaces']) test('directory-link cleanup accepts portable path spelling: ' + name, () => {
  const root = scratchDir('directory-link-spelling-'), target = path.join(root, 'source'), link = path.join(root, name);
  mkdirSync(target); writeFileSync(path.join(target, 'retained.txt'), 'shared bytes must remain');
  symlinkSync(target, link, process.platform === 'win32' ? 'junction' : 'dir');
  try {
    unlinkDirectoryLink(link.replaceAll('\\', '/'), target.replaceAll('\\', '/'));
    assert.equal(existsSync(link), false);
    assert.equal(readFileSync(path.join(target, 'retained.txt'), 'utf8'), 'shared bytes must remain');
  } finally {
    if (existsSync(link)) unlinkDirectoryLink(link, target);
    removeScratchDir(root);
  }
});

test('timing receipts retain independent durations, overlap labels and the three slowest measured phases', () => providerFixture(({ output }) => {
  const timing = createGateTimingRecorder();
  timing.record({ name: 'preflight', kind: 'container', wallMs: 99 });
  for (const [name, wallMs] of [['setup', 3], ['build', 9], ['node', 5], ['vitest', 7]]) timing.record({ name, kind: 'leaf', wallMs, overlapGroup: ['node', 'vitest'].includes(name) ? 'test-runners' : null });
  const result = writeGateResult({ directory: output, result: { pass: true }, timing });
  const receipt = JSON.parse(readFileSync(result.timings, 'utf8'));
  assert.deepEqual(receipt.threeSlowestPhases.map(phase => phase.name), ['build', 'vitest', 'node']);
  assert.ok(receipt.phases.some(phase => phase.name === 'gate-result-report-writing' && phase.wallMs >= 0));
}));

test('actual Node reports retain execution and independently measured report-writing durations without changing verdicts', async () => {
  const root = scratchDir('node-duration-control-');
  try {
    writeFileSync(path.join(root, 'owned.test.mjs'), 'import test from "node:test";import assert from "node:assert/strict";test("real assertion",()=>assert.equal(2+2,4));');
    writeFileSync(path.join(root, 'files.json'), JSON.stringify(['owned.test.mjs']));
    const env = { ...process.env }; delete env.NODE_TEST_CONTEXT;
    const child = spawnSync(process.execPath, [path.join(repo, 'tools/run-node-tests.mjs'), '--root', root,
      '--files-json', path.join(root, 'files.json'), '--report', path.join(root, 'report.json')],
      { cwd: root, env, windowsHide: true, encoding: 'utf8', maxBuffer: Infinity });
    assert.equal(child.status, 0, child.stderr);
    const result = JSON.parse(child.stdout);
    assert.equal(result.pass, true); assert.equal(result.filesExecuted, 1);
    for (const name of ['node-event-stream', 'node-event-report-writing', 'node-result-report-writing']) {
      assert.ok(result.timings.some(phase => phase.name === name && Number.isFinite(phase.wallMs) && phase.wallMs >= 0));
    }
    assert.equal(JSON.parse(readFileSync(path.join(root, 'report.json'), 'utf8')).pass, true);
  } finally { removeScratchDir(root); }
});

