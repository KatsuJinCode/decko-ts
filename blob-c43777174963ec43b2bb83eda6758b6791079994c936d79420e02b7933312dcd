function commandControl(prepare) {
  const root = path.resolve('.'), events = [];
  const directories = new Set([root, path.join(root, 'tests'), path.join(root, 'tests/server')]);
  const entries = new Map([[root, ['tests']], [path.join(root, 'tests'), ['server']],
    [path.join(root, 'tests/server'), ['owned.test.ts', 'owned.test.mjs']]]);
  return { events, load: () => loadCandidate({
    process: { execPath: process.execPath, pid: 818,
      argv: ['node', 'inert-control.mjs', 'run', 'full', '--folder', 'tests/server'], env: {},
      exit(code) { throw Error('control-exit:' + code); } },
    readdirSync(directory) { return (entries.get(path.resolve(directory)) ?? []).map(name => ({ name,
      isDirectory: () => directories.has(path.join(directory, name)) })); },
    writeFileSync() {}, writeGateInventory() {},
    prepareGateInputs: () => prepare(events),
    spawn() {
      events.push('vitest:start');
      const child = new EventEmitter();
      queueMicrotask(() => child.emit('close', 0, null));
      return child;
    },
    runNodeTests() { events.push('node:start'); return Promise.resolve({ pass: true, filesExecuted: 1 }); },
  }) };
}

test('the actual CLI waits for required project inputs before launching a framework', async () => {
  const fixture = commandControl(async events => {
    events.push('prepare:start'); await Promise.resolve(); events.push('prepare:done');
  });
  const api = await fixture.load(); await api.command();
  assert.deepEqual(fixture.events, ['prepare:start', 'prepare:done', 'vitest:start', 'node:start']);
});

test('named folders retain gate classification and every private/full exclusion', () => {
  const files = ['tests/card/rules/public.test.ts', 'tests/card/rules/legacy-self-rule.test.ts', 'tools/public.test.mjs'];
  assert.deepEqual(selectGateInventory(files, 'full').selected, selectTestFiles(files, 'full'));
  const selection = selectGateInventory(files, 'full', ['tests/card/rules']);
  assert.deepEqual(selection.selected, [files[0]]);
  assert.equal(selection.excluded[0].file, files[1]);
  assert.equal(selection.excluded[0].gate, 'corpus');
  assert.ok(selection.excluded[0].reason);
  assert.throws(() => selectGateInventory(files, 'full', ['tests/absent']), /Unknown or empty/);
  assert.throws(() => selectGateInventory([files[1]], 'full', ['tests/card/rules']), /selects no files/);
  assert.deepEqual(selectGateInventory(files, 'full', ['tests/card', 'tests/card/rules']).selected, [files[0]]);
});

test('folder grammar rejects missing, duplicate and escaping selections without changing runner flags', () => {
  for (const args of [['--folder'], ['--folder='], ['--folder', '..'], ['--folder', '/tests'], ['--folder', 'tests/../tools'], ['--folders', 'tests']]) {
    assert.throws(() => parseGateArguments(args));
  }
  assert.throws(() => parseGateArguments(['--folder', 'tests/server', '--folder=tests/server']), /Repeated/);
  assert.deepEqual(parseGateArguments(['--folder', 'tests\\server\\', '--reporter=json', '--outputFile', 'owned.json']),
    { folders: ['tests/server'], extra: ['--reporter=json', '--outputFile', 'owned.json'] });
});

const repo = fileURLToPath(new URL('..', import.meta.url));
async function providerFixture(body) {
  const root = scratchDir('project-preflight-control-');
  const output = path.join(root, 'out');
  const gemsDir = oracleGemSourceDirectory();
  assert.ok(gemsDir, 'existing pinned public source is required; never fabricate an asset provider');
  mkdirSync(output);
  mkdirSync(path.join(root, 'tools'));
  mkdirSync(path.join(root, 'reference-harness/oracle/app'), { recursive: true });
  mkdirSync(path.join(root, '.runtime'));
  mkdirSync(path.join(root, 'node_modules'));
  copyFileSync(path.join(repo, 'tools/setup-oracle-mod-public.mjs'), path.join(root, 'tools/setup-oracle-mod-public.mjs'));
  copyFileSync(path.join(repo, 'reference-harness/oracle/app/Gemfile.lock'), path.join(root, 'reference-harness/oracle/app/Gemfile.lock'));
  const provider = path.join(output, 'project-preflight/mod-public');
  const prepared = { provider, gemsDir: path.resolve(gemsDir) };
  try { return await body({ root, output, gemsDir, provider, prepared }); }
  finally { cleanupGateInputs(prepared); removeScratchDir(root); }
}

function realSetup({ root, args, env }) {
  const result = spawnSync(process.execPath, args, { cwd: root, env, windowsHide: true, maxBuffer: Infinity });
  return { status: result.status, signal: result.signal, error: result.error ?? null, stdout: result.stdout, stderr: result.stderr };
}

