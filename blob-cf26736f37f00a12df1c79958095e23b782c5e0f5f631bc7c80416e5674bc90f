// Event-driven project cleanup: explicit command or test startup, no schedule.
// All removal authority remains in the existing custody-aware purge.
import {fileURLToPath, pathToFileURL} from 'node:url';
import {resolve} from 'node:path';
import {escalateCleanupFailure} from './cleanup-flightdeck-platform.mjs';

const repoRoot = fileURLToPath(new URL('..', import.meta.url));
async function nativePurge() {
  await import('../tests/support/typescript-source-loader.mjs');
  const {purgeStaleVitestTempDetailed} = await import('../tests/support/purge-stale-vitest-temp.ts');
  return purgeStaleVitestTempDetailed();
}

export async function cleanupProjectTestScratch({purge = nativePurge,
  escalate = error => escalateCleanupFailure(error, repoRoot)} = {}) {
  try {
    const report = await purge();
    const uncertain = report.retained.filter(entry => entry.cause !== undefined);
    if (uncertain.length) throw Object.assign(new AggregateError(uncertain.map(entry => entry.cause),
      'Project scratch cleanup retained unreadable ownership or metadata'), {report});
    return report;
  }
  catch (error) {
    try {await escalate(error);}
    catch (reportingError) {throw new AggregateError([error, reportingError], 'Project cleanup failed and Flightdeck escalation failed');}
    throw error;
  }
}

if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
  try {console.log(JSON.stringify(await cleanupProjectTestScratch(), null, 2));}
  catch (error) {console.error(error); process.exitCode = 1;}
}
