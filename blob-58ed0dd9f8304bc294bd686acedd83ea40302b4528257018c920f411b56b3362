  "sources": {
    "hardRedirect": [
      {
        "line": 40,
        "text": "    def hard_redirect url, status=302"
      },
      {
        "line": 41,
        "text": "      url = card_url url # make sure we have absolute url"
      },
      {
        "line": 42,
        "text": "      if Card::Env.ajax?"
      },
      {
        "line": 43,
        "text": "        # lets client reset window location"
      },
      {
        "line": 44,
        "text": "        # (not just receive redirected response)"
      },
      {
        "line": 45,
        "text": "        # formerly used 303 response, but that gave IE the fits"
      },
      {
        "line": 46,
        "text": "        render json: { redirect: url }"
      },
      {
        "line": 47,
        "text": "      else"
      },
      {
        "line": 48,
        "text": "        redirect_to url, status: status"
      },
      {
        "line": 49,
        "text": "      end"
      },
      {
        "line": 50,
        "text": "    end"
      }
    ],
    "pinnedCardUrl": [
      {
        "line": 6,
        "text": "      def card_path rel_path"
      },
      {
        "line": 7,
        "text": "        unless rel_path.is_a? String"
      },
      {
        "line": 8,
        "text": "          Rails.logger.warn \"Pass only strings to card_path. \" \\"
      },
      {
        "line": 9,
        "text": "                            \"(#{rel_path} = #{rel_path.class})\""
      },
      {
        "line": 10,
        "text": "        end"
      },
      {
        "line": 11,
        "text": "        if rel_path.match? %r{^(https?:)?/}"
      },
      {
        "line": 12,
        "text": "          rel_path"
      },
      {
        "line": 13,
        "text": "        else"
      },
      {
        "line": 14,
        "text": "          \"#{relative_url_root}/#{rel_path}\""
      },
      {
        "line": 15,
        "text": "        end"
      },
      {
        "line": 16,
        "text": "      end"
      },
      {
        "line": 17,
        "text": ""
      },
      {
        "line": 18,
        "text": "      # card_url     makes it a full url (if not already)"
      },
      {
        "line": 19,
        "text": "      def card_url rel"
      },
      {
        "line": 20,
        "text": "        rel.match?(/^https?:/) ? rel : \"#{Env.origin}#{card_path rel}\""
      },
      {
        "line": 21,
        "text": "      end"
      }
    ],
    "redirectCudSuccess": [
      {
