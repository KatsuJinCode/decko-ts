        "text": "    def redirect_cud_success success"
      },
      {
        "line": 26,
        "text": "      redirect_type = success.redirect || default_cud_success_redirect_type"
      },
      {
        "line": 27,
        "text": "      if redirect_type.to_s == \"soft\""
      },
      {
