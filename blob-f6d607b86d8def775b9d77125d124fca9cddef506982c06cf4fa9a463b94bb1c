import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {spawnSync} from 'node:child_process';
import {fileURLToPath} from 'node:url';
import {inspectLocalD1TempRoot, createOwnedLocalMatrixTempRoot} from '../../tools/runtime-db-matrix/local-storage-platform.mjs';

test('rejects the actual long Windows matrix profile before starting native D1', () => {
  const root = 'C:/localProjects/decko-ts-codex-area5-20261031/.runtime/backend-matrix-native-evidence/complete-inputs-v4/d1/scratch';
  assert.throws(() => inspectLocalD1TempRoot(root, 'win32'), error =>
    error.name === 'LocalD1StoragePathError' && error.databasePath.length >= 260 &&
    error.message.includes('SQL and test cases must remain unchanged'));
});

test('accepts a short owned Windows profile including the longest journal name', () => {
  const profile = inspectLocalD1TempRoot('C:/localProjects/decko-ts-codex-area5-20261031/.runtime/matrix-temp/decko-matrix-AbCd12', 'win32');
  assert(profile.databasePathCharacters < 260);
  assert(profile.databasePath.endsWith('.sqlite-journal'));
});

test('Linux retains its native path behavior and unknown platforms fail explicitly', () => {
  const root = `/owned/${'long/'.repeat(60)}`;
  assert.equal(inspectLocalD1TempRoot(root, 'linux').platform, 'linux');
  assert.throws(() => inspectLocalD1TempRoot('/owned', 'unqualified-platform'), {name:'UnsupportedLocalMatrixPlatformError'});
});

test('unsafe native parent is refused without creating an owned directory', {skip:process.platform !== 'win32'}, () => {
  const parent = path.resolve('.runtime/backend-matrix-native-evidence/complete-inputs-v4/d1/scratch');
  assert.equal(fs.existsSync(parent), false);
  assert.throws(() => createOwnedLocalMatrixTempRoot(parent), {name:'LocalD1StoragePathError'});
  assert.equal(fs.existsSync(parent), false);
});

test('the finite verifier refuses output inside its read-only source before touching it', () => {
  const source=fileURLToPath(new URL('../..',import.meta.url));
  const runner=fileURLToPath(new URL('../../docs/reports/issue207-controls/matrix-run.mjs',import.meta.url));
  const result=spawnSync(process.execPath,[runner,source,path.join(source,'docs'),path.join(source,'tmp')],{windowsHide:true,encoding:'utf8'});
  assert.notEqual(result.status,0);
  assert.match(result.stderr,/must remain outside the read-only source checkout/);
});
