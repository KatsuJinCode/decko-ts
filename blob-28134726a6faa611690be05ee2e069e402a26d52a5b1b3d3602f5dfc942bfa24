# Execute the actual TS-exported pod through the original Ruby import/export
# scripts, under the same private application bootstrap as the first capture.
require "json"
require "base64"
require "fileutils"
require "open3"
require "digest"
base, pod, bootstrap, eat, sow, app = ARGV
work = File.join(File.dirname(__FILE__), "ts-trip-work")
FileUtils.mkdir_p(work)
%w[cache files public tmp uploads].each { |name| FileUtils.mkdir_p(File.join(work, name)) }
deck = File.join(work, "target.sqlite3")
FileUtils.cp(base, deck)
env = {
  "RAILS_ENV" => "development", "DISABLE_SPRING" => "1",
  "BUNDLE_GEMFILE" => File.join(app, "Gemfile"), "BUNDLE_PATH" => ENV.fetch("DECKO_ORACLE_BUNDLE_PATH"),
  "PUBLIC_ORACLE_APP" => app, "PUBLIC_ORACLE_WORK" => work,
  "DECKO_CACHE_DIR" => File.join(work, "cache"), "DECKO_FILES_DIR" => File.join(work, "files"),
  "PERSIST_FILES_DIR" => File.join(work, "uploads"), "DATABASE_URL" => "sqlite3:#{deck}",
  "RUBY_THREAD_VM_STACK_SIZE" => "67108864", "RUBY_THREAD_MACHINE_STACK_SIZE" => "268435456"
}
receipts = []
[[eat, pod, File.join(work, "ts-to-ruby.eat.json")],
 [sow, File.join(work, "ts-to-ruby.yml"), "{}"]].each do |script, *args|
  stdout, stderr, status = Open3.capture3(env, "ruby", bootstrap, script, *args, chdir: app)
  receipts << { script: File.basename(script), status: status.exitstatus, stdout: stdout, stderr: stderr }
  abort JSON.generate(receipts) unless status.success?
end
runtime_sources = {}
[File.join(app, "Gemfile.lock"), File.join(app, "config/application.rb"), File.join(app, "config/environment.rb")].each do |file|
  runtime_sources[file] = Digest::SHA256.file(file).hexdigest
end
puts JSON.generate({ receipts: receipts, runtime_sources: runtime_sources,
  files: %w[ts-to-ruby.eat.json ts-to-ruby.yml].to_h { |name| [name, Base64.strict_encode64(File.binread(File.join(work, name)))] } })
