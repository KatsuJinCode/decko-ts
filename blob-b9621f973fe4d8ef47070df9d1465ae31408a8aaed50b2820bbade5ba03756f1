import { expect, it } from "vitest";
import { readFileSync } from "node:fs";
import { BunnyDbDriver } from "../../../src/card/drivers/bunny-db.js";
import { FetchEngine } from "../../../src/card/fetch.js";
import { CardActionEngine } from "../../../src/card/actions/card-action-engine.js";
import type { AttachmentStore, AttachmentStoreInput } from "../../../src/card/attachments/attachment-store.js";
import { startMockHranaServer } from "../../server/drivers/mock-hrana-server.js";
import { splitSqlStatements } from "../fetch/fetch-test-storage.js";
import { seedStandardDeck, seedCard, CARDTYPE_ID, JOE, fakeClock, type ActionsTestStorage } from "./actions-test-storage.js";

it("does not delete uploaded bytes referenced by a committed card after the COMMIT reply is lost", async () => {
  const server = await startMockHranaServer();
  try {
    let lostReply = false;
    const faultFetch: typeof fetch = async (url, options) => {
      const response = await fetch(url, options);
      if (!lostReply && String(options?.body).includes('"sql":"COMMIT"')) {
        lostReply = true;
        await response.arrayBuffer();
        throw new TypeError("injected reset after upload commit");
      }
      return response;
    };
    const driver = new BunnyDbDriver({ url: server.url, fetchImpl: faultFetch, retries: 0 });
    for (const sql of splitSqlStatements(readFileSync("db/schema.sqlite.sql", "utf8"))) await driver.query(sql, []);
    const fetcher = new FetchEngine(driver);
    const nullable = (params: unknown[]) => params.map(value => value === undefined ? null : value);
    const seedDriver = {
      query: <T,>(sql: string, params: unknown[]) => driver.query<T>(sql, nullable(params)),
      batch: (statements: { sql: string; params: unknown[] }[]) => driver.batch(statements.map(s => ({ ...s, params: nullable(s.params) }))),
    };
    const storage: ActionsTestStorage = {
      driver: seedDriver, engine: fetcher, close() {},
      selectAll: async <T,>(sql: string, params: unknown[] = []) => (await seedDriver.query<T>(sql, params)).rows,
      selectOne: async <T,>(sql: string, params: unknown[] = []) => (await seedDriver.query<T>(sql, params)).rows[0],
      count: async table => Number((await driver.query<{ n: number }>(`SELECT COUNT(*) AS n FROM ${table}`, [])).rows[0].n),
    };
    await seedStandardDeck(storage);
    await seedCard(storage, { id: 400, name: "File", codename: "file", typeId: CARDTYPE_ID });
    const files = new Map<string, Uint8Array>();
    const key = (input: AttachmentStoreInput) => `~${input.cardId}/${input.actionId}${input.ext}`;
    const store: AttachmentStore = {
      async store(input) { files.set(key(input), input.bytes); return { identifier: key(input), size: input.bytes.length }; },
      async read() { return undefined; },
      async discard(input) { files.delete(key(input)); },
    };
    const engine = new CardActionEngine(fetcher, { actor: JOE, now: fakeClock(), ipAddress: "192.0.2.7", attachmentStore: store });
    await expect(engine.createCard({ name: "Operations Upload", typeId: 400, attachment: { bytes: new TextEncoder().encode("fixture upload"), originalFilename: "fixture.txt" } })).rejects.toThrow(/reset/);
    expect(lostReply).toBe(true);
    const cards = await driver.query<{ db_content: string }>("SELECT db_content FROM cards WHERE name = ?", ["Operations Upload"]);
    expect(cards.rows).toHaveLength(1);
    const identifier = cards.rows[0].db_content;
    expect(identifier).toMatch(/^~/);
    expect(files.has(identifier), "database committed an attachment pointer, so those bytes must survive").toBe(true);
  } finally { await server.close(); }
});
