  "sources": {
    "route": [
      {
        "line": 35,
        "text": "  # RESTful (with mark)"
      },
      {
        "line": 36,
        "text": "  match \":mark(.:format)\" => \"card#create\", via: :post"
      },
      {
        "line": 37,
        "text": "  match \":mark(.:format)\" => \"card#update\", via: %i[put patch]"
      },
      {
        "line": 38,
        "text": "  match \":mark(.:format)\" => \"card#delete\", via: :delete"
      }
    ],
    "update": [
      {
        "line": 14,
        "text": "    def update"
      },
      {
        "line": 15,
        "text": "      card.new_card? ? create : handle { card.update! params[:card]&.to_unsafe_h }"
      },
      {
        "line": 16,
        "text": "    end"
      }
    ],
    "uriFetch": [
      {
        "line": 104,
        "text": "      def uri_fetch params"
      },
      {
        "line": 105,
        "text": "        card_opts = uri_fetch_opts params"
      },
      {
        "line": 106,
        "text": "        if params[:action] == \"create\""
      },
      {
        "line": 107,
        "text": "          # FIXME: we currently need a \"new\" card to catch duplicates"
      },
      {
        "line": 108,
        "text": "          # (otherwise save will just act like a normal update)"
      },
      {
        "line": 109,
        "text": "          # We may need a \"#create\" instance method to handle this checking?"
      },
      {
        "line": 110,
        "text": "          Card.new card_opts"
      },
      {
        "line": 111,
        "text": "        else"
      },
      {
        "line": 112,
        "text": "          standard_uri_fetch params, card_opts"
      },
      {
        "line": 113,
        "text": "        end"
      },
      {
        "line": 114,
        "text": "      end"
      },
      {
        "line": 115,
        "text": ""
      }
    ],
    "standardUriFetch": [
      {
        "line": 118,
        "text": "      def standard_uri_fetch params, card_opts"
      },
      {
        "line": 119,
        "text": "        mark = params[:mark] || card_opts[:name]"
      },
      {
        "line": 120,
        "text": "        card = fetch mark, new: card_opts,"
      },
      {
        "line": 121,
        "text": "                           skip_modules: true,"
      },
      {
        "line": 122,
        "text": "                           look_in_trash: params[:look_in_trash]"
      },
      {
        "line": 123,
        "text": "        card.assign_attributes card_opts if params[:assign] && card&.real?"
      },
      {
        "line": 124,
        "text": "        card&.include_set_modules"
      },
      {
        "line": 125,
        "text": "        card"
      },
      {
        "line": 126,
        "text": "      end"
      }
    ],
    "uriFetchOpts": [
      {
        "line": 128,
        "text": "      def uri_fetch_opts params"
      },
      {
        "line": 129,
        "text": "        Env.hash(params[:card]).tap do |opts|"
      },
      {
        "line": 130,
        "text": "          opts[:type] ||= params[:type] if params[:type] # for /new/:type shortcut."
      },
      {
        "line": 131,
        "text": "          opts[:name] ||= Name[params[:mark]]&.tr \"_\", \" \""
      },
      {
        "line": 132,
        "text": "        end"
      },
      {
        "line": 133,
        "text": "      end"
      }
    ],
    "beforeActions": [
      {
        "line": 20,
        "text": "  before_action :setup, except: [:asset]"
      },
      {
        "line": 21,
        "text": "  before_action :authenticate, except: [:asset]"
      },
      {
        "line": 22,
        "text": "  before_action :load_mark, only: [:read]"
      },
      {
        "line": 23,
        "text": "  before_action :load_card, except: [:asset]"
      },
      {
        "line": 24,
        "text": "  before_action :load_action, only: [:read]"
      },
      {
        "line": 25,
        "text": "  before_action :refresh_card, only: %i[create update delete]"
      }
    ],
    "pinnedVerbMatcher": [
      {
        "line": 14,
        "text": "      module VerbMatchers"
      },
      {
        "line": 15,
        "text": "        VERBS = %w{ DELETE GET HEAD OPTIONS LINK PATCH POST PUT TRACE UNLINK }"
      },
      {
        "line": 16,
        "text": "        VERBS.each do |v|"
      },
      {
        "line": 17,
        "text": "          class_eval <<-eoc, __FILE__, __LINE__ + 1"
      },
      {
        "line": 18,
        "text": "            # frozen_string_literal: true"
      },
      {
        "line": 19,
        "text": "            class #{v}"
      },
      {
        "line": 20,
        "text": "              def self.verb; name.split(\"::\").last; end"
      },
      {
        "line": 21,
        "text": "              def self.call(req); req.#{v.downcase}?; end"
      },
      {
        "line": 22,
        "text": "            end"
      },
      {
        "line": 23,
        "text": "          eoc"
      },
      {
        "line": 24,
        "text": "        end"
      },
      {
        "line": 183,
        "text": "        def match_verb(request)"
      },
      {
        "line": 184,
        "text": "          @request_method_match.any? { |m| m.call request }"
      },
      {
        "line": 185,
        "text": "        end"
      }
    ],
    "pinnedViaToRequestMethod": [
      {
        "line": 207,
        "text": "        def request_method"
      },
      {
        "line": 208,
        "text": "          @via.map { |x| Journey::Route.verb_matcher(x) }"
      },
      {
        "line": 209,
        "text": "        end"
      }
    ]
  }
}
