      },
      {
        "line": 12,
        "text": "    end"
      },
      {
        "line": 13,
        "text": ""
      },
      {
        "line": 14,
        "text": "    def update"
      },
      {
        "line": 15,
        "text": "      card.new_card? ? create : handle { card.update! params[:card]&.to_unsafe_h }"
      },
      {
        "line": 16,
        "text": "    end"
      },
      {
        "line": 17,
        "text": ""
      },
      {
        "line": 18,
        "text": "    def delete"
      },
