    },
    {
      "line": 3,
      "text": "Decko::Engine.routes.draw do"
    },
    {
      "line": 4,
      "text": "  files = Decko::Engine.config.files_web_path"
    },
    {
      "line": 5,
      "text": "  file_matchers = { mark: /[^-]+/, explicit_file: true, rev_id: /[^-]+/ }"
    },
    {
      "line": 6,
      "text": ""
    },
    {
      "line": 7,
      "text": "  root \"card#read\""
    },
    {
      "line": 8,
      "text": ""
    },
    {
      "line": 9,
      "text": "  # explicit file request"
    },
    {
      "line": 10,
      "text": "  get({ \"#{files}/:mark/:rev_id(-:size).:format\" => \"card#read\" }.merge(file_matchers))"
    },
    {
      "line": 11,
      "text": ""
    },
    {
      "line": 12,
      "text": "  # DEPRECATED (old file and asset requests)"
    },
    {
      "line": 13,
      "text": "  get({ \"#{files}/:mark(-:size)-:rev_id.:format\" => \"card#read\" }.merge(file_matchers))"
    },
    {
      "line": 14,
      "text": "  %w[assets javascripts jasmine].each do |prefix|"
    },
    {
      "line": 15,
      "text": "    get \"#{prefix}/*mark\" => \"card#asset\""
    },
    {
      "line": 16,
      "text": "  end"
    },
    {
      "line": 17,
      "text": ""
    },
    {
      "line": 18,
      "text": "  # Standard GET requests"
    },
    {
      "line": 19,
      "text": "  get \"/:mark(.:format)\" => \"card#read\"  # /decko is deprecated"
    },
    {
      "line": 20,
      "text": ""
    },
    {
      "line": 21,
      "text": "  # Alternate GET requests"
    },
    {
      "line": 22,
      "text": "  get \"new/:type\" => \"card#read\", view: \"new\" # common case for card without mark"
    },
    {
      "line": 23,
      "text": "  get \"type/:type\" => \"card#read\""
    },
    {
      "line": 24,
      "text": "  get \":mark/view/:view(.:format)\" => \"card#read\" # simplifies API documentation"
    },
    {
      "line": 25,
      "text": "  get \"card/:view(/:mark(.:format))\" => \"card#read\", view: /new|edit/ # legacy"
    },
    {
      "line": 26,
      "text": ""
    },
    {
      "line": 27,
      "text": "  # RESTful (without mark)"
    },
    {
      "line": 28,
      "text": "  post   \"/\" => \"card#create\""
    },
    {
      "line": 29,
      "text": "  put    \"/\" => \"card#update\""
    },
    {
      "line": 30,
      "text": "  patch  \"/\" => \"card#update\""
    },
    {
      "line": 31,
      "text": "  delete \"/\" => \"card#delete\""
    },
    {
      "line": 32,
      "text": ""
    },
    {
      "line": 33,
      "text": "  post  \"/type/:type\" => \"card#create\""
    },
    {
      "line": 34,
      "text": ""
    },
    {
      "line": 35,
      "text": "  # RESTful (with mark)"
    },
    {
      "line": 36,
      "text": "  match \":mark(.:format)\" => \"card#create\", via: :post"
    },
    {
      "line": 37,
      "text": "  match \":mark(.:format)\" => \"card#update\", via: %i[put patch]"
    },
    {
      "line": 38,
      "text": "  match \":mark(.:format)\" => \"card#delete\", via: :delete"
    },
    {
      "line": 39,
      "text": ""
    },
    {
      "line": 40,
      "text": "  # explicit GET alternatives for transactions"
    },
    {
      "line": 41,
      "text": "  %w[create read update delete asset].each do |action|"
    },
    {
      "line": 42,
      "text": "    get \"(card)/#{action}(/:mark(.:format))\" => \"card\", action: action"
    },
    {
      "line": 43,
      "text": "  end"
    },
    {
      "line": 44,
      "text": ""
    },
    {
      "line": 45,
      "text": "  # for super-explicit over-achievers"
    },
    {
      "line": 46,
      "text": "  match \"(card)/create(/:mark(.:format))\" => \"card#create\", via: %i[post patch]"
    },
    {
      "line": 47,
      "text": "  match \"(card)/update(/:mark(.:format))\" => \"card#update\", via: %i[post put patch]"
    },
    {
      "line": 48,
      "text": "  match \"(card)/delete(/:mark(.:format))\" => \"card#delete\", via: :delete"
    },
    {
      "line": 49,
      "text": ""
    },
    {
      "line": 50,
      "text": "  # for super-lazy under-achievers"
