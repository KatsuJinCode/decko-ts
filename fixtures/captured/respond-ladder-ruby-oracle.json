        "status": 302
      },
      "sentFile": null,
      "logged": []
    },
    {
      "label": "a 303 status REDIRECTS TOO, and the redirect answers 302 - the 303 is not carried",
      "statusArg": 303,
      "error": null,
      "rendered": null,
      "redirected": {
        "url": "PAGE",
        "status": 302
      },
      "sentFile": null,
      "logged": []
    },
    {
      "label": "a file format at 200 SENDS THE FILE instead of rendering",
      "statusArg": 200,
      "error": null,
      "rendered": null,
      "redirected": null,
      "sentFile": [
        "FILE-PAGE"
      ],
      "logged": []
    },
    {
      "label": "a file format at 302 REDIRECTS: the redirect arm outranks the file arm",
      "statusArg": 302,
      "error": null,
      "rendered": null,
      "redirected": {
        "url": [
          "FILE-PAGE"
        ],
        "status": 302
      },
      "sentFile": null,
      "logged": []
    },
    {
