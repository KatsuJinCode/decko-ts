  "sources": {
    "route": [
      {
        "line": 50,
        "text": "  # for super-lazy under-achievers"
      },
      {
        "line": 51,
        "text": "  get \":mark/:view(.:format)\" => \"card#read\""
      },
      {
        "line": 52,
        "text": ""
      },
      {
        "line": 53,
        "text": "  # Wildcard for bad addresses"
      },
      {
        "line": 54,
        "text": "  get \"*mark\" => \"card#read\", view: \"bad_address\""
      }
    ],
    "mark": [
      {
        "line": 6,
        "text": "    def load_mark"
      },
      {
        "line": 7,
        "text": "      params[:mark] = interpret_mark params[:mark]"
      },
      {
        "line": 8,
        "text": "    end"
      },
      {
        "line": 9,
        "text": ""
      },
      {
        "line": 10,
        "text": "    def interpret_mark mark"
      },
      {
        "line": 11,
        "text": "      case mark"
      },
      {
        "line": 12,
        "text": "      when \"*previous\""
      },
      {
        "line": 13,
        "text": "        # Why support this? It's only needed in Success, right? Deprecate?"
      },
      {
        "line": 14,
        "text": "        hard_redirect Card::Env.previous_location"
      },
      {
        "line": 15,
        "text": "      when nil"
      },
      {
        "line": 16,
        "text": "        implicit_mark"
      },
      {
        "line": 17,
        "text": "      else"
      },
      {
        "line": 18,
        "text": "        explicit_mark mark"
      },
      {
        "line": 19,
        "text": "      end"
      },
      {
        "line": 20,
        "text": "    end"
      },
      {
        "line": 21,
        "text": ""
      },
      {
        "line": 22,
        "text": "    def explicit_mark mark"
      },
      {
        "line": 23,
        "text": "      # we should find the place where we produce these bad urls"
      },
      {
        "line": 24,
        "text": "      # mark.valid_encoding? ? mark : mark.force_encoding(\"ISO-8859-1\").encode(\"UTF-8\")"
      },
      {
        "line": 25,
        "text": "      mark"
      },
      {
        "line": 26,
        "text": "    end"
      }
    ],
    "renderPageAndViewFromParams": [
      {
        "line": 99,
        "text": "    def render_page format, view"
      },
      {
        "line": 100,
        "text": "      view ||= view_from_params"
      },
      {
        "line": 101,
        "text": "      card.act do"
      },
      {
        "line": 102,
        "text": "        format.page self, view, Card::Env.slot_opts"
      },
      {
        "line": 103,
        "text": "      end"
      },
      {
        "line": 104,
        "text": "    end"
      }
    ],
    "viewFromParams": [
      {
        "line": 99,
        "text": "    def render_page format, view"
      },
      {
        "line": 100,
        "text": "      view ||= view_from_params"
      },
      {
        "line": 101,
        "text": "      card.act do"
      },
      {
        "line": 102,
        "text": "        format.page self, view, Card::Env.slot_opts"
      },
      {
        "line": 103,
        "text": "      end"
      },
      {
        "line": 104,
        "text": "    end"
      },
      {
        "line": 105,
        "text": ""
      },
      {
        "line": 106,
        "text": "    def view_from_params"
      },
      {
        "line": 107,
        "text": "      %i[view v].each { |k| return params[k] if params[k].present? }"
      },
      {
        "line": 108,
        "text": "      nil"
      },
      {
        "line": 109,
        "text": "    end"
      }
    ],
    "uriFetch": [
      {
        "line": 104,
        "text": "      def uri_fetch params"
      },
      {
        "line": 105,
        "text": "        card_opts = uri_fetch_opts params"
      },
      {
        "line": 106,
        "text": "        if params[:action] == \"create\""
      },
      {
        "line": 107,
        "text": "          # FIXME: we currently need a \"new\" card to catch duplicates"
      },
      {
        "line": 108,
        "text": "          # (otherwise save will just act like a normal update)"
      },
      {
        "line": 109,
        "text": "          # We may need a \"#create\" instance method to handle this checking?"
      },
      {
        "line": 110,
        "text": "          Card.new card_opts"
      },
      {
        "line": 111,
        "text": "        else"
      },
      {
        "line": 112,
        "text": "          standard_uri_fetch params, card_opts"
      },
      {
        "line": 113,
        "text": "        end"
      },
      {
        "line": 114,
        "text": "      end"
      },
      {
        "line": 115,
        "text": ""
      }
    ],
    "standardUriFetch": [
      {
        "line": 118,
        "text": "      def standard_uri_fetch params, card_opts"
      },
      {
        "line": 119,
        "text": "        mark = params[:mark] || card_opts[:name]"
      },
      {
        "line": 120,
        "text": "        card = fetch mark, new: card_opts,"
      },
      {
        "line": 121,
        "text": "                           skip_modules: true,"
      },
      {
        "line": 122,
        "text": "                           look_in_trash: params[:look_in_trash]"
      },
      {
        "line": 123,
        "text": "        card.assign_attributes card_opts if params[:assign] && card&.real?"
      },
      {
        "line": 124,
        "text": "        card&.include_set_modules"
      },
      {
