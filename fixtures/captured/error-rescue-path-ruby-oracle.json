        "text": ""
      },
      {
        "line": 67,
        "text": "    # error whose message can be shown to any user"
      },
      {
        "line": 68,
        "text": "    class UserError < Error"
      },
      {
        "line": 69,
        "text": "      cattr_accessor :user_error_classes"
      },
      {
        "line": 70,
        "text": "      self.user_error_classes = [self,"
      },
      {
        "line": 71,
        "text": "                                 ActionController::BadRequest,"
      },
      {
        "line": 72,
        "text": "                                 ActionController::MissingFile,"
      },
      {
        "line": 73,
        "text": "                                 ActiveRecord::RecordNotFound,"
      },
      {
        "line": 74,
        "text": "                                 ActiveRecord::RecordInvalid]"
      },
      {
        "line": 75,
        "text": "    end"
      },
      {
        "line": 127,
        "text": "    class << self"
      },
      {
        "line": 128,
        "text": "      KEY_MAP = { permission_denied: PermissionDenied,"
      },
      {
        "line": 129,
        "text": "                  conflict: EditConflict }.freeze"
      },
      {
        "line": 130,
        "text": ""
      },
      {
        "line": 131,
        "text": "      def report exception, card"
      },
      {
        "line": 132,
        "text": "        e = cardify_exception exception, card"
      },
      {
        "line": 133,
        "text": "        self.current = e"
      },
      {
        "line": 134,
        "text": "        e.report"
      },
      {
        "line": 135,
        "text": "        e"
      },
      {
        "line": 136,
        "text": "      end"
      },
      {
        "line": 137,
        "text": ""
      },
      {
        "line": 138,
        "text": "      def rescue_card card"
      },
      {
        "line": 139,
        "text": "        yield"
      },
      {
        "line": 140,
        "text": "      rescue StandardError => e"
      },
      {
        "line": 141,
        "text": "        report e, card"
      },
      {
        "line": 142,
        "text": "      end"
      },
      {
        "line": 143,
        "text": ""
      },
      {
        "line": 144,
        "text": "      private"
      },
      {
        "line": 145,
        "text": ""
      },
      {
        "line": 146,
        "text": "      def cardify_exception exception, card"
      },
      {
        "line": 147,
        "text": "        card_exception ="
      },
      {
        "line": 148,
        "text": "          if exception.is_a? Card::Error"
      },
      {
        "line": 149,
        "text": "            exception"
      },
      {
        "line": 150,
        "text": "          else"
      },
      {
        "line": 151,
        "text": "            card_error_class(exception, card).new exception.message"
      },
      {
        "line": 152,
        "text": "          end"
      },
      {
        "line": 153,
        "text": "        card_exception.card ||= card"
      },
      {
        "line": 154,
        "text": "        card_exception.backtrace ||= exception.backtrace"
      },
      {
        "line": 155,
        "text": "        add_card_errors card, card_exception if card.errors.empty?"
      },
      {
        "line": 156,
        "text": "        card_exception"
      },
      {
        "line": 157,
        "text": "      end"
      },
      {
        "line": 158,
        "text": ""
      },
      {
        "line": 159,
        "text": "      def add_card_errors card, exception"
      },
      {
        "line": 160,
        "text": "        label = exception.class.to_s.split(\"::\").last"
      },
      {
        "line": 161,
        "text": "        card.errors.add label, exception.message"
      },
      {
        "line": 162,
        "text": "      end"
      },
      {
        "line": 163,
        "text": ""
      },
      {
        "line": 164,
        "text": "      def card_error_class exception, card"
      },
      {
        "line": 165,
        "text": "        # \"simple\" error messages are visible to end users and are generally not"
      },
      {
        "line": 166,
        "text": "        # treated as software bugs (though they may be \"shark\" bugs)"
      },
      {
        "line": 167,
        "text": "        case exception"
      },
      {
        "line": 168,
        "text": "        when ActiveRecord::RecordInvalid"
      },
      {
        "line": 169,
        "text": "          invalid_card_error_class card"
      },
      {
        "line": 170,
        "text": "        when ActiveRecord::RecordNotFound, ActionController::MissingFile"
      },
      {
        "line": 171,
        "text": "          Card::Error::NotFound"
      },
      {
        "line": 172,
        "text": "        else"
      },
      {
        "line": 173,
        "text": "          Card::Error::ServerError"
      },
      {
        "line": 174,
        "text": "        end"
      },
      {
        "line": 175,
        "text": "      end"
      },
      {
        "line": 176,
        "text": ""
      },
      {
        "line": 177,
        "text": "      def invalid_card_error_class card"
      },
      {
        "line": 178,
        "text": "        KEY_MAP.each do |key, klass|"
      },
      {
        "line": 179,
        "text": "          return klass if card.errors.key? key"
      },
      {
        "line": 180,
        "text": "        end"
      },
      {
        "line": 181,
        "text": "        Card::Error"
      },
      {
        "line": 182,
        "text": "      end"
      },
      {
        "line": 183,
        "text": "    end"
      }
    ],
