    "false (FalseClass)": false
  },
  "rigArtifacts": [
    "the rig's ControllerHarness is not an instance of the rig's Card, so the pinned soft-redirect guard `return if card.is_a? Card` (response.rb:84) would refuse it; the capture uses a card that IS a Card instance (LatticeCard, a subclass of the rig's Card, carrying the instance surface the pinned soft_redirect, load_action and show touch).",
    "the rig's Card::Env.success answers a SuccessDouble; this capture replaces the singleton with the PINNED env.rb:31-33 body so Success#reload?, #redirect and #to_url are the pinned methods, and Card.id/Card.fetch are recorded nil-answerers (no database). A fetch that finds nothing is the honest answer for this capture, and the lookups are recorded in the fetch list.",
    "the recorded format NAME on the soft branch is the rig's own answer, not the pinned one: the rig's registry holds the format names as STRINGS and the explicit-file test asks with the symbol, so the name resolves to \"file\". The format NAME decision is rows A2/D2's evidence; the flavor and the STATUS are this row's.",
    "success.to_url is not probed here: the pinned code calls it only on the hard branch, and the URL the pinned hard_redirect actually sent is recorded instead (redirected.url, or rendered.json.redirect). The Cardname fetch path behind to_url is the deck's own mark resolution (row A1/B1's surface), not this row's."
  ],
  "sources": {
    "cudSuccess": [
      {
        "line": 79,
        "text": "    # successful create, update, or delete act"
      },
      {
        "line": 80,
        "text": "    def cud_success"
      },
      {
        "line": 81,
        "text": "      success = Card::Env.success.in_context card.name"
      },
      {
        "line": 82,
        "text": "      if success.reload?"
      },
      {
        "line": 83,
        "text": "        reload # instruct JSON to reload"
      },
      {
        "line": 84,
        "text": "      elsif slotter_magic?"
      },
      {
        "line": 85,
        "text": "        slotter_magic_response"
      },
      {
        "line": 86,
        "text": "      else"
      },
      {
        "line": 87,
        "text": "        redirect_cud_success success"
      },
      {
        "line": 88,
        "text": "      end"
      },
      {
        "line": 89,
        "text": "    end"
      }
    ],
    "redirectCudSuccess": [
      {
        "line": 24,
        "text": ""
      },
      {
        "line": 25,
        "text": "    def redirect_cud_success success"
      },
      {
        "line": 26,
        "text": "      redirect_type = success.redirect || default_cud_success_redirect_type"
      },
      {
        "line": 27,
        "text": "      if redirect_type.to_s == \"soft\""
      },
      {
        "line": 28,
        "text": "        success.target ||= self"
      },
      {
        "line": 29,
        "text": "        soft_redirect success"
      },
      {
        "line": 30,
        "text": "      else"
      },
      {
        "line": 31,
        "text": "        hard_redirect success.to_url, 303"
      },
      {
        "line": 32,
        "text": "      end"
      },
      {
        "line": 33,
        "text": "    end"
      },
      {
        "line": 34,
        "text": ""
      },
      {
        "line": 35,
        "text": "    def default_cud_success_redirect_type"
      },
      {
        "line": 36,
        "text": "      Card::Env.ajax? ? \"soft\" : \"hard\""
      },
      {
        "line": 37,
        "text": "    end"
      }
    ],
    "hardRedirect": [
      {
        "line": 39,
        "text": "    # return a redirect response"
      },
      {
        "line": 40,
        "text": "    def hard_redirect url, status=302"
      },
      {
        "line": 41,
        "text": "      url = card_url url # make sure we have absolute url"
      },
      {
        "line": 42,
        "text": "      if Card::Env.ajax?"
      },
      {
        "line": 43,
        "text": "        # lets client reset window location"
      },
      {
        "line": 44,
        "text": "        # (not just receive redirected response)"
      },
      {
        "line": 45,
        "text": "        # formerly used 303 response, but that gave IE the fits"
      },
      {
        "line": 46,
        "text": "        render json: { redirect: url }"
      },
      {
        "line": 47,
        "text": "      else"
      },
      {
        "line": 48,
        "text": "        redirect_to url, status: status"
      },
      {
        "line": 49,
        "text": "      end"
      },
      {
        "line": 50,
        "text": "    end"
      }
    ],
    "successReloadAndRedirect": [
      {
        "line": 37,
        "text": "      def redirect"
      },
      {
        "line": 38,
        "text": "        @redirect.present? ? @redirect : false"
      },
      {
        "line": 39,
        "text": "      end"
      },
      {
        "line": 40,
        "text": ""
      },
      {
        "line": 41,
        "text": "      def reload?"
      },
      {
        "line": 42,
        "text": "        @reload.to_s == \"true\""
      },
      {
        "line": 43,
        "text": "      end"
      }
    ]
