import {readFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {dirname,isAbsolute,relative,resolve} from 'node:path';
import {pathToFileURL} from 'node:url';

export function auditReviewManifest(manifestPath){
 const file=resolve(manifestPath),root=dirname(file),bytes=readFileSync(file),manifest=JSON.parse(bytes);
 if(!Array.isArray(manifest.entries)||!manifest.entries.length)throw Error('Nonempty review manifest required');
 const names=new Set(),failures=[];let matched=0;
 for(const entry of manifest.entries){
  try{
   if(typeof entry.file!=='string'||names.has(entry.file))throw Error('Missing or duplicate manifest path');
   names.add(entry.file);
   const target=resolve(root,entry.file),rel=relative(root,target);
   if(!rel||isAbsolute(rel)||rel==='..'||rel.startsWith('../')||rel.startsWith('..\\'))throw Error('Manifest path escapes evidence root');
   const actual=readFileSync(target),sha256=createHash('sha256').update(actual).digest('hex');
   if(actual.length!==entry.bytes||sha256!==entry.sha256)failures.push({file:entry.file,recordedBytes:entry.bytes,actualBytes:actual.length,recordedSha256:entry.sha256,actualSha256:sha256});
   else matched++;
  }catch(error){failures.push({file:entry.file,error:error.message});}
 }
 return {manifestSha256:createHash('sha256').update(bytes).digest('hex'),entries:manifest.entries.length,matched,failures,pass:failures.length===0};
}
if(process.argv[1]&&import.meta.url===pathToFileURL(resolve(process.argv[1])).href){
 try{if(process.argv.length!==3)throw Error('Supply the review evidence manifest path');const result=auditReviewManifest(process.argv[2]);console.log(JSON.stringify(result,null,2));process.exitCode=result.pass?0:1;}
 catch(error){console.error(error.message);process.exitCode=3;}
}
