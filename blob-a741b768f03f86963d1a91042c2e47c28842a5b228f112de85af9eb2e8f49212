  "sources": {
    "route": [
      {
        "line": 19,
        "text": "  get \"/:mark(.:format)\" => \"card#read\"  # /decko is deprecated"
      }
    ],
    "mark": [
      {
        "line": 10,
        "text": "    def interpret_mark mark"
      },
      {
        "line": 11,
        "text": "      case mark"
      },
      {
        "line": 12,
        "text": "      when \"*previous\""
      },
      {
        "line": 13,
        "text": "        # Why support this? It's only needed in Success, right? Deprecate?"
      },
      {
        "line": 14,
        "text": "        hard_redirect Card::Env.previous_location"
      },
      {
        "line": 15,
        "text": "      when nil"
      },
      {
        "line": 16,
        "text": "        implicit_mark"
      },
      {
        "line": 17,
        "text": "      else"
      },
      {
        "line": 18,
        "text": "        explicit_mark mark"
      },
      {
        "line": 19,
        "text": "      end"
      },
      {
        "line": 20,
        "text": "    end"
      },
      {
        "line": 21,
        "text": ""
      },
      {
        "line": 22,
        "text": "    def explicit_mark mark"
      },
      {
        "line": 23,
        "text": "      # we should find the place where we produce these bad urls"
      },
      {
        "line": 24,
        "text": "      # mark.valid_encoding? ? mark : mark.force_encoding(\"ISO-8859-1\").encode(\"UTF-8\")"
      },
      {
        "line": 25,
        "text": "      mark"
      },
      {
        "line": 26,
        "text": "    end"
      }
    ]
  }
