    "contract": {
      "format": "decko-reference-oracle-contract/1",
      "summary": "What the reference oracle is: stock Ruby Decko at pinned versions, run one request at a time by a runner process instead of a web server. Every way the oracle's process differs from a stock, served deck is listed here with its class. The stock oracle has no entry of class \"patch\". An oracle that changes what Decko does is a patched variant: its expected outputs live in fixtures/<name>/expected-patched/<variant>/, never in expected/, and its manifest lists the patches.",
      "basis": {
        "decko": "0.20.0",
        "card": "1.110.0",
        "lockfile": "oracle/app/Gemfile.lock",
        "gem_source_patches": []
      },
      "classes": {
        "determinism": "pins a value that would otherwise vary between runs; no served-deck behaviour changes",
        "configuration": "a value a deck operator sets in configuration; the fixture states it",
        "request": "makes the runner process behave as one request served through Decko's controller",
        "capture": "records an effect (mail) instead of sending it; what is recorded is what would be sent",
        "platform": "a host-platform workaround with no effect on any recorded byte",
        "fixture": "a fixture data choice, applied as an ordinary card write through Decko's own create path",
        "patch": "changes what Decko does; only allowed in a patched variant"
      },
      "settings": [
        {
          "id": "frozen-clock",
          "class": "determinism",
          "where": "oracle/lib/harness_env.rb freeze_clock!",
          "what": "Time.now and Date.today pinned to deck.json clock (ActiveSupport travel_to) for the whole process"
        },
        {
          "id": "deck-origin",
          "class": "configuration",
          "where": "oracle/lib/harness_env.rb apply_environment!",
          "what": "Cardio.config.deck_origin from deck.json environment.origin"
        },
        {
          "id": "default-html-view",
          "class": "configuration",
          "where": "oracle/lib/harness_env.rb apply_environment!",
          "what": "Cardio.config.default_html_view from deck.json environment.default_html_view"
        },
        {
          "id": "inline-render-errors",
          "class": "request",
          "where": "oracle/lib/harness_env.rb apply_environment!; oracle/adapter.rb with_production_render",
          "what": "Cardio.config.raise_all_rendering_errors = false and Rails.env reporting production while a render runs: a nested view error renders inline without debug detail, as on a served production deck"
        },
        {
          "id": "no-recaptcha",
          "class": "configuration",
          "where": "oracle/lib/harness_env.rb apply_environment!",
          "what": "recaptcha keys unset, so no save calls a verification endpoint"
        },
        {
          "id": "local-file-storage",
          "class": "configuration",
          "where": "oracle/lib/harness_env.rb configure_files!; oracle/app/config/application.rb",
          "what": "uploaded files on local disk under the session's files directory; no cloud buckets"
        },
        {
          "id": "file-cache-per-session",
          "class": "determinism",
          "where": "oracle/app/config/application.rb",
          "what": "the Rails cache store is a per-session directory, so sessions share no state"
        },
        {
          "id": "assets-never-refreshed",
          "class": "determinism",
          "where": "oracle/adapter.rb",
          "what": "Cardio.config.asset_refresh = :never: the deck build compiled the script and style outputs, and a render never rewrites them"
        },
        {
          "id": "mail-captured",
          "class": "capture",
          "where": "oracle/lib/harness_env.rb apply_environment!; oracle/app/config/application.rb",
          "what": "ActionMailer delivery_method :test with deliveries on: mail goes to the in-memory store the adapter reads, never to the network"
        },
        {
          "id": "request-boundary",
          "class": "request",
          "where": "oracle/lib/harness_env.rb begin_request!",
          "what": "before each operation: Card::Env.reset, Card::Cache.renew, mail store cleared, the actor signed in"
        },
        {
          "id": "served-request-notifications",
          "class": "request",
          "where": "oracle/adapter.rb",
          "what": "Card::Set::All::Notify.force_notifications = true: outside a controller Decko silences follower notifications (card-mod-follow set/all/notify.rb silence_notifications?); a served request does not"
        },
        {
          "id": "windows-hard-links",
          "class": "platform",
          "where": "oracle/lib/harness_env.rb configure_files!",
          "what": "on Windows only, File.symlink makes a hard link (symlinks need a privilege there); the public-link step's link kind reaches no recorded byte. Not applied on Linux or in Docker"
        },
        {
          "id": "big-stack-thread",
          "class": "platform",
          "where": "oracle/lib/harness_env.rb on_big_stack",
          "what": "with HARNESS_BIG_STACK=1 each operation runs on a thread with a large stack (compound-name resolution recurses past the main thread's fixed stack on Windows)"
        }
      ],
      "fixture_corrections": [
        {
          "id": "email-stylesheet-type",
          "class": "fixture",
          "fixture": "synthetic-v1",
          "where": "deck.json card \"email stylesheet\" (corpus/generate-deck.mjs)",
          "what": "`decko setup` leaves the \"email stylesheet\" card RichText although the seed data declares SCSS, and every notification email then fails to render, so a fresh stock deck sends no follower mail. The fixture sets the declared type, as an administrator would, through Decko's own update path"
        }
      ],
      "patches": []
    }
  },
