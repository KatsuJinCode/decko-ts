#!/usr/bin/env node
// build-port-schema.mjs — write db/schema.mysql-port.sql, the port's own core
// schema in MySQL dialect.
//
//   node tools/mysql/build-port-schema.mjs
//
// The source is db/schema.mysql-reference.sql: the production MySQL schema of a
// Ruby Decko deck, which is the schema db/schema.sqlite.sql was hand-converted
// from (schema.sqlite.sql:1-30). Deriving the MySQL form from that file, rather
// than hand-writing it, keeps the two dialects of one schema in step: the
// tables, columns, types and Ruby indexes are Ruby's own, verbatim.
//
// What is added beyond the reference is exactly what src/server/same-database.ts
// creates on a Ruby database - the freshness stamp, its triggers, and the three
// serving-path lookup indexes - so loading this file gives the same database a
// MySQL host gets from openSameDatabase. Nothing is derived from SQLite DDL, so
// no indexed TEXT column needs a prefix length here.
//
// Output is written only when it differs, and the file is written with LF line
// endings.
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const root = resolve(dirname(fileURLToPath(import.meta.url)), "../..");
const reference = readFileSync(resolve(root, "db/schema.mysql-reference.sql"), "utf8");

const header = `-- ============================================================================
-- schema.mysql-port.sql — CORE decko schema, MySQL dialect
--
-- GENERATED by tools/mysql/build-port-schema.mjs from
-- db/schema.mysql-reference.sql (the production MySQL schema of a Ruby Decko
-- deck). Do not edit: run the tool instead.
--
-- This is db/schema.sqlite.sql in MySQL dialect. Its tables, columns, types,
-- nullability, defaults and Ruby indexes are Ruby's own, taken verbatim from
-- the reference, so a database created from this file and a database Ruby
-- created differ only in the objects the port adds additively: the freshness
-- stamp, its triggers, and the serving-path lookup indexes below
-- (src/server/same-database.ts).
--
-- Ruby's text columns are varchar(255) or wider, so an index on one carries a
-- full key length and no prefix length is needed. That is why this file has no
-- TEXT columns where the SQLite schema has them, and why the port's SQLite
-- schema cannot be translated to MySQL by rewriting type names alone: a MySQL
-- index on a TEXT column needs an explicit key length.
-- ============================================================================

`;

const creates = [...reference.matchAll(/CREATE TABLE `[^`]+` \([\s\S]*?\) ENGINE=[^;]*;/g)]
  .map((m) => m[0].replace(/ AUTO_INCREMENT=\d+/g, ""))
  .join("\n\n");

const portObjects = `
-- ---------------------------------------------------------------------------
-- The objects the port adds additively to a Ruby MySQL database. The same
-- list, in the same roles, is in src/server/same-database.ts (MYSQL_PORT_OBJECTS)
-- and MYSQL_FUNCTIONAL_INDEX; that function is what a host calls to add them to
-- a database Ruby created, and this section is the same set as DDL.
-- ---------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS deck_data_version (
  id      INT NOT NULL PRIMARY KEY,
  version BIGINT NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_unicode_ci;
INSERT IGNORE INTO deck_data_version (id, version) VALUES (1, 0);

CREATE TRIGGER cards_bump_deck_data_version_ins AFTER INSERT ON cards FOR EACH ROW UPDATE deck_data_version SET version = version + 1 WHERE id = 1;
CREATE TRIGGER cards_bump_deck_data_version_upd AFTER UPDATE ON cards FOR EACH ROW UPDATE deck_data_version SET version = version + 1 WHERE id = 1;
CREATE TRIGGER cards_bump_deck_data_version_del AFTER DELETE ON cards FOR EACH ROW UPDATE deck_data_version SET version = version + 1 WHERE id = 1;
CREATE TRIGGER card_references_bump_deck_data_version_ins AFTER INSERT ON card_references FOR EACH ROW UPDATE deck_data_version SET version = version + 1 WHERE id = 1;
CREATE TRIGGER card_references_bump_deck_data_version_upd AFTER UPDATE ON card_references FOR EACH ROW UPDATE deck_data_version SET version = version + 1 WHERE id = 1;
CREATE TRIGGER card_references_bump_deck_data_version_del AFTER DELETE ON card_references FOR EACH ROW UPDATE deck_data_version SET version = version + 1 WHERE id = 1;

-- Serving-path lookup indexes: non-unique, so they add no constraint a Ruby
-- write could fail. MySQL has no partial indexes, so the SQLite partial index
-- cards_codename_present_index has no counterpart here. The expression index on
-- substr(key, -1) is a functional key part, which needs MySQL 8.0.13 or later;
-- src/server/same-database.ts adds it only where the server supports it.
CREATE INDEX cards_name_trash_index ON cards (name, trash);
CREATE INDEX cards_right_id_trash_index ON cards (right_id, trash);
CREATE INDEX cards_key_last_char_index ON cards ((substr(\`key\`, -1)));

-- The port's session table (Ruby's own sessions table is left alone).
CREATE TABLE IF NOT EXISTS auth_sessions (
  token_hash CHAR(64) NOT NULL PRIMARY KEY,
  account_card_id INT NOT NULL,
  created_at VARCHAR(23) NOT NULL,
  expires_at VARCHAR(23) NOT NULL,
  INDEX index_auth_sessions_on_account_card_id (account_card_id),
  INDEX index_auth_sessions_on_expires_at (expires_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb3 COLLATE=utf8mb3_unicode_ci;
`;

const out = header + creates + "\n" + portObjects;
const target = resolve(root, "db/schema.mysql-port.sql");
let current = "";
try {
  current = readFileSync(target, "utf8");
} catch {
  current = "";
}
if (current === out) {
  console.log(`db/schema.mysql-port.sql is up to date`);
} else {
  writeFileSync(target, out, "utf8");
  console.log(`wrote db/schema.mysql-port.sql (${out.length} bytes)`);
}