import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';import {tmpdir} from 'node:os';import {createRequire} from 'node:module';
import {inspectDeclaredRuntime} from '../../tools/runtime-db-matrix/source-profile.mjs';
const base=fs.mkdtempSync(path.join(tmpdir(),'decko-peer-fallback-'));console.log('Owned executable fallback controls: '+base);let serial=0;
function fixture({optional=false,rootBeta=true,nestedCode=false,rootLocked=true}={}){
 const root=path.join(base,String(++serial)),a='node_modules/alpha',nested=a+'/node_modules/beta',hoisted='node_modules/beta';fs.mkdirSync(root);
 const packages={'':{dependencies:{alpha:'*'}},[a]:{version:'1.0.0',peerDependencies:{beta:'*'},...(optional?{peerDependenciesMeta:{beta:{optional:true}}}:{})},[nested]:{version:'2.0.0'},...(rootLocked?{[hoisted]:{version:'1.0.0'}}:{})};
 fs.writeFileSync(path.join(root,'package-lock.json'),JSON.stringify({packages}));
 function install(key,name,version,code){const dir=path.join(root,key);fs.mkdirSync(dir,{recursive:true});fs.writeFileSync(path.join(dir,'package.json'),JSON.stringify({name,version,...(code?{main:'index.js'}:{types:'index.d.ts'})}));fs.writeFileSync(path.join(dir,code?'index.js':'index.d.ts'),code?'throw Error("synthetic package must never execute");':'export declare const fixture:true;');}
 install(a,'alpha','1.0.0',true);install(nested,'beta','2.0.0',nestedCode);if(rootBeta)install(hoisted,'beta','1.0.0',true);
 return{root,a,nested,hoisted,packages,resolve:()=>createRequire(path.join(root,a,'package.json')).resolve('beta')};
}
test('native fallback package and its own transitive peer are both inventoried',()=>{const f=fixture();f.packages[f.hoisted].peerDependencies={gamma:'*'};f.packages['node_modules/gamma']={version:'1.0.0'};fs.writeFileSync(path.join(f.root,'package-lock.json'),JSON.stringify({packages:f.packages}));const dir=path.join(f.root,'node_modules/gamma');fs.mkdirSync(dir);fs.writeFileSync(path.join(dir,'package.json'),'{"name":"gamma","version":"1.0.0","types":"index.d.ts"}');fs.writeFileSync(path.join(dir,'index.d.ts'),'export declare const gamma:true;');const c=inspectDeclaredRuntime(f.root);assert(c.files.some(p=>p.physicalPath===f.resolve()));assert(c.packages.some(p=>p.name==='gamma'));assert(c.executableResolutions.some(p=>p.name==='beta'&&p.key===f.hoisted));});
test('a pure type-only peer stays qualified and preserves raw native missing-entry evidence',()=>{const f=fixture({rootBeta:false}),c=inspectDeclaredRuntime(f.root);assert(c.packages.some(p=>p.key===f.nested));assert(c.executableResolutions.some(p=>p.name==='beta'&&p.error?.code==='MODULE_NOT_FOUND'));});
test('missing executable fallback candidates are guarded beyond a type-only nearer package',()=>{const f=fixture({rootBeta:false}),c=inspectDeclaredRuntime(f.root);assert(c.resolutionGuards.some(p=>p.path===path.join(f.root,f.hoisted)&&p.present===false));});
test('an optional peer executable fallback is captured just like a required peer fallback',()=>{const f=fixture({optional:true}),c=inspectDeclaredRuntime(f.root);assert(c.files.some(p=>p.physicalPath===f.resolve()));assert(c.packages.some(p=>p.key===f.nested));});
test('an unlocked executable fallback behind locked metadata refuses',()=>{const f=fixture({rootLocked:false});assert.throws(()=>inspectDeclaredRuntime(f.root),/fallback.*immutable lock|shadows locked resolution/i);});
test('a nearer executable package keeps unrelated farther package payloads outside the selected graph',()=>{const f=fixture({nestedCode:true}),c=inspectDeclaredRuntime(f.root);assert(c.packages.some(p=>p.key===f.nested));assert(!c.packages.some(p=>p.key===f.hoisted));});
test('same-byte replacement of the executable fallback changes its physical fingerprint',()=>{const f=fixture(),first=inspectDeclaredRuntime(f.root),file=f.resolve(),bytes=fs.readFileSync(file);fs.renameSync(file,path.join(base,'retained-'+serial));fs.writeFileSync(file,bytes);const second=inspectDeclaredRuntime(f.root);assert.notDeepEqual(second.files,first.files);assert.notDeepEqual(second.executableResolutions,first.executableResolutions);});
test('an executable main outside qualified package directories refuses',()=>{const f=fixture(),dir=path.join(f.root,f.hoisted);fs.writeFileSync(path.join(f.root,'outside.js'),'throw Error("never execute");');fs.writeFileSync(path.join(dir,'package.json'),'{"name":"beta","version":"1.0.0","main":"../../outside.js"}');assert.throws(()=>inspectDeclaredRuntime(f.root),/leaves.*qualified package graph|no matching immutable lock/i);});
