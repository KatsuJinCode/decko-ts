import test from 'node:test';
import assert from 'node:assert/strict';
import {existsSync,mkdirSync,readFileSync,writeFileSync} from 'node:fs';
import {join} from 'node:path';
import {checkpointOptions,checkpointPlan,runCorrectnessCheckpoint} from '../../scripts/correctness-checkpoint.mjs';
import {scratchDir,removeScratchDir} from '../support/scratch-dir.mjs';
import {classify} from '../../tools/test-gates.mjs';

async function fixture(body){
  const root=scratchDir('correctness-checkpoint-');
  try{mkdirSync(join(root,'tests','tools'),{recursive:true});return await body(root);}
  finally{removeScratchDir(root);assert.equal(existsSync(root),false,'checkpoint fixture must leave no files');}
}
const observe=()=>({commit:'a'.repeat(40),status:''});

test('a failed Vitest process cannot give the passing Node stage its aggregate exit',()=>fixture(async root=>{
  const node='tests/tools/owned-node.test.mjs',vitest='tests/tools/owned-vitest.test.ts';
  writeFileSync(join(root,node),'import test from "node:test";test("native Node pass",()=>{});\n');
  writeFileSync(join(root,vitest),'import {it,expect} from "vitest";it("controlled failure",()=>expect(1).toBe(2));\n');
  const out=join(root,'evidence');
  const {receipt,exitCode}=await runCorrectnessCheckpoint({root,out,files:[node,vitest],observe});
  assert.equal(exitCode,1);
  assert.equal(receipt.vitestStage.result,'FAIL');
  assert.equal(receipt.vitestStage.termination.code,1);
  assert.equal(receipt.nodeStage.result,'PASS');
  assert.equal(receipt.nodeStage.termination.code,0);
  assert.deepEqual(receipt.nodeStage.counts,{passed:1,failed:0,skipped:0});
  assert.equal(receipt.nodeStage.sourceUnchanged,true);
  assert.deepEqual(JSON.parse(readFileSync(join(out,'receipt.json'),'utf8')),receipt);
}));

test('one selected Node stage runs and records its own successful process',()=>fixture(async root=>{
  const file='tests/tools/owned-node.test.mjs';
  writeFileSync(join(root,file),'import test from "node:test";test("native Node pass",()=>{});\n');
  const {receipt,exitCode}=await runCorrectnessCheckpoint({root,out:join(root,'evidence'),files:[file],observe});
  assert.equal(exitCode,0);assert.equal(receipt.nodeStage.result,'PASS');
  assert.equal(receipt.nodeStage.termination.code,0);
  assert.equal(receipt.vitestStage.result,'NOT-RUN');
}));

test('missing machine evidence remains incomplete even when the process exits successfully',()=>fixture(async root=>{
  const file='tests/tools/owned-node.test.mjs';
  writeFileSync(join(root,file),'import test from "node:test";');
  const {receipt,exitCode}=await runCorrectnessCheckpoint({root,out:join(root,'evidence'),files:[file],observe,
    execute:async()=>({code:0,signal:null,error:null,stdout:'pass 629',stderr:''})});
  assert.equal(exitCode,1);assert.equal(receipt.nodeStage.result,'INCOMPLETE');
  assert.match(receipt.nodeStage.invalidEvidence,/ENOENT/);
}));

test('the checkpoint requires an explicit correctness inventory and its regression stays in that gate',()=>{
  assert.equal(classify('tests/tools/correctness-checkpoint.test.mjs'),'correctness');
  for(const files of [[],['tests/tools/x.test.mjs','tests/tools/x.test.mjs'],['tools/x.test.mjs'],['tests/tools/../../../outside.test.mjs']])
    assert.throws(()=>checkpointPlan('.',files));
  for(const argv of [[],['--out','x'],['--out','x','--out','y'],['--all','true']])assert.throws(()=>checkpointOptions(argv));
});

test('a tooling test cannot enter correctness through an in-root path alias',()=>fixture(root=>{
  mkdirSync(join(root,'tools'));
  writeFileSync(join(root,'tools','owned-probe.test.mjs'),'import test from "node:test";test("tooling",()=>{});\n');
  const alias='tests/tools/../../tools/owned-probe.test.mjs';
  assert.equal(classify(alias),'correctness','the fixture must exercise prefix-based classification');
  assert.equal(classify('tools/owned-probe.test.mjs'),'harness');
  assert.throws(()=>checkpointPlan(root,[alias]),/Not a correctness test/);
}));

test('admission, planning and measured hashes use the same canonical correctness name',()=>fixture(async root=>{
  const canonical='tests/tools/owned-node.test.mjs',alias='tests/tools/./owned-node.test.mjs';
  writeFileSync(join(root,canonical),'import test from "node:test";test("canonical Node pass",()=>{});\n');
  assert.deepEqual(checkpointPlan(root,[alias]).node,[canonical]);
  assert.throws(()=>checkpointPlan(root,[alias,canonical]),/Duplicate/);
  const {receipt,exitCode}=await runCorrectnessCheckpoint({root,out:join(root,'evidence'),files:[alias],observe});
  assert.equal(exitCode,0);
  assert.deepEqual(receipt.nodeStage.files,[canonical]);
  assert.equal(receipt.nodeStage.sourceBefore[0].file,canonical);
  assert.equal(receipt.nodeStage.sourceAfter[0].file,canonical);
}));
