// sync-migrations.mjs — make the D1 migrations self-contained inside deploy/.
//
// TWO generated files, both "do not edit, edit the generator":
//
//  0001-schema.sql   copied from db/schema.sqlite.sql (the source of truth
//                    for the schema) so `wrangler d1 execute --file
//                    migrations/0001-schema.sql` (and `wrangler d1
//                    migrations apply`) needs nothing outside this directory.
//  0003-demo-seed.sql copied verbatim from db/seed.sql, the 4-card browse-only
//                    demo deck. It ships as a MIGRATION rather than a
//                    `d1 execute` step for one reason: idempotence. Wrangler
//                    records applied migrations in d1_migrations and never
//                    re-runs one, so re-running the deploy cannot collide on
//                    the seed's hand-chosen literal ids 1..4 the way a
//                    re-run of `d1 execute --file db/seed.sql` would.
//                    Deployer who wants an EMPTY database: delete this file
//                    before deploying. It is demo content, not schema.
//
// Transformation for 0001 (the only one, recorded in the generated header):
// - The PRAGMA line is dropped. The schema declares NO foreign keys
//   (verified — no FOREIGN KEY clause anywhere), so the pragma is
//   semantically moot, and D1 does not accept session PRAGMAs through the
//   execute path. Everything else is byte-verbatim.
// 0003 gets NO transformation: every byte of db/seed.sql is carried over.
//
// Run from anywhere: node deploy/sync-migrations.mjs  (paths are resolved
// relative to this file, not the cwd).

import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
import { createHash } from "node:crypto";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const HERE = dirname(fileURLToPath(import.meta.url));
const SOURCE = join(HERE, "..", "db", "schema.sqlite.sql");
const TARGET = join(HERE, "migrations", "0001-schema.sql");
const SEED_SOURCE = join(HERE, "..", "db", "seed.sql");
const SEED_TARGET = join(HERE, "migrations", "0003-demo-seed.sql");

const source = readFileSync(SOURCE, "utf8");
const sourceSha = createHash("sha256").update(source, "utf8").digest("hex");

// Drop PRAGMA statements (whole-line, both the statement and its trailing
// semicolon); keep every other byte including comments.
const body = source
  .split("\n")
  .filter((line) => !/^\s*PRAGMA\b/i.test(line))
  .join("\n")
  .replace(/^\s*;\s*$/gm, "");

const header = [
  "-- ============================================================================ ",
  "-- 0001-schema.sql — GENERATED by deploy/sync-migrations.mjs. Do not edit.",
  "--",
  `-- Source: db/schema.sqlite.sql (sha256 ${sourceSha})`,
  "-- Generated: " + new Date().toISOString(),
  "-- Transformation: PRAGMA statements dropped (the schema declares no",
  "-- foreign keys, so the pragma is moot; D1 rejects session PRAGMAs on the",
  "-- execute path). Every other byte is verbatim from the source file.",
  "-- Re-generate after schema changes:  node deploy/sync-migrations.mjs",
  "-- ============================================================================",
  "",
].join("\n");

mkdirSync(dirname(TARGET), { recursive: true });
writeFileSync(TARGET, header + body.replace(/^\n+/, "") + "\n", "utf8");

const targetSha = createHash("sha256").update(header + body.replace(/^\n+/, "") + "\n", "utf8").digest("hex");
console.log(`sync-migrations: wrote ${TARGET}`);
console.log(`  source sha256: ${sourceSha}`);
console.log(`  target sha256: ${targetSha}`);

// ---------------------------------------------------------------------------
// 0003-demo-seed.sql — the demo deck, carried over byte-for-byte.
// ---------------------------------------------------------------------------

const seedSource = readFileSync(SEED_SOURCE, "utf8");
const seedSourceSha = createHash("sha256").update(seedSource, "utf8").digest("hex");

const seedHeader = [
  "-- ============================================================================ ",
  "-- 0003-demo-seed.sql — GENERATED by deploy/sync-migrations.mjs. Do not edit.",
  "--",
  `-- Source: db/seed.sql (sha256 ${seedSourceSha})`,
  "-- Generated: " + new Date().toISOString(),
  "-- Transformation: NONE. Every byte of db/seed.sql is carried over, so the",
  "-- demo deck has exactly one source of truth.",
  "--",
  "-- WHY A MIGRATION: wrangler records applied migrations in d1_migrations and",
  "-- never re-runs one, so re-running the deploy is a no-op here. A `d1 execute",
  "-- --file db/seed.sql` step would collide on the seed's hand-chosen literal",
  "-- ids 1..4 on the second run. The schema is 0001; this is content.",
  "--",
  "-- SCOPE: this is the 4-card BROWSE-ONLY demo deck (Home, Hello World,",
  "-- About, plus one junction row). worker.ts — the entry the Deploy to",
  "-- Cloudflare button ships, per wrangler.toml `main` — serves exactly this",
  "-- surface: GET /, GET /:name, GET /:name/:view, GET /api/status,",
  "-- GET /api/card/:name. It has no write path. Delete this file before",
  "-- deploying if you want an empty database.",
  "-- Re-generate after seed changes:  node deploy/sync-migrations.mjs",
  "-- ============================================================================",
  "",
].join("\n");

const seedBody = seedSource.replace(/^\n+/, "").replace(/\n*$/, "\n");
const seedOutput = seedHeader + seedBody;

mkdirSync(dirname(SEED_TARGET), { recursive: true });
writeFileSync(SEED_TARGET, seedOutput, "utf8");

const seedTargetSha = createHash("sha256").update(seedOutput, "utf8").digest("hex");
console.log(`sync-migrations: wrote ${SEED_TARGET}`);
console.log(`  source sha256: ${seedSourceSha}`);
console.log(`  target sha256: ${seedTargetSha}`);
