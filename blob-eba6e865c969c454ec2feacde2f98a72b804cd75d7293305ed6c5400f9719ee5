import {afterAll,beforeAll,describe,expect,it} from 'vitest';
import {copyFileSync,mkdtempSync,readFileSync,rmSync} from 'node:fs';
import {tmpdir} from 'node:os';
import {dirname,join,resolve} from 'node:path';
import {fileURLToPath} from 'node:url';
import {startMockHranaServer,type MockHranaServer} from '../server/drivers/mock-hrana-server.js';
import {BunnyDbDriver} from '../../src/card/drivers/bunny-db.js';
import {runAuthMigrations} from '../../src/card/auth/index.js';
import {ensureFreshnessStamp} from '../../src/server/freshness-stamp.js';
import {handleBunnyEngineRequest} from '../../deploy/bunny-worker-src/bunny-edge-engine-handler.js';
import {newSlotId} from '../../src/card/render/slot-html.js';
import {normalizeSlotIds} from '../../src/testing/diff.js';

// The Ruby and Bunny records are the retained actual responses from the
// 2026-11-01 controlled comparison (brandonDojoTech 9a376c614). The fixture
// keeps status, headers, byte counts and base64 bodies only.
const fixturePath = resolve(dirname(fileURLToPath(import.meta.url)), 'fixtures', 'controlled-ruby-bunny-20261101.json');
const fixture = JSON.parse(readFileSync(fixturePath, 'utf8')) as {
  requestHeaders: Record<string, string>;
  cases: Array<{path: string; ruby: {status: number; bodyBytes: number; bodyBase64: string}; bunny: {status: number; bodyBytes: number; bodyBase64: string}}>;
};

const repoRoot = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');
const HOST = 'culturesmith-b-edge.bunny.run';

const caseFor = (path: string) => {
  const found = fixture.cases.find((c) => c.path === path);
  if (found === undefined) throw new Error(`fixture has no case ${path}`);
  return found;
};

let root: string;
let hrana: MockHranaServer;
let driver: BunnyDbDriver;

beforeAll(async () => {
  root = mkdtempSync(join(tmpdir(), 'decko-d765-ruby-bytes-'));
  const db = join(root, 'deck.sqlite3');
  copyFileSync(join(repoRoot, 'reference-harness/fixtures/synthetic-v1/deck/deck.sqlite3'), db);
  hrana = await startMockHranaServer({path: db});
  driver = new BunnyDbDriver({url: hrana.url, authToken: 'owned-test'});
  await runAuthMigrations(driver);
  await ensureFreshnessStamp(driver);
});
afterAll(async () => {
  await hrana?.close();
  if (root) rmSync(root, {recursive: true, force: true});
});

const env = () => ({
  DECKO_DB_URL: hrana.url,
  DECKO_DB_TOKEN: 'owned-test',
  DECKO_EDGE_DECK_PROFILE: 'stock',
  DECKO_ORIGIN: `https://${HOST}`,
  DECKO_DECK_ORIGIN: `https://${HOST}`,
  DECKO_WRITE_PATH: '1',
  DECKO_TOKEN_SECRET: 'owned-fixture-only',
});

async function bareFragment(path: string): Promise<{status: number; body: Buffer}> {
  const request = new Request(`https://${HOST}${path}`, {headers: fixture.requestHeaders});
  const response = await handleBunnyEngineRequest(request, env());
  return {status: response.status, body: Buffer.from(await response.arrayBuffer())};
}

describe('bare XHR title views match the retained Ruby bytes', () => {
  for (const path of ['/Home?view=title', '/Anyone?view=title', '/RichText?view=title']) {
    it(`${path} answers the Ruby status and bytes`, async () => {
      const ruby = caseFor(path).ruby;
      const bunny = await bareFragment(path);
      expect(bunny.status).toBe(ruby.status);
      expect(bunny.body.toString('base64')).toBe(ruby.bodyBase64);
      expect(bunny.body.length).toBe(ruby.bodyBytes);
    }, 120000);
  }
});

describe('generated slot ids follow the Ruby wrap.rb shape', () => {
  it('the engine mints 20 lowercase hex characters, as SecureRandom.hex(10) does in Ruby', () => {
    for (let i = 0; i < 20; i += 1) expect(newSlotId()).toMatch(/^[0-9a-f]{20}$/);
  });

  it('the retained Ruby and Bunny core bodies differ only in slot ids and the trailing line ending', () => {
    const core = caseFor('/Home?view=core');
    const ruby = Buffer.from(core.ruby.bodyBase64, 'base64').toString('utf8');
    const bunny = Buffer.from(core.bunny.bodyBase64, 'base64').toString('utf8');
    const rubySlotIds = [...ruby.matchAll(/data-slot-id="([0-9a-f]+)"/g)].map((m) => m[1]);
    const bunnySlotIds = [...bunny.matchAll(/data-slot-id="([0-9a-f]+)"/g)].map((m) => m[1]);
    // The retained core view carries one generated slot id per engine.
    expect(rubySlotIds.length).toBe(1);
    expect(bunnySlotIds.length).toBe(1);
    for (const id of [...rubySlotIds, ...bunnySlotIds]) expect(id).toMatch(/^[0-9a-f]{20}$/);
    expect(rubySlotIds[0]).not.toBe(bunnySlotIds[0]);
    // Ruby mints a fresh id per slot in each process, so the ids differ between
    // engines by construction. Masking them leaves the bodies equal except for
    // the one line ending that Bunny appends to a fragment.
    expect(normalizeSlotIds(bunny)).toBe(normalizeSlotIds(ruby) + '\n');
  });
});
