import { afterAll, beforeAll, expect, it } from "vitest";
import Database from "better-sqlite3";
import { PostgresDriver } from "../../../src/server/drivers/postgres.js";
import { sqliteToMysql } from "../../../src/server/drivers/mysql.js";
import { signinScopes, SIGNIN_THROTTLE_DDL } from "../../../src/card/auth/signin-security.js";
import { freshPglite } from "../../support/fresh-pglite.js";

let pg: PostgresDriver;
beforeAll(async () => { pg = new PostgresDriver({ client: await freshPglite() }); });
afterAll(async () => { await pg?.close(); });
const forms = [
  ["case equality", "n = CASE WHEN n = 1 THEN n + 4 ELSE n + 1 END"],
  ["returning", "n = excluded.n RETURNING id, n"],
  ["cast", "n = CAST(n AS INTEGER) + 1"],
  ["conflict predicate", "n = n + 1 WHERE n < excluded.n"],
  ["tuple assignment", "(n, note) = (n + 1, excluded.note)"],
] as const;
it.each(forms)("matches actual SQLite for UPSERT %s on local PostgreSQL", async (_label, assignment) => {
  const sqlite = new Database(":memory:");
  try {
    const ddl = "CREATE TABLE grammar_counter (id INTEGER PRIMARY KEY, n INTEGER NOT NULL, note TEXT)";
    sqlite.exec(ddl);
    await pg.query("DROP TABLE IF EXISTS grammar_counter", []);
    await pg.query(ddl, []);
    const seed = "INSERT INTO grammar_counter (id,n,note) VALUES (1,1,'before')";
    sqlite.exec(seed); await pg.query(seed, []);
    const sql = `INSERT INTO grammar_counter (id,n,note) VALUES (1,3,'proposed') ON CONFLICT (id) DO UPDATE SET ${assignment}`;
    sqlite.prepare(sql).run();
    await pg.query(sql, []);
    expect((await pg.query("SELECT id,n,note FROM grammar_counter", [])).rows).toEqual(sqlite.prepare("SELECT id,n,note FROM grammar_counter").all());
  } finally { sqlite.close(); }
});

it("keeps an UPSERT target alias valid on actual SQLite and PostgreSQL", async () => {
  const sqlite = new Database(":memory:");
  try {
    const ddl = "CREATE TABLE grammar_alias (id INTEGER PRIMARY KEY, n INTEGER)";
    sqlite.exec(ddl); await pg.query(ddl, []);
    const seed = "INSERT INTO grammar_alias VALUES(1,1)";
    sqlite.exec(seed); await pg.query(seed, []);
    const sql = "INSERT INTO grammar_alias AS stored (id,n) VALUES(1,3) ON CONFLICT(id) DO UPDATE SET n = n + excluded.n";
    sqlite.exec(sql); await pg.query(sql, []);
    expect((await pg.query("SELECT n FROM grammar_alias", [])).rows).toEqual(sqlite.prepare("SELECT n FROM grammar_alias").all());
  } finally { sqlite.close(); }
});

it.each(["UNIQUE", "PRIMARY KEY"])("does not narrow MySQL TEXT because a default contains %s", (literal) => {
  expect(sqliteToMysql(`CREATE TABLE grammar_text (body TEXT DEFAULT '${literal}')`)).toMatch(/body TEXT DEFAULT/);
});
it("does not treat a MySQL comment as an inline key", () => {
  expect(sqliteToMysql("CREATE TABLE grammar_text (body TEXT /* UNIQUE, (ignored) */ DEFAULT 'body')")).toMatch(/body TEXT/);
});
it("binds a quoted spaced inline MySQL key without altering its name", () => {
  expect(sqliteToMysql('CREATE TABLE grammar_text ("scope value" TEXT PRIMARY KEY)')).toContain('"scope value" VARCHAR(255) PRIMARY KEY');
});

it("keeps the complete long account scope within the MySQL throttle key", () => {
  const identifier = `${"a".repeat(64)}@${"b".repeat(63)}.${"c".repeat(63)}.${"d".repeat(56)}.test`;
  expect(identifier.length).toBe(254);
  const scope = signinScopes(identifier, undefined).account;
  expect(scope.length).toBe(262);
  const translated = sqliteToMysql(SIGNIN_THROTTLE_DDL);
  const capacity = Number(/scope\s+VARCHAR\((\d+)\)/i.exec(translated)?.[1]);
  expect(capacity).toBeGreaterThanOrEqual(scope.length);
  // Full-column key budget for the documented default InnoDB 16KB/DYNAMIC
  // target, at utf8mb4's maximum bytes per character. Native MySQL remains
  // unexecuted; nondefault row/page formats need their own qualification.
  expect(capacity * 4).toBeLessThanOrEqual(3072);
  expect(sqliteToMysql("CREATE TABLE other (scope TEXT PRIMARY KEY)")).toContain("VARCHAR(255)");
});
