// Deployment settings for the optional deck-local mods: which of them the
// composed default deck loads, and the values each one needs from its
// deployment. Every deck-local mod is OFF unless a deployment names it, and
// no setting has a built-in value: an unset setting means "not configured",
// never a fallback to some particular site's value.
//
// The settings ride the same environment surface as the other host settings
// (the DECKO_* variables):
//
//   DECKO_DECK_LOCAL_MODS
//       Comma-separated names of the deck-local mods to load, after the gem
//       mods, in the order given. No deck-local mod ships with the port, so
//       any name fails loudly, naming the setting, rather than being dropped.
//
// A host with its own settings bag (a Workers `env`) passes it through
// configureDeckLocalMods(deckLocalModsFromEnv(env)) before the deck boots;
// otherwise the settings are read from process.env when the deck boots, the
// same arrangement the strict-parity flags use
// (src/card/parity/strict-parity-flags.ts).

/** The deck-local mods a deployment can enable, by manifest name. */
export const KNOWN_DECK_LOCAL_MODS: readonly string[] = [];

export type DeckLocalModName = string;

/** The environment names these settings read. */
export const DECK_LOCAL_MODS_ENV_NAMES = {
  enabled: "DECKO_DECK_LOCAL_MODS",
} as const;

export type DeckLocalModsEnv = Partial<
  Record<(typeof DECK_LOCAL_MODS_ENV_NAMES)[keyof typeof DECK_LOCAL_MODS_ENV_NAMES], unknown>
>;

export interface DeckLocalModsConfig {
  /** The enabled deck-local mods, in load order, without duplicates. */
  readonly enabled: readonly DeckLocalModName[];
}

/** Nothing enabled: the default for every deployment. */
export const NO_DECK_LOCAL_MODS: DeckLocalModsConfig = { enabled: [] };

function optionalText(raw: unknown, name: string): string | undefined {
  if (raw === undefined) return undefined;
  if (typeof raw !== "string") throw new Error(`${name} must be a string, got ${typeof raw}`);
  const value = raw.trim();
  return value === "" ? undefined : value;
}

function isKnownDeckLocalMod(name: string): name is DeckLocalModName {
  return (KNOWN_DECK_LOCAL_MODS as readonly string[]).includes(name);
}

/** Build the settings from a settings bag. Unset values are unconfigured.
 *  Throws on a value it cannot honour, so a misconfiguration fails loudly. */
export function deckLocalModsFromEnv(env: DeckLocalModsEnv | undefined): DeckLocalModsConfig {
  const enabledName = DECK_LOCAL_MODS_ENV_NAMES.enabled;
  const list = optionalText(env?.[enabledName], enabledName);
  const enabled: DeckLocalModName[] = [];
  for (const entry of (list ?? "").split(",")) {
    const name = entry.trim();
    if (name === "") continue;
    if (!isKnownDeckLocalMod(name)) {
      throw new Error(
        `${enabledName} names an unknown deck-local mod ${JSON.stringify(name)}; known: ${KNOWN_DECK_LOCAL_MODS.join(", ")}`,
      );
    }
    if (!enabled.includes(name)) enabled.push(name);
  }
  return { enabled };
}

let configured: DeckLocalModsConfig | undefined;

/** Set the settings explicitly (a host with its own settings bag), or clear
 *  them (undefined) to fall back to process.env. */
export function configureDeckLocalMods(config: DeckLocalModsConfig | undefined): void {
  configured = config;
}

function processEnv(): DeckLocalModsEnv | undefined {
  const proc = (globalThis as { process?: { env?: DeckLocalModsEnv } }).process;
  return proc?.env;
}

/** The settings in force: the configured ones, else process.env, else
 *  nothing enabled. */
export function deckLocalMods(): DeckLocalModsConfig {
  return configured ?? deckLocalModsFromEnv(processEnv());
}
