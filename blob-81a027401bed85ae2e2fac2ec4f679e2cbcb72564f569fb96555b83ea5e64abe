import { readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
import { join, resolve, dirname, relative, sep } from "node:path";
import { fileURLToPath } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const repo = resolve(...(process.argv[2] ? [process.argv[2]] : [here, "..", ".."]));
const vendor = join(repo, "fixtures", "vendor");

const MODULES = [
  { out: "vendor/edge-bootstrap-scss-snapshot.js", subtrees: ["bootstrap-scss"] },
  { out: "vendor/edge-style-source-snapshot.js", subtrees: ["mod-style-assets", "bootswatch"] },
  { out: "vendor/edge-script-source-snapshot.js", subtrees: ["mod-script-assets"] },
];

function walk(dir, out) {
  for (const entry of readdirSync(dir)) {
    const full = join(dir, entry);
    if (statSync(full).isDirectory()) walk(full, out);
    else out.push(full);
  }
}

for (const target of MODULES) {
  const files = [];
  for (const subtree of target.subtrees) walk(join(vendor, subtree), files);
  files.sort();
  const entries = files.map((full) => [
    relative(vendor, full).split(sep).join("/"),
    readFileSync(full, "utf8"),
  ]);
  const rawBytes = files.reduce((n, f) => n + statSync(f).size, 0);
  const exportName = "edgeAssetSources";
  const out = [
    `// GENERATED by tools/vendor/build-edge-asset-source-snapshot.mjs — do not edit.`,
    `// The vendored asset sources (${target.subtrees.map((s) => `${s}/`).join(", ")})`,
    `// an edge runtime reads from this module: ${files.length} files, ${rawBytes} bytes raw.`,
    `// The tests pin it against fixtures/vendor/ byte for byte, so regenerate`,
    `// after changing the tree.`,
    ``,
    `export const ${exportName} = {`,
    ...entries.map(([key, value]) => `  ${JSON.stringify(key)}: ${JSON.stringify(value)},`),
    `};`,
    ``,
  ].join("\n");
  const outPath = join(repo, target.out);
  writeFileSync(outPath, out);
  const dts = [
    `// Types for the generated snapshot (see the header of`,
    `// ${target.out.split("/").pop()} and the generator that writes it).`,
    `export declare const ${exportName}: Record<string, string>;`,
    ``,
  ].join("\n");
  writeFileSync(outPath.replace(/\.js$/, ".d.ts"), dts);
  console.log(`wrote ${outPath} (${files.length} files, ${rawBytes} raw bytes, ${out.length} module bytes)`);
}
