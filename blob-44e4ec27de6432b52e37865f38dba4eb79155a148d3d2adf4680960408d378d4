const checkScript = fileURLToPath(new URL('../../tools/release/readiness-check.mjs', import.meta.url));
const sha = bytes => createHash('sha256').update(bytes).digest('hex');
// Planted markers carry a '^' break so this source never holds a marker itself;
// unmask() restores the exact text the check receives at runtime.
const unmask = text => text.replaceAll('^', '');

const cleanFiles = () => ({
  'README.md': [
    '# Example engine',
    '',
    'Read [the scope](PORT-SCOPE.md) and [the notice](NOTICE) first.',
    'The entry point is `src/index.ts`, and the schema is db/schema.sql.',
    'The export manifest is HANDOVER-MANIFEST.json, written by tools/build/export.mjs (development repository; not included).',
    'Hosting on Bunny (bunny.net) is described in docs/handover/DEPLOYMENT.md.',
    'Run `node tools/run.mjs ./tmp/out` to write output into tmp/out.',
    '',
  ].join('\n'),
  'PORT-SCOPE.md': '# Scope\n\nSee [the readme](README.md#example-engine).\n',
  'NOTICE': 'Copyright notice for the example engine.\n',
  'docs/handover/DEPLOYMENT.md': '# Deployment\n\nBack to [the readme](../../README.md).\n',
  'src/index.ts': [
    '/*! Example engine. Licensed under GPL-3.0-or-later. */',
    '/// <reference types="node" />',
    'export const slash = "// not a comment";',
    'export const template = `/* not a comment ${slash} */`;',
    'export const pattern = /\\/\\/+/g;',
    '// @ts-expect-error',
    'export const value: number = "text";',
    '',
  ].join('\n'),
  'src/types.d.mts': 'export const LIMIT: number;\n',
  'db/schema.sql': [
    "CREATE TABLE cards (name TEXT DEFAULT '-- not a comment', note TEXT DEFAULT '/* nor this */');",
    'CREATE TABLE "odd--name" (id INTEGER);',
    '',
  ].join('\n'),
  'tools/run.mjs': [
    '#!/usr/bin/env node',
    '/*',
    ' * SPDX-License-Identifier: GPL-3.0-or-later',
    ' */',
    "const url = 'https://example.com/path';",
    'console.log(url);',
    '',
  ].join('\n'),
  'vendor/upstream/lib.js': unmask('// Upstream says: da^mn, Re^lay this to Clau^de.\nmodule.exports = 1;\n'),
});

function writeExport(root, files) {
  for (const [name, text] of Object.entries(files)) {
    const full = path.join(root, ...name.split('/'));
    mkdirSync(path.dirname(full), { recursive: true });
    writeFileSync(full, text);
  }
}

function writeManifest(root, files) {
  const entries = Object.keys(files).sort().map(name => {
    const bytes = readFileSync(path.join(root, ...name.split('/')));
    return { path: name, mode: '100644', bytes: bytes.length, sha256: sha(bytes) };
  });
  writeFileSync(path.join(root, 'HANDOVER-MANIFEST.json'), JSON.stringify({ format: 1, files: entries }, null, 2) + '\n');
}

function exportWith(mutate = () => {}, { manifestBeforeMutation = false } = {}) {
  const root = mkdtempSync(path.join(tmpdir(), 'decko-readiness-'));
  const files = cleanFiles();
  if (manifestBeforeMutation) {
    writeExport(root, files);
    writeManifest(root, files);
    mutate(files, root);
  } else {
    mutate(files, root);
    writeExport(root, files);
    writeManifest(root, files);
  }
  return root;
}

function lineNumberOf(text, needle) {
  const index = text.split('\n').findIndex(line => line.includes(needle));
  assert.notEqual(index, -1, 'planted text not found: ' + needle);
  return index + 1;
}

async function check(root, allowlist = []) {
  try { return await runReadinessCheck(root, { allowlist }); }
  finally { rmSync(root, { recursive: true, force: true }); }
}

function summary(result) {
  return result.failures.map(item => `${item.check} ${item.file}:${item.line} ${item.rule}`).sort();
}

test('a clean export passes every check', async () => {
  const result = await check(exportWith());
  assert.deepEqual(summary(result), []);
  assert.equal(result.passed, true);
  assert.deepEqual(result.counts, { 'private-markers': 0, 'shipped-wording': 0, comments: 0, links: 0, 'cited-paths': 0, manifest: 0 });
});

test('check 1 refuses private markers anywhere, with file and line', async () => {
  let line, readmeLine, vendorLine;
  const result = await check(exportWith(files => {
    files['src/index.ts'] += unmask('export const owner = "rule card 455^14 on the ju^c VM";\n');
    line = lineNumberOf(files['src/index.ts'], unmask('455^14'));
    files['README.md'] += unmask('Measured on the 4^7k-card corpus^ deck at C^:\\localProjects\\decko-example, see DEC^KO-12.\n');
    readmeLine = lineNumberOf(files['README.md'], unmask('4^7k'));
    files['vendor/upstream/lib.js'] += unmask('module.exports.id = "Make^ Contact";\n');
    vendorLine = lineNumberOf(files['vendor/upstream/lib.js'], unmask('Make^ Contact'));
  }));
  const failures = summary(result);
  assert.ok(failures.includes(`private-markers src/index.ts:${line} private-card-id`), failures.join('\n'));
  assert.ok(failures.includes(`private-markers src/index.ts:${line} private-host`), failures.join('\n'));
  for (const rule of ['private-deck-fact', 'local-path', 'tracker-id']) {
    assert.ok(failures.includes(`private-markers README.md:${readmeLine} ${rule}`), rule + '\n' + failures.join('\n'));
  }
  assert.ok(failures.includes(`private-markers vendor/upstream/lib.js:${vendorLine} private-deck-name`), failures.join('\n'));
  assert.ok(!failures.some(item => item.includes('vendor/upstream/lib.js:1 ')), 'third-party wording and profanity are excluded');
  assert.equal(result.passed, false);
});

test('check 1 refuses Linux and macOS home-folder paths of any user, in code, data and third-party files', async () => {
  const lines = {};
  const result = await check(exportWith(files => {
    files['src/index.ts'] += 'export const bundle = "/home/alice/oracle-bundle/app/public";\n';
    lines.src = lineNumberOf(files['src/index.ts'], '/home/alice/');
    files['README.md'] += 'Captured with the bundle in /Users/bob smith/work/decko.\n';
    lines.readme = lineNumberOf(files['README.md'], '/Users/bob');
    files['fixtures/expected/render.jsonl'] = '{"id":"a","error":{"message":"for #<View @dir=\\"/home/runner/x\\">"}}\n';
    files['vendor/upstream/lib.js'] += 'module.exports.root = "/Users/carol/lib";\n';
    lines.vendor = lineNumberOf(files['vendor/upstream/lib.js'], '/Users/carol/');
    files['fixtures/account.txt'] = '/home/guest\n/Users/jane doe\n';
  }));
  const failures = summary(result);
  assert.ok(failures.includes(`private-markers src/index.ts:${lines.src} home-folder-path`), failures.join('\n'));
  assert.ok(failures.includes(`private-markers README.md:${lines.readme} home-folder-path`), failures.join('\n'));
  assert.ok(failures.includes('private-markers fixtures/expected/render.jsonl:1 home-folder-path'), failures.join('\n'));
  assert.ok(failures.includes(`private-markers vendor/upstream/lib.js:${lines.vendor} home-folder-path`), failures.join('\n'));
  assert.ok(failures.includes('private-markers fixtures/account.txt:1 home-folder-path'), failures.join('\n'));
  assert.ok(failures.includes('private-markers fixtures/account.txt:2 home-folder-path'), failures.join('\n'));
  assert.equal(result.passed, false);
});

