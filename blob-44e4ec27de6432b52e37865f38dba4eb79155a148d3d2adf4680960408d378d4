test('an exact allowlist entry suppresses only its own finding', async () => {
  const files = cleanFiles();
  files['src/index.ts'] += unmask('export const ruleCard = "card 455^14";\n');
  const line = lineNumberOf(files['src/index.ts'], unmask('455^14'));
  const entry = { check: 'private-markers', file: 'src/index.ts', line, text: unmask('export const ruleCard = "card 455^14";'), reason: 'test' };
  const allowed = await check(exportWith(f => { f['src/index.ts'] = files['src/index.ts']; }), [entry]);
  assert.deepEqual(summary(allowed), []);
  assert.equal(allowed.allowlisted.length, 1);
  const moved = await check(exportWith(f => { f['src/index.ts'] = files['src/index.ts']; }), [{ ...entry, line: line + 1 }]);
  assert.deepEqual(summary(moved), [`private-markers src/index.ts:${line} private-card-id`]);
});

test('the allowlist file is valid and refuses wildcards', () => {
  assert.ok(Array.isArray(loadAllowlist(defaultAllowlistFile)));
  const root = mkdtempSync(path.join(tmpdir(), 'decko-readiness-allowlist-'));
  try {
    const file = path.join(root, 'allowlist.json');
    writeFileSync(file, JSON.stringify({ entries: [{ check: 'comments', file: 'src/*.ts', line: 1, text: 'x', reason: 'y' }] }));
    assert.throws(() => loadAllowlist(file), /wildcard/);
    writeFileSync(file, JSON.stringify({ entries: [{ check: 'comments', file: 'src/a.ts', line: 1, text: 'x' }] }));
    assert.throws(() => loadAllowlist(file), /reason/);
  } finally { rmSync(root, { recursive: true, force: true }); }
});

test('the SQL scanner ignores comment markers inside quoted text', () => {
  const comments = sqlComments("SELECT '--x', \"a/*b\", $$ -- y $$ FROM t; -- real\n/* outer /* inner */ */");
  assert.deepEqual(comments.map(item => item.type), ['Line', 'Block']);
  assert.equal(comments[0].value, ' real');
});

test('the command exits non-zero and prints each failure with file and line', () => {
  let line;
  const root = exportWith(files => {
    files['src/index.ts'] += 'export const z = 0; // planted\n';
    line = lineNumberOf(files['src/index.ts'], 'planted');
  });
  try {
    const empty = path.join(root, '..', path.basename(root) + '-allowlist.json');
    writeFileSync(empty, '{"entries":[]}');
    try {
      const child = spawnSync(process.execPath, [checkScript, root, '--allowlist', empty], { encoding: 'utf8', windowsHide: true });
      assert.equal(child.status, 1, child.stderr);
      assert.match(child.stdout, new RegExp(`src/index\\.ts:${line}: line-comment`));
      assert.match(child.stdout, /readiness REFUSED/);
    } finally { rmSync(empty, { force: true }); }
  } finally { rmSync(root, { recursive: true, force: true }); }
});
