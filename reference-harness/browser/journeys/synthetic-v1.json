{
  "format": "decko-browser-journeys/1",
  "fixture": "synthetic-v1",
  "about": "User journeys on the synthetic-v1 deck, written once and run against every engine. Each journey starts on a fresh copy of the built deck. Steps: visit, signin (actor, through the sign-in form), click / fill / type / check / uncheck / select / upload (a target: link, button, css, name, field or text, optionally within a css scope), editor (sets an editor's content as Decko's own steps do), press, wait, window / close_window, mail_link, observe (records what the user sees).",
  "journeys": [
    {
      "id": "signin-signout-member",
      "covers": ["sign in", "sign out", "signup.feature: sign out, sign back in"],
      "steps": [
        {"visit": "/"},
        {"observe": "home, signed out"},
        {"click": {"link": "Sign in"}},
        {"observe": "sign-in page"},
        {"fill": {"field": "*email"}, "value": "mira.member@example.test"},
        {"fill": {"field": "*password"}, "value": "Fixture member pass 1#"},
        {"click": {"button": "Sign in"}},
        {"observe": "after sign-in"},
        {"click": {"link": "Sign out"}},
        {"observe": "after sign-out"}
      ]
    },
