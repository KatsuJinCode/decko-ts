  const record=directoryCustody(path.resolve(directory),'owned generated input namespace',true);
  for(const candidate of [record.path,record.physicalPath])for(const protectedRoot of [sourceRoot,...dependencyRoots])if(withinDirectory(candidate,protectedRoot)||withinDirectory(protectedRoot,candidate))fail('Generated namespace must remain outside and not overlap source/runtime: '+candidate);
