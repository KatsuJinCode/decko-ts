  if(withinDirectory(file,sourceRoot)&&!dependency)fail('Unqualified application source/data read is absent from preflight: '+file);
  const generated=generatedRoots.some(root=>withinDirectory(file,root.path)||withinDirectory(file,root.physicalPath));
  if(!generated&&EXECUTABLE.test(file))fail('Unqualified executable input is absent from source/runtime preflight: '+file);
