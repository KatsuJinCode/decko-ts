 const index=loadedInputIndex(profile),transformed=proof.transforms.map(input=>{
  const file=loadedFilePath(input.id),qualified=qualifyLoadedRecord(index,input,file);if(!qualified)fail('Unqualified transformed source is absent from preflight: '+file);return qualified;
 });
 const suite=profile.caseContract?.file;if(!suite)fail('Missing admitted suite identity for loaded-source coverage');
