export function verifyMatrixProfile(profile,{backends=profile.runtime.auxiliary?.backends}={}){
 const fresh=inspectMatrixSource(profile.source.root,profile.source.commit);
 if(JSON.stringify(fresh.custody)!==JSON.stringify(profile.source.custody))fail('Source physical custody changed since profile preparation');
