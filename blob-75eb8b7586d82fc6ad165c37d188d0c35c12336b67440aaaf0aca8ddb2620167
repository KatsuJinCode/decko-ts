 const closure=inspectDeclaredRuntime(profile.source.root);
 const ordered=records=>[...records].sort((a,b)=>JSON.stringify(a).localeCompare(JSON.stringify(b)));
 for(const key of ['packages','files','missingOptional'])if(JSON.stringify(ordered(closure[key]))!==JSON.stringify(ordered(profile.runtime[key])))fail('Declared runtime closure membership or physical identity changed: '+key);
 for(const key of ['dependencyRoot','directories','resolutionGuards','executableResolutions'])if(profile.runtime[key]!==undefined&&JSON.stringify(key==='dependencyRoot'?closure[key]:ordered(closure[key]))!==JSON.stringify(key==='dependencyRoot'?profile.runtime[key]:ordered(profile.runtime[key])))fail('Declared runtime directory/resolution custody changed: '+key);
 for(const entry of [profile.runtime.node,...profile.runtime.packages,...profile.runtime.files,...profile.tools]){const current=runtimeFile(entry.path);if(current.sha256!==entry.sha256||current.physicalPath!==entry.physicalPath||(entry.identity!==undefined&&current.identity!==entry.identity))fail('Runtime/tool input changed: '+entry.path);}
 for(const entry of profile.runtime.missingOptional){let present=false;try{fs.lstatSync(entry.path);present=true;}catch(e){if(e.code!=='ENOENT')throw e;}if(present)fail('Optional dependency presence changed: '+entry.path);}
 for(const entry of profile.runtime.nativeInventory){const current=optionalFile(entry.path);if(current.present!==entry.inventory.present||(current.present&&current.sha256!==entry.inventory.sha256))fail('Native runtime inventory changed: '+entry.path);}
 for(const obligation of profile.obligations){if(obligation.auxiliaryKind!==undefined&&(!backends?.length||(obligation.auxiliaryKind==='cf-cache'&&!backends.includes('d1'))))continue;if(!obligation.inventory.path)continue;const current=optionalFile(obligation.inventory.path);if(current.present!==obligation.inventory.present||(current.present&&current.sha256!==obligation.inventory.sha256))fail('Optional runtime inventory changed: '+obligation.inventory.path);}
 if(profile.runtime.auxiliary!==undefined)verifyMatrixAuxiliaryRuntime(profile.runtime.auxiliary,{backends});
 return true;
}

function loadedFilePath(value){
 if(typeof value!=='string'||value.includes('\0'))fail('Virtual or invalid loaded source is not a qualified file: '+String(value));
 let file;if(value.startsWith('file:')){try{file=fileURLToPath(new URL(value));}catch(error){fail('Loaded source file URL is invalid: '+error.message);}}else file=value.split('?')[0];
 if(!path.isAbsolute(file))fail('Loaded source is not an absolute qualified file: '+value);
 return path.resolve(file);
}
const pathKey=value=>process.platform==='win32'?value.toLowerCase():value;
function withinDirectory(file,directory){const relative=path.relative(directory,file);return relative===''||relative!=='..'&&!relative.startsWith('..'+path.sep)&&!path.isAbsolute(relative);}
function loadedInputIndex(profile){
 const index=new Map();
 function add(input,kind){for(const name of [input.path,input.physicalPath].filter(Boolean)){const key=pathKey(loadedFilePath(name)),previous=index.get(key);if(previous&&previous.input.sha256!==input.sha256)fail('Profile has conflicting input identities: '+name);if(!previous)index.set(key,{input,kind});}}
 for(const input of profile.source.files)add({...input,path:path.join(profile.source.root,input.path)},'application source');
 for(const input of [...(profile.tools??[]),profile.runtime.node,...(profile.runtime.packages??[]),...(profile.runtime.files??[])].filter(Boolean))add(input,'declared tool/runtime');
 for(const role of profile.runtime.auxiliary?.roles??[])if(role.status==='QUALIFIED'&&role.inventory)add(role.inventory,'declared auxiliary runtime input');
 return index;
}
function qualifyLoadedRecord(index,record,file){
 if(!Number.isInteger(record.bytes)||record.bytes<0||!/^[a-f0-9]{64}$/.test(record.sha256??''))fail('Loaded input lacks complete bytes/hash identity: '+file);
 const declared=index.get(pathKey(file));if(!declared)return null;
 if(declared.input.sha256!==record.sha256||declared.input.bytes!==undefined&&declared.input.bytes!==record.bytes)fail('Loaded source bytes/hash differ from preflight identity: '+file);
 return{path:file,kind:declared.kind,declaredPath:declared.input.path,bytes:record.bytes,sha256:record.sha256};
}
export function verifyMatrixTransformedSource(profile,input){
