}
export function createMatrixTransformedSourceVerifier(profile){
 const index=loadedInputIndex(profile);
 return input=>{const file=loadedFilePath(input.id),qualified=qualifyLoadedRecord(index,input,file);if(!qualified)fail('Unqualified transformed source is absent from preflight: '+file);return qualified;};
}
export function verifyMatrixLoadedSourceCoverage(profile,proof){
 if(!Array.isArray(proof?.transforms)||proof.transforms.length===0)fail('Missing or empty actual transformed-source evidence');
