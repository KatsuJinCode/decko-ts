import { afterAll, afterEach, expect, test } from "vitest";
import { spawn, type ChildProcess } from "node:child_process";
import { copyFileSync, existsSync, mkdirSync, readFileSync, readdirSync, rmSync, utimesSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { scratchDir, removeScratchDir } from "../support/scratch-dir.mjs";

const directories: string[] = [];
const children = new Set<ChildProcess>();
const finishers = new Set<() => void>();
const childReceipts: {pid: number | undefined; code: number | null; signal: string | null; stdout: string; stderr: string}[] = [];
const compilerReceipts: {pid:number;code:number;absence:string}[]=[];
const orphanReceipts: {pid:number;role:string;absence:string}[]=[];
afterAll(() => console.info(JSON.stringify({fixture: "dist-lock-owned-Node-only", childReceipts, compilerReceipts,orphanReceipts})));
afterEach(async () => {
  // Release the fixture compiler before waiting for its parent. Killing only
  // the parent would orphan the compiler if an assertion failed at the barrier.
  for (const directory of directories) {
    rmSync(join(directory,"hold-build"),{force:true});
    rmSync(join(directory,"hold-orphan-build"),{force:true});
  }
  for (const finish of finishers) finish();
  await Promise.all([...children].map(child => new Promise<void>(resolve => {
    if (child.exitCode !== null || child.signalCode !== null) return resolve();
    child.once("close", () => resolve());
  })));
  children.clear();
  finishers.clear();
  for (const directory of directories) {
    const orphan=join(directory,"orphan-compiler");
    if(existsSync(orphan)){
      const pid=JSON.parse(readFileSync(orphan,"utf8")).pid;
      await expect.poll(()=>{try{process.kill(pid,0);return "live";}catch(error){return (error as NodeJS.ErrnoException).code;}},{timeout:10000}).toBe("ESRCH");
      orphanReceipts.push({pid,role:"held-writer",absence:"ESRCH"});
      const wrapper=JSON.parse(readFileSync(join(directory,"orphan-wrapper"),"utf8")).pid;
      await expect.poll(()=>{try{process.kill(wrapper,0);return "live";}catch(error){return (error as NodeJS.ErrnoException).code;}},{timeout:10000}).toBe("ESRCH");
      orphanReceipts.push({pid:wrapper,role:"compiler-wrapper",absence:"ESRCH"});
    }
    const receipts=join(directory,"compiler-receipts");
    if(!existsSync(receipts))continue;
    for(const line of readFileSync(receipts,"utf8").trim().split(/\r?\n/)){
      const receipt=JSON.parse(line);
      let absence="unknown";
      try {process.kill(receipt.pid,0);}catch(error){absence=(error as NodeJS.ErrnoException).code??"unknown";}
      compilerReceipts.push({...receipt,absence});
      expect(absence,"fixture compiler must have exited before scratch cleanup").toBe("ESRCH");
    }
  }
  for (const directory of directories.splice(0)) removeScratchDir(directory);
});

function fixture() {
  const root = scratchDir("dist-build-lock-"); directories.push(root);
  const put = (file: string, body: string) => {
    const target = join(root, file); mkdirSync(join(target, ".."), { recursive: true }); writeFileSync(target, body);
  };
  put("package.json", '{"type":"module"}');
  put("tsconfig.json", "{}");
  put("src/server/drivers/local-sqlite.ts", "export default {};");
  put("src/card/transitive.ts", "export default {};");
  put("vm-staging-server.mjs", 'import x from "./dist/src/server/drivers/local-sqlite.js";');
  put("tests/card/auth/staging-server-dist-bootstrap.ts", "");
  copyFileSync(new URL("../card/auth/staging-server-dist-bootstrap.ts", import.meta.url), join(root, "tests/card/auth/staging-server-dist-bootstrap.ts"));
  put("tools/dist/build-lock.mjs", "");
  copyFileSync(new URL("../../tools/dist/build-lock.mjs", import.meta.url), join(root, "tools/dist/build-lock.mjs"));
  // This lock fixture simulates a compiler with a Node program; native launch
  // and installed package identity have separate direct-compiler controls.
  put("tools/platform/native-typescript-compiler.mjs", `
import {spawnSync} from 'node:child_process';import path from 'node:path';
export const spawnNativeTypeScript=(root,args,options)=>spawnSync(process.execPath,[path.join(root,'node_modules/typescript/bin/tsc'),...args],{...options,windowsHide:true,shell:false});
`);
  put("tools/dist/runtime-assets.mjs", `
import fs from 'node:fs'; import path from 'node:path';
export const runtimeAssetReadiness = root => fs.existsSync(path.join(root,'dist/asset')) ? [] : ['asset'];
export function copyRuntimeAssets(root) {
  if(!fs.existsSync(path.join(root,'dist/.tsc-build-lock'))) throw Error('assets copied outside lock');
  const names=fs.readdirSync(path.join(root,'dist/.tsc-build-lock'));
  if(!names.some(name=>name.startsWith('build-active-')))throw Error('assets copied outside build activity barrier');
  fs.appendFileSync(path.join(root,'events'),'copy\\n'); fs.writeFileSync(path.join(root,'dist/asset'),'ready');
}`);
  put("node_modules/typescript/bin/tsc", `
import fs from 'node:fs'; import path from 'node:path';
import {spawn} from 'node:child_process';import {fileURLToPath} from 'node:url';
process.on('exit',code=>fs.appendFileSync('compiler-receipts',JSON.stringify({pid:process.pid,code})+'\\n'));
if(fs.existsSync('hold-orphan-build')&&process.argv[2]!=='owned-detached-writer'){
 const writer=spawn(process.execPath,[fileURLToPath(import.meta.url),'owned-detached-writer'],
  {cwd:process.cwd(),windowsHide:true,detached:true,stdio:'ignore'});
 fs.writeFileSync('orphan-wrapper',JSON.stringify({pid:process.pid,parentPid:process.ppid,writerPid:writer.pid}));
 const result=await new Promise((resolve,reject)=>{writer.once('error',reject);writer.once('exit',code=>resolve(code));});
 process.exit(result);
}
if(!fs.existsSync('dist/.tsc-build-lock')) throw Error('compile outside lock');
const ownerName=fs.readdirSync('dist/.tsc-build-lock').find(name=>name.startsWith('owner-'));
const ownerRecord=JSON.parse(fs.readFileSync(path.join('dist/.tsc-build-lock',ownerName)));
if(ownerRecord.format==='decko-dist-build-lock/2'&&!fs.existsSync(path.join('dist/.tsc-build-lock','build-active-'+ownerRecord.token+'.json')))throw Error('compiler started before build activity barrier');
fs.appendFileSync('events','build\\n'); fs.writeFileSync('build-started',JSON.stringify({pid:process.pid,parentPid:process.ppid}));
const orphanHeld=fs.existsSync('hold-orphan-build')&&!fs.existsSync('orphan-compiler');
if(orphanHeld)fs.writeFileSync('orphan-compiler',JSON.stringify({pid:process.pid,parentPid:process.ppid}));
while(fs.existsSync('hold-build')||(orphanHeld&&fs.existsSync('hold-orphan-build'))) await new Promise(r=>setTimeout(r,20));
if(fs.existsSync('mutate-lock')){
 const name=fs.readdirSync('dist/.tsc-build-lock').find(name=>name.startsWith('owner-'));
 const file=path.join('dist/.tsc-build-lock',name),owner=JSON.parse(fs.readFileSync(file));
 fs.writeFileSync(file,JSON.stringify({...owner,processStartedAt:'1970-01-01T00:00:00.000Z'}));
}
if(fs.existsSync('fail-build')) { console.log('fixture TS2322: narrowing failed'); throw Error('fixture compilation failed'); }
for(const name of ['server/drivers/local-sqlite.js','server/write-routes.js','card/render.js','server/libsass-wasm.js']) {
 if(fs.existsSync('omit-entry') && name==='server/drivers/local-sqlite.js') continue;
 const file=path.join('dist/src',name); fs.mkdirSync(path.dirname(file),{recursive:true}); fs.writeFileSync(file,'export default {};');
}`);
  put("run.mjs", `
import fs from 'node:fs';
import {ensureStagingServerDist} from './tests/card/auth/staging-server-dist-bootstrap.ts';
fs.writeFileSync('runner-'+process.argv[2],'');
if(process.argv[5]==='unknown-liveness') process.kill=()=>{throw Object.assign(Error('fixture EPERM'),{code:'EPERM'});};
await ensureStagingServerDist(process.argv[3]==='native' ? undefined : ()=>fs.existsSync('force-stale'),
  process.argv[4]==='probe' ? {waitMs:0} : undefined);
`);
  put("owner.mjs", `
import {acquireDistBuildLock} from './tools/dist/build-lock.mjs';
import path from 'node:path';
const lock=await acquireDistBuildLock({lockDir:path.resolve('dist/.tsc-build-lock')});
process.on('message', command=>{
  if(command==='activate'){lock.markBuildActive();process.send('active');return;}
  try {if(command==='release')lock.release();else if(command!=='abandon')throw Error('unknown fixture command');}
  catch(error){console.error(error);process.exitCode=1;}
  process.disconnect();
});
process.send(lock.owner);
`);
  const track = (child: ChildProcess) => {
    children.add(child); let output = "",stdout="",stderr="";
    child.stdout!.on("data", data => {output += data;stdout+=data;}); child.stderr!.on("data", data => {output += data;stderr+=data;});
    const done = new Promise<{ code: number | null; signal: string | null; pid: number | undefined; output: string }>((resolve, reject) => {
      child.once("error", reject); child.once("close", (code,signal) => {
        children.delete(child);childReceipts.push({pid:child.pid,code,signal,stdout,stderr});resolve({ code,signal,pid:child.pid,output });
      });
    });
    return done;
  };
  const run = (id: string, native = false, probe = false, unknownLiveness = false) => track(
    spawn(process.execPath, ["run.mjs",id,native?"native":"override",probe?"probe":"wait",unknownLiveness?"unknown-liveness":"native-liveness"],
      {cwd:root,windowsHide:true,stdio:["ignore","pipe","pipe"]}));
  const own = async () => {
    const child=spawn(process.execPath,["owner.mjs"],{cwd:root,windowsHide:true,stdio:["ignore","pipe","pipe","ipc"]});
    const done=track(child);
    const finish=()=>{if(child.connected)child.send("release");};finishers.add(finish);
    const owner=await new Promise<Record<string, unknown>>((resolve,reject)=>{
      child.once("message",message=>resolve(message as Record<string,unknown>));
      child.once("error",reject);child.once("exit",()=>reject(Error("fixture owner exited before ready")));
    });
    return {child,owner,done,finish:(command="release")=>{finishers.delete(finish);if(child.connected)child.send(command);}};
  };
  const orphanParent=()=>{
    const child=spawn(process.execPath,["run.mjs","orphan-parent","override","wait","native-liveness"],{cwd:root,windowsHide:true,stdio:["ignore","pipe","pipe"]});
    return {child,done:track(child)};
  };
  const events = () => readFileSync(join(root, "events"), "utf8").trim().split(/\r?\n/);
  return { root, put, run, own, orphanParent, events };
}

test("cold endpoint and battery builds share one compiler and publish assets under the same lock", async () => {
  const f = fixture(); f.put("hold-build", "");
  const first = f.run("endpoint");
  await expect.poll(() => existsSync(join(f.root, "build-started")), { timeout: 10000 }).toBe(true);
  const second = f.run("battery");
  await expect.poll(() => existsSync(join(f.root, "runner-battery")), { timeout: 10000 }).toBe(true);
  expect(existsSync(join(f.root, "dist/.staging-server-dist-built"))).toBe(false);
  rmSync(join(f.root, "hold-build"));
  const results = await Promise.all([first, second]);
  for (const result of results) expect(result.code, result.output).toBe(0);
  expect(f.events()).toEqual(["build", "copy"]);
  expect(existsSync(join(f.root, "dist/.tsc-build-lock"))).toBe(false);
}, 20000);

test("actual bootstrap retains an old live owner's lock without the default wait", async () => {
