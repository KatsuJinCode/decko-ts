for(const kind of ["missing","malformed","ambiguous","foreign-machine","reused-live-pid","unreadable-liveness","recovery-in-progress","oversized","invalid-pid","legacy-parent-only","partial-build-marker"]){
  test(`actual bootstrap preserves ${kind} ownership`,async()=>{
    const f=fixture(),lockDir=join(f.root,"dist/.tsc-build-lock");
    const held=await f.own();held.finish("abandon");expect((await held.done).code).toBe(0);
    const name=`owner-${held.owner.token}.json`,file=join(lockDir,name);
    if(kind==="missing")rmSync(file);
    if(kind==="malformed")writeFileSync(file,"{unreadable");
    if(kind==="ambiguous")writeFileSync(join(lockDir,"unclassified-owner"),"retained");
    if(kind==="recovery-in-progress")writeFileSync(join(lockDir,`reclaim-${held.owner.token}.json`),"unknown recovery owner");
    if(kind==="oversized")writeFileSync(file,"x".repeat(8193));
    if(kind==="invalid-pid")writeFileSync(file,JSON.stringify({...held.owner,pid:[held.owner.pid]}));
    if(kind==="legacy-parent-only")writeFileSync(file,JSON.stringify({...held.owner,format:"decko-dist-build-lock/1"}));
    if(kind==="partial-build-marker")writeFileSync(join(lockDir,`build-active-${held.owner.token}.json`),"{partial");
    if(kind==="foreign-machine")writeFileSync(file,JSON.stringify({...held.owner,machine:"foreign-machine"}));
    if(kind==="reused-live-pid")writeFileSync(file,JSON.stringify({...held.owner,pid:process.pid,processStartedAt:"1970-01-01T00:00:00.000Z"}));
    utimesSync(lockDir,100,100);
    const snapshot=()=>Object.fromEntries(readdirSync(lockDir).map(entry=>[entry,readFileSync(join(lockDir,entry),"utf8")]));
    const before=snapshot(),blocked=await f.run(kind,false,true,kind==="unreadable-liveness");
    expect(blocked.code,blocked.output).not.toBe(0);expect(blocked.output).toContain("build lock retained (");
    expect(blocked.output).toContain(kind==="reused-live-pid"?"(live:":"(unknown:");
    expect(snapshot()).toEqual(before);expect(existsSync(join(f.root,"build-started"))).toBe(false);
  });
}

