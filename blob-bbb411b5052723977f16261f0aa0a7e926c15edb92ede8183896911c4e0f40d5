test("actual acquisition retains the lock after its parent exited while a compiler remains alive",async()=>{
  const f=fixture();f.put("hold-orphan-build","");const parent=f.orphanParent();
  await expect.poll(()=>existsSync(join(f.root,"orphan-compiler")),{timeout:10000}).toBe(true);
  const compiler=JSON.parse(readFileSync(join(f.root,"orphan-compiler"),"utf8"));
  const wrapper=JSON.parse(readFileSync(join(f.root,"orphan-wrapper"),"utf8"));
  expect(wrapper.parentPid).toBe(parent.child.pid);expect(compiler.parentPid).toBe(wrapper.pid);expect(compiler.pid).toBe(wrapper.writerPid);
  // Simulate a crash only through this newly spawned fixture's retained native
  // child handle, after checking its exact command. Never an existing process.
  expect(parent.child.spawnfile).toBe(process.execPath);
  expect(parent.child.spawnargs).toEqual([process.execPath,"run.mjs","orphan-parent","override","wait","native-liveness"]);
  expect(parent.child.exitCode).toBeNull();process.kill(parent.child.pid!,0);
  expect(parent.child.kill("SIGTERM")).toBe(true);const exited=await parent.done;
  expect(exited.signal===null?Number.isInteger(exited.code)&&exited.code!==0:exited.signal==="SIGTERM",exited.output).toBe(true);
  let parentAbsence="unknown";
  try{process.kill(parent.child.pid!,0);}catch(error){parentAbsence=(error as NodeJS.ErrnoException).code??"unknown";}
  expect(parentAbsence).toBe("ESRCH");process.kill(compiler.pid,0);
  const lockDir=join(f.root,"dist/.tsc-build-lock");
  const snapshot=()=>Object.fromEntries(readdirSync(lockDir).map(name=>[name,readFileSync(join(lockDir,name),"utf8")]));
  const before=snapshot(),probe=await f.run("orphan-probe",false,true);
  process.kill(compiler.pid,0);
  console.info(JSON.stringify({orphanObservation:{parentPid:parent.child.pid,parentExit:exited.code,parentSignal:exited.signal,parentAbsence,wrapperPid:wrapper.pid,compilerPid:compiler.pid,compilerAlive:true,probeExit:probe.code}}));
  expect(probe.code,probe.output).not.toBe(0);
  expect(probe.output).toContain("build lock retained (unknown:");expect(snapshot()).toEqual(before);
  expect(f.events()).toEqual(["build"]);
  rmSync(join(f.root,"hold-orphan-build"));
  await expect.poll(()=>{try{process.kill(compiler.pid,0);return "live";}catch(error){return (error as NodeJS.ErrnoException).code;}},{timeout:10000}).toBe("ESRCH");
  // A dead direct compiler still does not establish arbitrary orphan absence.
  const after=f.run("orphan-finished-probe",false,true),retained=await after;
  expect(retained.code,retained.output).not.toBe(0);expect(snapshot()).toEqual(before);
});

