"""Execute SHA-bound original recovery assertions using existing native Node."""
import base64
import hashlib
import json
import os
import pathlib
import subprocess
import sys
import tempfile

if sys.platform != "linux":
    raise RuntimeError("RecoveryVmRequiresLinux")
request = json.load(sys.stdin)
sha = lambda data: hashlib.sha256(data).hexdigest()
with tempfile.TemporaryDirectory(prefix="decko-recovery-node-") as temporary:
    root = pathlib.Path(temporary).resolve()
    files = {}
    for name, item in request["files"].items():
        relative = pathlib.PurePosixPath(name)
        if relative.is_absolute() or ".." in relative.parts:
            raise ValueError("RecoveryVmPathInvalid")
        target = root.joinpath(*relative.parts)
        data = base64.b64decode(item["bytes"], validate=True)
        if sha(data) != item["sha256"]:
            raise ValueError("RecoveryVmSourceHashMismatch: " + name)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)
        files[name] = sha(target.read_bytes())
    environment = dict(os.environ, DECKO_TEST_TEMP_ROOT=str(root / "scratch"))
    runtime = subprocess.run(["node", "-e", "console.log(JSON.stringify({node:process.version,platform:process.platform,arch:process.arch,uv:process.versions.uv}));const{DatabaseSync}=require('node:sqlite');const d=new DatabaseSync(':memory:');console.log(JSON.stringify(d.prepare('select sqlite_version() version').get()));d.close()"], capture_output=True, text=True, check=True)
    commands = [
        ["node", "tests/support/assertion-controls.mjs"],
        ["node", "--test", "--test-concurrency=1", "tests/support/lifecycle-controls.mjs"],
        ["node", "--test", "--test-concurrency=1", "tests/support/recovery-vm-bundle.mjs"],
    ]
    results = []
    for command in commands:
        result = subprocess.run(command, cwd=root, env=environment, capture_output=True, text=True)
        results.append(dict(command=command, status=result.returncode, stdout=result.stdout, stderr=result.stderr))
        if result.returncode:
            break
    scratch = root / "scratch"
    residue = [str(file.relative_to(root)) for file in scratch.iterdir()] if scratch.exists() else []
    report = dict(runtime=dict(stdout=runtime.stdout, stderr=runtime.stderr), files=files, results=results,
                  scratchResidue=residue, ownedRoot=str(root), status=0 if len(results) == len(commands) and all(r["status"] == 0 for r in results) and not residue else 1)
report["ownedRootRetired"] = not root.exists()
if not report["ownedRootRetired"]:
    report["status"] = 1
print(json.dumps(report))
