 {id:'conditional-class',defaults:{},options:{class:{active:true,disabled:false,missing:null,zero:0,empty:'',array:[],object:{},'a b':true,'':true}},content:'cake'},
 {id:'class-array-objects',defaults:{},options:{class:['first',{second:true,off:false},['first',null,0,{third:[]}]]},content:'cake'},
 {id:'compound-aria-array',defaults:{},options:{aria:{label:['a',false,null,['',0,{active:true,off:false,'a b':0}]],empty:[false,null,'']}},content:'cake'},
