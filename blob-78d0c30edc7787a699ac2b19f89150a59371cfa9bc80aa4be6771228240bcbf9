const invalid:Array<[string,()=>unknown]>=[['date',()=>new Date(0)],['map',()=>new Map()],['regexp',()=>/x/],['symbol',()=>Symbol('x')],['bigint',()=>1n],['function',()=>()=>0],['undefined',()=>undefined],['infinity',()=>Infinity],['invalid-utf16',()=>'\ud800'],['sparse',()=>new Array(2)],['cycle',()=>{const value:Record<string,unknown>={};value.self=value;return value;}],['accessor',()=>Object.defineProperty({},'value',{enumerable:true,get(){throw Error('getter must not execute');}})]];
