 const s=await createRenderTestStorage();cleanup.push(()=>s.close());await seedCard(s,{id:2,name:'RichText',codename:'basic'});await seedCard(s,{id:500,name:'Portable Example',typeId:2});
 const manifest=defineMod('portable_negative',({set})=>set('all/portable_negative',({format})=>format('html',({wrapper,view})=>{
  wrapper('portable','div');view('negative',{perms:'none'},ctx=>ctx.fmt.callFormatMethod('wrap_with_portable','cake',{title:value()}) as string);
 })));
 const loader=new ModLoader([{manifest}],{});cleanup.push(()=>loader.reset());loader.load();s.engine.modLoader=loader;
 await expect(s.engine.render('Portable Example','negative')).rejects.toMatchObject({name:'UnsupportedModTagAttributeError',message:'Unsupported tag attribute value: title'});
});
const cleanup:Array<()=>void>=[];afterEach(()=>{while(cleanup.length)cleanup.pop()!();});
for(const request of cases)it(`matches original portable attribute shape ${request.id}`,async()=>{
 const s=await createRenderTestStorage();cleanup.push(()=>s.close());await seedCard(s,{id:2,name:'RichText',codename:'basic'});await seedCard(s,{id:500,name:'Portable Example',typeId:2});
 const before=JSON.stringify(request.options);
 const manifest=defineMod('portable_values',({set})=>set('all/portable_values',({format})=>format('html',({wrapper,view})=>{
  wrapper('portable','div',request.defaults);view('portable',{perms:'none'},ctx=>ctx.fmt.callFormatMethod('wrap_with_portable',request.content,request.options) as string);
 })));
 const loader=new ModLoader([{manifest}],{});cleanup.push(()=>loader.reset());loader.load();s.engine.modLoader=loader;
 expect({id:request.id,body:await s.engine.render('Portable Example','portable')}).toEqual(reference.cases.find(c=>c.id===request.id));expect(JSON.stringify(request.options)).toBe(before);
});
