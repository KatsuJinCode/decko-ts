let reference:{baseline:unknown,cases:Array<{id:string,body:string}>};
beforeAll(()=>{
 const r=spawnSync('ruby',[resolve('tests/card/mod-loader/ruby-adversarial-tag-values-probe.rb'),'C:/localProjects/decko-ruby-oracle-gems/ruby/3.4.0/gems'],{windowsHide:true,encoding:'utf8',input:JSON.stringify(cases.map(c=>({...c,tag:'div'}))),maxBuffer:Infinity});
 expect(r.status,r.stderr).toBe(0);reference=JSON.parse(r.stdout);
