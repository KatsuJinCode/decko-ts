const base=fs.mkdtempSync(path.join(tmpdir(),'decko-loaded-source-'));console.log('Owned loaded source controls: '+base);let serial=0;
const sha=b=>createHash('sha256').update(b).digest('hex');
function fixture(extra={}){
 const root=path.join(base,'case '+(++serial));fs.mkdirSync(root);const env=Object.fromEntries(Object.entries(process.env).filter(([key])=>!key.startsWith('GIT_')));Object.assign(env,{GIT_AUTHOR_NAME:'Source Closure Fixture',GIT_AUTHOR_EMAIL:'fixture@example.invalid',GIT_COMMITTER_NAME:'Source Closure Fixture',GIT_COMMITTER_EMAIL:'fixture@example.invalid',GIT_OPTIONAL_LOCKS:'0'});
 const git=args=>{const r=spawnSync('git',args,{cwd:root,env,windowsHide:true,encoding:'utf8'});assert.equal(r.status,0,r.stderr);return r.stdout.trim();};
 const inputs={'src/engine.mjs':'export const fixture=true;\n','vendor/arbitrary-compiled-input.mjs':'throw Error("identity fixture; never execute");\n','package-lock.json':'{"packages":{"":{}}}',...extra};
 git(['init']);for(const [file,body]of Object.entries(inputs)){fs.mkdirSync(path.dirname(path.join(root,file)),{recursive:true});fs.writeFileSync(path.join(root,file),body);}fs.mkdirSync(path.join(root,'node_modules'),{recursive:true});git(['add','--',...Object.keys(inputs)]);git(['commit','-m','Synthetic compiled source identity fixture','--',...Object.keys(inputs)]);
 const pin=git(['rev-parse','HEAD']),source=sourceProfile.inspectMatrixSource(root,pin),closure=sourceProfile.inspectDeclaredRuntime(root),sentinel=path.join(root,'package-lock.json'),bytes=fs.readFileSync(sentinel);
 const profile={source,runtime:{...closure,node:{path:sentinel,physicalPath:fs.realpathSync.native(sentinel),sha256:sha(bytes)},entries:[],nativeInventory:[]},tools:[],obligations:[],caseContract:{file:'src/engine.mjs',sha256:sha(fs.readFileSync(path.join(root,'src/engine.mjs')))}};
 assert.equal(sourceProfile.verifyMatrixProfile(profile),true);return{root,pin,profile,git,vendor:path.join(root,'vendor/arbitrary-compiled-input.mjs')};
}
function record(file){const bytes=fs.readFileSync(file);return{id:file,bytes:bytes.length,sha256:sha(bytes)};}
function proof(f){const entry=record(path.join(f.root,'src/engine.mjs'));return{transforms:[entry],observations:[{event:'input',path:entry.id,bytes:entry.bytes,sha256:entry.sha256}],generatedRoots:[]};}
const verify=(f,loaded=proof(f))=>{assert.equal(typeof sourceProfile.verifyMatrixLoadedSourceCoverage,'function','Missing mechanical loaded-source coverage gate');return sourceProfile.verifyMatrixLoadedSourceCoverage(f.profile,loaded);};
test('arbitrary committed vendor code is part of preflight, not three special-case filenames',()=>{const f=fixture();assert(f.profile.source.files.some(x=>x.path==='vendor/arbitrary-compiled-input.mjs'));});
test('mutation of formerly omitted vendor code invalidates the native Git profile',()=>{const f=fixture();fs.writeFileSync(f.vendor,'throw Error("changed; never execute");');assert.throws(()=>sourceProfile.verifyMatrixProfile(f.profile),/Raw source differs|Source identity/i);});
