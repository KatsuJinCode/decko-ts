GEM_HOME = ENV.fetch("DECKO_ORACLE_GEM_HOME", GEM_HOME_DEFAULT)

OWNERS = [
  { key: "signup_link",
    gem: "card-mod-account-0.20.0",
    path: "set/self/signin.rb",
    marker: "def signup_link", before: 0, after: 3 },
  { key: "reset_password_link",
    gem: "card-mod-account-0.20.0",
    path: "set/self/signin.rb",
    marker: "def reset_password_link", before: 0, after: 3 },
  { key: "signin_button",
    gem: "card-mod-account-0.20.0",
    path: "set/self/signin.rb",
    marker: "def signin_button", before: 0, after: 2 },
  { key: "core_haml",
    gem: "card-mod-account-0.20.0",
    path: "set/self/signin/core.haml",
    marker: ".form-group.signin-buttons", before: 1, after: 6 },
  { key: "or_sign_up_locale",
    gem: "card-mod-account-0.20.0",
    path: "config/locales/en.yml",
    marker: "account_or_sign_up:", before: 0, after: 0 },
  { key: "reset_password_locale",
    gem: "card-mod-account-0.20.0",
    path: "config/locales/en.yml",
    marker: "account_reset_password:", before: 0, after: 0 },
  { key: "sign_in_locale",
    gem: "card-mod-account-0.20.0",
    path: "config/locales/en.yml",
    marker: "account_sign_in:", before: 0, after: 0 },
  { key: "link_to",
    gem: "card-mod-format-0.20.0",
    path: "set/all/links.rb",
    marker: "interpret_data_opts_to_link_to opts", before: 2, after: 2 },
  { key: "link_to_card",
    gem: "card-mod-format-0.20.0",
    path: "set/all/links.rb",
    marker: "add_known_or_wanted_class opts, name", before: 3, after: 1 },
  { key: "link_to_view",
    gem: "card-mod-format-0.20.0",
    path: "set/all/links.rb",
    marker: "super(view, text || view, opts)", before: 2, after: 1 },
  { key: "slotterify",
    gem: "card-mod-format-0.20.0",
    path: "set/all/links.rb",
    marker: "def slotterify opts", before: 0, after: 4 },
  { key: "add_known_or_wanted_class",
    gem: "card-mod-format-0.20.0",
    path: "set/all/links.rb",
    marker: "def add_known_or_wanted_class opts, name", before: 0, after: 5 },
  { key: "new_cardtype",
    gem: "card-mod-format-0.20.0",
