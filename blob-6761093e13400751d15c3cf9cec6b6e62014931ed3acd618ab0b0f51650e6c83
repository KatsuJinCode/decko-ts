import { describe, expect, it } from "vitest";
import { DeploymentDeckOriginError, validateDeploymentDeckOrigin } from "../../src/server/deployment-deck-origin.js";

describe("explicit deployment deck origin admission", () => {
  it("leaves the unset renderer origin unspecified", () => {
    expect(validateDeploymentDeckOrigin(undefined)).toBeUndefined();
  });

  it.each([
    ["https://deck.example", "https://deck.example"],
    ["https://deck.example/", "https://deck.example"],
    ["HTTPS://DECK.EXAMPLE:443/", "https://deck.example"],
    ["http://localhost:3100/", "http://localhost:3100"],
    ["http://127.0.0.1:3100", "http://127.0.0.1:3100"],
    ["https://[::1]:8443/", "https://[::1]:8443"],
  ])("admits and serializes an absolute origin: %s", (input, expected) => {
    expect(validateDeploymentDeckOrigin(input)).toBe(expected);
  });

  it.each([
    null, 0, false, {}, [], "", " ", " https://deck.example", "https://deck.example\n",
    "//deck.example", "/deck", "https:deck.example", "ftp://deck.example", "javascript:alert(1)",
    "https://user@deck.example", "https://user:secret@deck.example", "https://@deck.example",
    "https://deck.example/path", "https://deck.example/.", "https://deck.example/%2e",
    "https://deck.example//", "https://deck.example?", "https://deck.example?x=1",
    "https://deck.example#", "https://deck.example#fragment", "https://deck.example\\path",
    "https://deck.example:99999", "https://", "https://deck'.example", "https://deck<.example",
    "https://deck%27.example", "https://deck%22.example", "https://deck%60.example",
  ])("rejects a configured non-origin without echoing its value: %j", input => {
    expect(() => validateDeploymentDeckOrigin(input)).toThrow(DeploymentDeckOriginError);
    expect(() => validateDeploymentDeckOrigin(input)).toThrow(/^Invalid DECKO_DECK_ORIGIN:/);
    if (typeof input === "string" && input.includes("secret")) {
      try { validateDeploymentDeckOrigin(input); } catch (error) {
        expect(String(error)).not.toContain("secret");
      }
    }
  });
});
