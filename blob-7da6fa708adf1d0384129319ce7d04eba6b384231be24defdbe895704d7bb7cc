import { afterAll, beforeAll, expect, it } from "vitest";
import Database from "better-sqlite3";
import { PGlite } from "@electric-sql/pglite";
import { PostgresDriver, translateSqliteToPostgres } from "../../../src/server/drivers/postgres.js";
import { sqliteToMysql } from "../../../src/server/drivers/mysql.js";
import { freshPglite } from "../../support/fresh-pglite.js";

let client: PGlite, driver: PostgresDriver;
beforeAll(async () => { client = await freshPglite(); driver = new PostgresDriver({ client }); });
afterAll(async () => { await driver?.close(); });

const cases = [
  { label: "VALUES owns its expression", rhs: "n=(VALUES(7)), note=excluded.note" },
  { label: "nested parentheses and SELECT", rhs: "n=((SELECT (SELECT n FROM rhs_source))), note=excluded.note" },
  { label: "CTE shadows outer table name", rhs: "n=(WITH scope_counter(n) AS (VALUES(7)) SELECT n FROM scope_counter), note=excluded.note" },
  { label: "correlated explicit stored row", rhs: "n=(SELECT r.n + scope_counter.n FROM rhs_source AS r), note=excluded.note" },
  { label: "source alias shadows stored table", rhs: "n=(SELECT scope_counter.n FROM rhs_source AS scope_counter), note=excluded.note" },
  { label: "outer read resumes after scalar query", rhs: "n=(SELECT n FROM rhs_source)+n, note=excluded.note", raw: "n=(SELECT n FROM rhs_source)+scope_counter.n, note=excluded.note" },
  { label: "CAST resumes outer assignment", rhs: "n=CAST((SELECT n FROM rhs_source) AS INTEGER)+n, note=excluded.note", raw: "n=CAST((SELECT n FROM rhs_source) AS INTEGER)+scope_counter.n, note=excluded.note" },
  { label: "conflict predicate after local query", rhs: "n=(SELECT n FROM rhs_source) WHERE n < excluded.n", raw: "n=(SELECT n FROM rhs_source) WHERE scope_counter.n < excluded.n" },
  { label: "query comment syntax", rhs: "n=(/* before SELECT */ SELECT n FROM rhs_source), note='SELECT /*literal*/ CURRENT_TIMESTAMP'" },
] as const;

for (const item of cases) {
  it(`preserves real SQLite/PGlite scope: ${item.label}`, async () => {
    const sqlite = new Database(":memory:");
    try {
      const setup = "CREATE TABLE scope_counter(id INTEGER PRIMARY KEY,n INTEGER,note TEXT); CREATE TABLE rhs_source(n INTEGER); INSERT INTO rhs_source VALUES(7); INSERT INTO scope_counter VALUES(1,1,'before');";
      sqlite.exec(setup);
      await client.exec("DROP TABLE IF EXISTS scope_counter; DROP TABLE IF EXISTS rhs_source;" + setup);
      const prefix = "INSERT INTO scope_counter VALUES(1,3,'proposed') ON CONFLICT(id) DO UPDATE SET ";
      const sql = prefix + item.rhs;
      sqlite.exec(sql);
      // Three cases intentionally exercise SQLite's bare outer stored-row
      // reference. Their independent native PostgreSQL control spells only
      // that reference explicitly; raw PostgreSQL would otherwise be ambiguous.
      const native = prefix + ("raw" in item ? item.raw : item.rhs);
      await client.exec(native);
      const expected = sqlite.prepare("SELECT n,note FROM scope_counter").all();
      expect((await client.query("SELECT n,note FROM scope_counter")).rows).toEqual(expected);
      await client.exec("UPDATE scope_counter SET n=1,note='before'");
      let failure: unknown;
      try { await driver.query(sql, []); } catch (error) { failure = error; }
      expect(failure, translateSqliteToPostgres(sql).sql).toBeUndefined();
      expect((await client.query("SELECT n,note FROM scope_counter")).rows).toEqual(expected);
    } finally { sqlite.close(); }
  });
}

for (const keyword of ["CURRENT_DATE", "CURRENT_TIME", "CURRENT_TIMESTAMP"]) {
  it(`keeps temporal syntax and following stored read: ${keyword}`, async () => {
    const sqlite = new Database(":memory:");
    try {
      const setup = "CREATE TABLE temporal_scope(id INTEGER PRIMARY KEY,n INTEGER,note TEXT); INSERT INTO temporal_scope VALUES(1,1,'before');";
      sqlite.exec(setup);
      await client.exec("DROP TABLE IF EXISTS temporal_scope;" + setup);
      const prefix = "INSERT INTO temporal_scope VALUES(1,3,'new') ON CONFLICT(id) DO UPDATE SET ";
      const sql = prefix + `note=${keyword}, n=n+1`;
      sqlite.exec(sql);
      await client.exec(prefix + `note=${keyword}, n=temporal_scope.n+1`);
      await client.exec("UPDATE temporal_scope SET n=1,note='before'");
      await driver.query(sql, []);
      const row = (await client.query<{ n: number; note: string }>("SELECT n,note FROM temporal_scope")).rows[0];
      expect(row?.n).toBe(2);
      expect(row?.note).not.toBe("before");
      // Clocks and timestamp formatting are not cross-runtime equality controls.
    } finally { sqlite.close(); }
  });
}

for (const [label, column, capacity, identifier] of [
  ["line comment around constraints", 'name TEXT(12)-- UNIQUE is below\n UNIQUE', 255, 'name'],
  ["quoted doubled identifier", '"odd""name"/**/TEXT(12)/**/UNIQUE', 255, '"odd""name"'],
  ["quoted comment marker identifier", '"name/*literal*/"/**/TEXT/**/UNIQUE', 255, '"name/*literal*/"'],
  ["backtick comment marker identifier", '`name--literal`/**/TEXT/**/UNIQUE', 255, '`name--literal`'],
  ["bracket comment marker identifier", '[name/*literal*/]/**/TEXT/**/UNIQUE', 255, '[name/*literal*/]'],
  ["throttle comment-separated key", 'scope/**/TEXT(12)/**/PRIMARY/**/KEY', 768, 'scope'],
  ["doubled-quote default remains data", "name TEXT DEFAULT 'a''/* UNIQUE */--b'", 0, 'name'],
  ["constraint words in comment remain nonkeys", "name TEXT/* PRIMARY KEY, UNIQUE */DEFAULT 'key'", 0, 'name'],
] as const) {
  it(`recognizes SQLite lexical boundaries without altering quoted data: ${label}`, () => {
    const table = label.startsWith("throttle") ? "auth_signin_throttle" : "lexical_independent";
    const sql = `CREATE/* table gap */ TABLE ${table}(${column})`;
    const sqlite = new Database(":memory:");
    try {
      sqlite.exec(sql);
      sqlite.prepare(`INSERT INTO ${table}(${identifier}) VALUES(?)`).run("x".repeat(20));
      expect(sqlite.prepare(`SELECT length(${identifier}) n FROM ${table}`).get()).toEqual({ n: 20 });
    } finally { sqlite.close(); }
    const translated = sqliteToMysql(sql);
    expect(translated).toContain(identifier);
    if (capacity) {
      expect(translated).toContain(`VARCHAR(${capacity})`);
      expect(translated).not.toMatch(/VARCHAR\(\d+\)\s*\(12\)/i);
    } else {
      expect(translated).not.toMatch(/VARCHAR/);
      expect(translated).toContain(label.startsWith("doubled") ? "'a''/* UNIQUE */--b'" : "'key'");
    }
    // MySQL evidence is translation shape; no native server is claimed.
  });
}
