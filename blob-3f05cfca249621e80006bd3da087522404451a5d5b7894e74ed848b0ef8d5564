// A checkpoint classifies each framework from its own process, never the combined exit.
import {existsSync,readFileSync,writeFileSync} from 'node:fs';
import {resolve,join,relative,isAbsolute} from 'node:path';
import {fileURLToPath,pathToFileURL} from 'node:url';
import {classify} from '../tools/test-gates.mjs';
import {executePlan,observeRevision,runCommand,testPlan} from './release-check.mjs';

const ROOT=fileURLToPath(new URL('..',import.meta.url));

export function checkpointPlan(root,files){
  if(!Array.isArray(files)||!files.length||files.some(file=>typeof file!=='string'||!file.trim()))
    throw Error('An explicit nonempty correctness test inventory is required');
  const canonical=files.map(file=>{
    const rel=relative(resolve(root),resolve(root,file.replaceAll('\\','/')));
    if(!rel||rel.startsWith('..')||isAbsolute(rel))throw Error('Checkpoint test escapes source root: '+file);
    return rel.replaceAll('\\','/');
  });
  if(new Set(canonical).size!==files.length)throw Error('Duplicate checkpoint test file');
  for(const file of canonical)if(classify(file)!=='correctness')throw Error('Not a correctness test: '+file);
  return testPlan(root,canonical);
}

export async function runCorrectnessCheckpoint({root=ROOT,out,files,execute=runCommand,observe=observeRevision}={}){
  root=resolve(root);
  if(typeof out!=='string'||!out.trim())throw Error('A fresh checkpoint output directory is required');
  out=resolve(out);
  if(existsSync(out))throw Error('Checkpoint output already exists');
  const plan=checkpointPlan(root,files),before=observe(root);
  // executePlan owns process termination, machine evidence and selected-source hashes.
  const rows=await executePlan({root,out,plan,execute});
  const after=observe(root),headUnchanged=before.commit===after.commit;
  const exitCode=rows.every(row=>row.result==='PASS')&&headUnchanged?0:1;
  const stage=framework=>rows.find(row=>row.stage===framework)??{result:'NOT-RUN',reason:'No files selected'};
  const receipt={schema:'decko-correctness-checkpoint/1',source:before.commit,
    scope:'Explicit selected files; not full-suite or release acceptance',
    plan,revisionBefore:before,revisionAfter:after,headUnchanged,rows,
    vitestStage:stage('vitest'),nodeStage:stage('node'),aggregateExitCode:exitCode};
  writeFileSync(join(out,'receipt.json'),JSON.stringify(receipt,null,2)+'\n',{flag:'wx'});
  return {receipt,exitCode};
}

export function checkpointOptions(argv){
  const options={};
  for(let i=0;i<argv.length;i+=2){
    const flag=argv[i],value=argv[i+1];
    if(!['--root','--out','--files-json'].includes(flag)||Object.hasOwn(options,flag)
      ||typeof value!=='string'||!value.trim()||value.startsWith('--'))throw Error('Invalid checkpoint option: '+flag);
    options[flag]=value;
  }
  if(!options['--out']||!options['--files-json'])throw Error('Use --out <fresh directory> --files-json <explicit inventory>');
  return options;
}

if(process.argv[1]&&import.meta.url===pathToFileURL(resolve(process.argv[1])).href){
  try{
    const options=checkpointOptions(process.argv.slice(2));
    const {receipt,exitCode}=await runCorrectnessCheckpoint({root:options['--root']??ROOT,
      out:options['--out'],files:JSON.parse(readFileSync(options['--files-json'],'utf8'))});
    console.log(JSON.stringify(receipt));
    process.exitCode=exitCode;
  }catch(error){console.error('Correctness checkpoint: '+error.message);process.exitCode=1;}
}
