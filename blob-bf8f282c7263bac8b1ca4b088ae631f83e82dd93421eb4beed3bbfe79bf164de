test('graph relationships admit consistent parent edges and separately numbered sibling groups',()=>{
  const events=structuredClone(nativeEvents);
  for(const event of events){const data=event.data;if(data.entryFile&&data.testId===1){if(Object.hasOwn(data,'parentId'))data.parentId=2;if(Object.hasOwn(data,'nesting'))data.nesting=1;}
    else if(data.entryFile&&data.testId>1&&Object.hasOwn(data,'testNumber'))data.testNumber--;
    if(event.type==='test:summary')data.counts.topLevel=6;
    if(event.type==='test:plan')data.count=6;
