#!/usr/bin/env node
// Docs link integrity gate: every relative markdown link and local image
// reference in tracked .md files must resolve to a tracked file (or an
// intentionally-gitignored rebuildable-artifacts path, whitelisted below).
// Absolute URLs are not checked. Re-runnable; exit 1 on broken links.

import { readFileSync, existsSync } from "node:fs";
import { execFileSync } from "node:child_process";
import { join, resolve, dirname, posix } from "node:path";
import { fileURLToPath } from "node:url";

const REPO = resolve(new URL("../../", import.meta.url).pathname.replace(/^\/([A-Za-z]:)/, "$1"));

// Receipts/results paths that are real on disk but gitignored by design —
// docs may reference them as rebuildable artifacts.
const IGNORED_OK = [/^benchmarks\/corpus\//, /^tmp\//, /hygiene\/out\//];

// Vendored upstream source trees, matched from the repository root only.
// Each is an unmodified copy verified byte for byte against its manifest
// (for example third-party-source/tinymce-5.10.7/PROVENANCE.md), so its
// Markdown links belong to upstream and cannot be edited here. This gate
// governs the project's own documentation.
export const VENDORED_PREFIXES = ["third-party-source/"];

const LINK_RE = /\[[^\]]*\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g;

function gitTrackedFiles(repo) {
  return execFileSync("git", ["ls-files", "-z"], { cwd: repo, maxBuffer: 64 * 1024 * 1024, windowsHide: true })
    .toString("utf8").split("\0").filter(Boolean);
}

export function checkDocsLinks(repo = REPO) {
  const trackedList = gitTrackedFiles(repo);
  const tracked = new Set(trackedList);
  const files = trackedList.filter((f) => f.endsWith(".md") && !VENDORED_PREFIXES.some((p) => f.startsWith(p)));
  const broken = [];
  let checked = 0;

  for (const rel of files) {
    let text;
    try { text = readFileSync(join(repo, rel), "utf8"); } catch { continue; }
    let m;
    LINK_RE.lastIndex = 0;
    while ((m = LINK_RE.exec(text)) !== null) {
      const target = m[1];
      if (/^[a-z]+:\/\//i.test(target) || target.startsWith("mailto:") || target.startsWith("#")) continue;
      checked += 1;
      const clean = decodeURIComponent(target.split("#")[0]).replace(/^\.\//, "");
      if (clean === "") continue; // pure-anchor link
      const resolved = posix.join(dirname(rel.split("\\").join("/")), clean);
      if (tracked.has(resolved)) continue;
      if (existsSync(join(repo, resolved)) && IGNORED_OK.some((re) => re.test(resolved))) continue;
      broken.push({ from: rel, target, resolved });
    }
  }
  return { checked, files: files.length, broken };
}

const invokedDirectly = process.argv[1] !== undefined && resolve(process.argv[1]) === fileURLToPath(import.meta.url);
if (invokedDirectly) {
  const { checked, files, broken } = checkDocsLinks(REPO);
  console.log(`# docs link check: ${checked} relative links across ${files} md files, ${broken.length} broken`);
  for (const b of broken.slice(0, 40)) console.log(`  ${b.from}  ->  ${b.target}`);
  if (broken.length > 40) console.log(`  ... ${broken.length - 40} more`);
  process.exitCode = broken.length > 0 ? 1 : 0;
}
