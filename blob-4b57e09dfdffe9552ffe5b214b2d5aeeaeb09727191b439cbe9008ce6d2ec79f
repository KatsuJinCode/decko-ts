require "json"
require "digest"
STDOUT.binmode
gems=ARGV.fetch(0)
Dir.glob(File.join(gems,"*","lib")).each { |lib| $LOAD_PATH.unshift(lib) }
require "active_support"
require "active_support/inflector"
require "active_support/core_ext"
require "cardname"
require File.join(gems,"cardname-1.110.0/lib/core_ext")
class Card
  class Name < Cardname
  end
end
card_lib=File.join(gems,"card-1.110.0/lib")
require File.join(card_lib,"card/name/name_variants")
require File.join(card_lib,"card/name")
rows=[false,true].flat_map do |enabled|
  Card::Name.stabilize=enabled
  Card::Name.reset
  ["matthias","ilias"].map { |input| {enabled:enabled,input:input,key:Card::Name.new(input).key} }
end
sources=["cardname-1.110.0/lib/cardname.rb","cardname-1.110.0/lib/cardname/variants.rb",
         "cardname-1.110.0/spec/lib/cardname_spec.rb"]
puts JSON.pretty_generate({ruby:RUBY_DESCRIPTION,active_support:ActiveSupport.version.to_s,
  sources:sources.to_h { |p| [p,Digest::SHA256.file(File.join(gems,p)).hexdigest] },rows:rows},ascii_only:true)
