// The edge serving host's ASSET-INPUT REFRESH SEAM, driven end to end.
//
// reg-routes-B6's unblock was "the edge host wires the asset-input refresh
// seam". The wiring lives in bunny-edge-engine-handler.ts (the staging
// host's same seam: createReadAssetRefresh + a beforeRead call on every GET
// card request); this suite is the proof the wiring RUNS, not just that the
// strings exist: a real handler request over the real boot, after which the
// refresh's own write (the `style: mods` input row in card_virtuals,
// assembled by CardActionEngine#refreshReadAssetInputs exactly as
// tests/card/actions/style-asset-events-save-path.test.ts drives it
// directly) is read back from the database.
//
// The transport is the same in-process seam the sibling suites use
// (bunny-edge-engine-handler-parity.test.ts): BunnyDbDriver speaks Hrana v2
// over plain fetch, so the test stubs globalThis.fetch with a translator
// over the same local fixture (0001-schema + the deploy seed), and the REAL
// driver and boot run against it. The stub must be installed before the
// first request boots the deck (the driver binds globalThis.fetch at
// construction), which beforeAll guarantees.
//
// DECKO_ASSET_REFRESH=eager for the whole file: the mode that refreshes on
// every request, so the second test's re-attempt is guaranteed instead of
// depending on the :cautious marker's once-per-isolate state. The mode
// selection itself is the seam's own unit-tested contract
// (tests/server/setup-before-action-parity.test.ts, the policy section).

import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { afterAll, beforeAll, describe, expect, it } from "vitest";

import { LocalSqliteDriver } from "../../src/server/drivers/local-sqlite.js";
import { splitSqlStatements } from "../card/render/render-test-storage.js";

const REPO_ROOT = fileURLToPath(new URL("../..", import.meta.url));
const MIGRATIONS = `${REPO_ROOT}deploy/migrations/0001-schema.sql`;
const SEED = `${REPO_ROOT}deploy/seed/seed.sql`;

const CREDENTIAL_ENV = {
  BUNNY_DATABASE_URL: "https://fixture-db.lite.bunnydb.net",
  BUNNY_DATABASE_AUTH_TOKEN: "fixture-token",
};

const EAGER_ENV = {
  ...CREDENTIAL_ENV,
  DECKO_ASSET_REFRESH: "eager",
};

/** Translate BunnyDbDriver's Hrana-v2 pipeline POSTs into local sqlite
 *  queries and encode the results back in the wire shape the driver
 *  decodes. Same translator as bunny-edge-engine-handler-parity.test.ts. */
function makeBunnyFetchStub(driver: LocalSqliteDriver): typeof fetch {
  const encodeCell = (value: unknown): Record<string, unknown> => {
    if (value === null || value === undefined) return { type: "null" };
    if (typeof value === "number") {
      return Number.isInteger(value)
        ? { type: "integer", value: String(value) }
        : { type: "float", value };
    }
    return { type: "text", value: String(value) };
  };
  return (async (_url: URL | RequestInfo, init?: RequestInit): Promise<Response> => {
    const body = JSON.parse(String(init?.body ?? "{}")) as {
      requests: Array<
        | { type: "execute"; stmt: { sql: string; args: Array<Record<string, unknown>> } }
        | { type: "close" }
      >;
    };
    const results = [];
    for (const request of body.requests ?? []) {
      if (request.type !== "execute") {
        results.push({ type: "ok", response: { type: "close" } });
        continue;
      }
      const args = (request.stmt.args ?? []).map((arg) => {
        if (arg.type === "null") return null;
        if (arg.type === "integer") return Number(arg.value);
        if (arg.type === "float") return arg.value;
        return arg.value;
      });
      const result = await driver.query<Record<string, unknown>>(request.stmt.sql, args);
      const cols: string[] = [];
      for (const row of result.rows) {
        for (const key of Object.keys(row)) {
          if (!cols.includes(key)) cols.push(key);
        }
      }
      results.push({
        type: "ok",
        response: {
          type: "execute",
          result: {
            cols: cols.map((name) => ({ name })),
            rows: result.rows.map((row) => cols.map((col) => encodeCell(row[col]))),
            affected_row_count: 0,
          },
        },
      });
    }
    return new Response(JSON.stringify({ results }), {
      status: 200,
      headers: { "content-type": "application/json" },
    });
  }) as typeof fetch;
}

let driver: LocalSqliteDriver | undefined;
let handler: (request: Request, env: Record<string, string | undefined>) => Promise<Response>;

beforeAll(async () => {
  driver = new LocalSqliteDriver({ path: ":memory:" });
  for (const file of [MIGRATIONS, SEED]) {
    const sql = readFileSync(file, "utf8");
    for (const statement of splitSqlStatements(sql)) {
      await driver.query(statement, []);
    }
  }
  const T = "2026-09-20 00:00:00.000";
  const RULE = 30; // the seed's catch-all read rule (*all+*read -> Anyone)
  const insert = (values: string): string =>
    `INSERT INTO cards (\n` +
    `  id, name, key, codename, left_id, right_id, current_revision_id,\n` +
    `  created_at, updated_at, creator_id, updater_id,\n` +
    `  read_rule_class, read_rule_id, references_expired, trash, type_id, db_content\n` +
    `) VALUES (\n${values}\n)`;
  for (const statement of [
    // The page shell's rows, the same set the sibling suite seeds
    // (bunny-edge-engine-handler-parity.test.ts: the demo seed predates the
    // page path, whose *all+*layout assembly resolves exactly these).
    insert(`22745, '*layout', '*layout', 'layout', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 8, NULL`),
    insert(`22748, NULL, NULL, NULL, 25, 22745, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 3, 'Default Layout'`),
    insert(`22759, 'Default Layout', 'default_layout', NULL, NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 22756, '<body class="d-flex flex-column h-100">\n  <header>{{:header|core}}</header>\n  <article class="container flex-shrink-0" role="main">{{_main|titled}}</article>\n  <footer class="footer mt-auto py-3">{{:footer|content}}</footer>\n</body>'`),
    insert(`22750, '*header', '*header', 'header', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 3, '<nav class="navbar navbar-expand-lg"><a class="navbar-brand" href="/">Site</a></nav>'`),
    insert(`22751, '*footer', '*footer', 'footer', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 3, '<footer class="footer mt-auto py-3"><a href="/:latest">Decko v</a></footer>'`),
    insert(`22752, '*title', '*title', 'title', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 3, 'Test Site'`),
    insert(`22753, '*favicon', '*favicon', 'favicon', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 3, '(my_bucket)/103/3649.jpg'`),
    insert(`22754, '*ace', '*ace', 'ace', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 3, '{}'`),
    insert(`22755, '*tiny_mce', '*tiny_mce', 'tiny_mce', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 3, '{}'`),
    insert(`22756, 'Html', 'html', 'html', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 3, NULL`),
    insert(`22757, 'Basic', 'basic', 'basic', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 3, NULL`),
    // The deck bot: the actor the refresh's writes run as (actorBot resolves
    // the card by codename "decko_bot", setup.rb:44's deck invariant). The
    // deploy seed carries Anonymous (id 28) but not the bot, so the seam's
    // own fixture seeds it here.
    insert(`399, 'Decko Bot', 'decko_bot', 'decko_bot', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 4, NULL`),
    // The refresh's own write target: the `style: mods` inputter whose
    // +*asset input is missing, and the *asset input codename card the
    // virtual row keys on (the same shape
    // style-asset-events-save-path.test.ts seeds, List cardtype included:
    // the input assembly's type switch reads the card's type code, and
    // style: mods is a List-typed inputter). A deck with no mod cards
    // assembles the mods input as the empty string, so the write is one
    // card_virtuals row and nothing else: no compiler, no attachment store.
    insert(`402, 'List', 'list', 'list', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 3, NULL`),
    // key 'style_mod': the parse-derived key (DeckoName singularizes the
    // trailing s), what fetchByKey's cardByName lookups resolve.
    insert(`400, 'style: mods', 'style_mod', 'style_mods', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 402, ''`),
    insert(`401, '*asset input', '*asset_input', 'asset_input', NULL, NULL, NULL, '${T}', '${T}', 1, 1, '*all', ${RULE}, NULL, 0, 8, NULL`),
  ]) {
    await driver.query(statement, []);
  }
  // The stub must exist BEFORE the first request boots the deck.
  globalThis.fetch = makeBunnyFetchStub(driver);
  const module = await import("../../deploy/bunny-worker-src/bunny-edge-engine-handler.js");
  handler = module.handleBunnyEngineRequest;
});

afterAll(() => {
  driver?.close();
});

function get(path: string, env: Record<string, string> = EAGER_ENV): Promise<Response> {
  return handler(new Request(`https://decko-edge.test${path}`), env);
}

describe("the edge handler runs the asset-input refresh seam", () => {
  it("a GET card request runs the refresh: the style: mods input virtual materializes", async () => {
    const before = await driver!.query<{ id: number }>(
      "SELECT id FROM card_virtuals WHERE left_id = 400 AND right_id = 401",
      [],
    );
    expect(before.rows).toEqual([]);
    const response = await get("/");
    expect(response.status).toBe(200);
    await response.body?.cancel();
    // The refresh wrote through the engine, as the bot: the inputter's
    // +*asset input row now exists with the assembled (empty) input. This
    // is the row's own evidence shape, the pin the setup before_action
    // captures execute: not "the strings exist" but "the refresh ran".
    const after = await driver!.query<{ id: number; content: string }>(
      "SELECT id, content FROM card_virtuals WHERE left_id = 400 AND right_id = 401",
      [],
    );
    expect(after.rows).toHaveLength(1);
    expect(after.rows[0]?.content).toBe("");
  });

  it("a refresh that throws degrades to the served page, the edge's failure posture", async () => {
    // Take the bot away: the refresh's first statement (actorBot) now
    // raises ActorNotFoundError. Staging answers this shape with a 500; the
    // edge's wiring logs it and serves (the degrade-and-log posture named
    // at the seam's block comment): the request must never fail because
    // deck maintenance failed on a stateless serving isolate.
    await driver!.query("UPDATE cards SET codename = NULL WHERE id = 399", []);
    const response = await get("/Home");
    expect(response.status).toBe(200);
    const body = await response.text();
    expect(body).toContain("Welcome to the decko-ts synthetic demo deck");
  });
});
