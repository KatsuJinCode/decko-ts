  assert.deepEqual(store.fired, ["parent_b", "hook"]);
});

for (const beforeAllowed of [false, true]) {
  test(`a later before-only definition replaces just the before occurrence; gate ${beforeAllowed}`, async () => {
    const gateCalls = [];
    const f = fixture([
      { event: "parent", setPath: "all/parent", label: "parent" },
      { event: "hook", setPath: "all/hook", before: "parent", after: "parent", when: "old_gate", label: "old hook" },
      { event: "hook", setPath: "all/hook", before: "parent", when: "new_gate", label: "latest hook" },
    ], {
      setPaths: ["all/parent", "all/hook"],
      predicates: {
        old_gate: () => { gateCalls.push("old after gate"); return true; },
        new_gate: () => { gateCalls.push("new before gate"); return beforeAllowed; },
      },
    });
    const report = await f.run();
    assert.deepEqual(gateCalls, ["new before gate", "old after gate"]);
    assert.deepEqual(f.calls, beforeAllowed
      ? ["latest hook", "parent", "latest hook"]
      : ["parent", "latest hook"]);
    assert.deepEqual(report.fired, beforeAllowed ? ["hook", "parent", "hook"] : ["parent", "hook"]);
    assert.equal(report.skipped.length, beforeAllowed ? 0 : 1);
    if (!beforeAllowed) assert.equal(report.skipped[0].reason, "when-false");
  });
}

