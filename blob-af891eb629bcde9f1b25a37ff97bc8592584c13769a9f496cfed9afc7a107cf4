test("real ModLoader inventory retains an initially eventless module's first position", async () => {
  const calls = [];
  const loader = new ModLoader([
    { manifest: { name: "inventory_first", setModules: [
      { setPath: "type/basic/a" },
      { setPath: "type/basic/z", events: [
        { event: "audit", at: "validate", fn: () => { calls.push("Z"); } },
      ] },
    ] } },
    { manifest: { name: "inventory_second", setModules: [
      { setPath: "type/basic/a", events: [
        { event: "audit", at: "validate", fn: () => { calls.push("A2"); } },
      ] },
    ] } },
  ], {});
  try {
    loader.load();
    const moduleOrder = loader.eventModuleOrder();
    assert.ok(moduleOrder.setPaths.indexOf("type/basic/a") < moduleOrder.setPaths.indexOf("type/basic/z"));
    assert.deepEqual(loader.eventRegistry().all().map(entry => entry.setPath), ["type/basic/z", "type/basic/a"]);
    const report = await runModEventStage({
      registry: loader.eventRegistry(), moduleOrder, setMember: () => true,
    }, "validate", savingCard, { driver: unexpectedDependency, lexicon: unexpectedDependency });
    assert.deepEqual(calls, ["Z"]);
    assert.deepEqual(report.fired, ["audit"]);
    assert.deepEqual(report.failed, []);
  } finally {
    loader.reset();
  }
});

const concretePaths = [
  "all/base", "type/basic", "right/field", "type_plus_right/project/field", "self/topic",
];
for (let winnerIndex = 1; winnerIndex < concretePaths.length; winnerIndex++) {
  const paths = concretePaths.slice(0, winnerIndex + 1);
  const winner = paths.at(-1);
  test(`concrete module precedence: ${winner} outranks all less specific matching patterns`, async () => {
    const declarations = paths.map(setPath => ({ setPath, label: setPath }));
    // Across mods, a later lower-pattern definition must not defeat an
    // already-included higher-pattern module. All files precede nonbase files.
    if (winnerIndex > 1) {
      declarations.push({ setPath: paths.at(-2), modName: "second_mod", label: "later less specific body" });
    }
    const f = fixture(declarations, { setPaths: paths });
    await f.run();
    assert.deepEqual(f.calls, [winner]);
  });
}

