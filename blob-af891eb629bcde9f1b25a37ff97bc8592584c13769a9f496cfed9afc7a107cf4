for (const receiverBranch of ["changing", "no-current-action"]) {
  test(`${receiverBranch} membership uses complete actual receiver ancestry before attribute membership`, async () => {
    const card = { ...savingCard, typeId: 2, patternTypeId: 1,
      ...(receiverBranch === "no-current-action" ? { currentAction: false } : {}) };
    let membershipCalls = 0;
    const f = fixture([
      { setPath: "type/new/nested", label: "attached new module",
        ...(receiverBranch === "changing" ? { changing: [] } : {}) },
    ], {
      card,
      setMember: () => { membershipCalls++; return false; },
      methodModules: async value => {
        assert.equal(value, card, "ancestry is requested on the original body receiver");
        return ["type/new/nested", "type/old"];
      },
    });
    await f.run();
    assert.deepEqual(f.calls, ["attached new module"]);
    assert.equal(membershipCalls, 0, "attribute buckets must not replace actual module inclusion");
  });
}

