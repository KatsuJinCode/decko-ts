test("retained old-set duplicate methods require actual ancestry after a type change", async () => {
  const f = fixture([
    { setPath: "type/old", label: "retained old body" },
    { setPath: "type/new", label: "assigned new body" },
  ], {
    card: { ...savingCard, typeId: 2, typeIdBeforeAct: 1, patternTypeId: 1 },
    setPaths: ["type/old", "type/new"],
    setMember: (setPath, conditionCard) =>
      (setPath === "type/old" && conditionCard.typeId === 1) ||
      (setPath === "type/new" && conditionCard.typeId === 2),
  });
  await assert.rejects(f.run(), /ancestry.*name\/type change|ancestry.*type change|methodModules/i);
  assert.deepEqual(f.calls, [], "assigned membership cannot reconstruct the original receiver's retained module order");
});

// options.rb:73-80 returns before assigning @stage when before:/after: is
// present. A discarded explicit integration stage cannot rescue a failure
// in a validation parent's callback chain (event.rb:147-155).
for (const kind of ["before", "after"]) {
  test(`relative ${kind} overrides an explicit integration stage and cannot swallow validation failure`, async () => {
    const refusal = new Error("validation hook refused");
    const f = fixture([
      { event: "parent", setPath: "all/parent", label: "parent" },
      { event: "hook", setPath: "all/hook", at: "integrate", [kind]: "parent", label: "hook", body: () => { throw refusal; } },
    ], { setPaths: ["all/parent", "all/hook"] });
    await assert.rejects(f.run(), error => error === refusal);
    assert.deepEqual(f.calls, kind === "before" ? ["hook"] : ["parent", "hook"]);
  });
}

