test("abstract inheritance uses the explicit async card ancestry instead of registration order", async () => {
  let suppliedCard;
  const f = fixture([
    { setPath: "abstract/first", label: "first abstract" },
    { setPath: "abstract/last", label: "last registered abstract" },
  ], {
    setPaths: ["abstract/first", "abstract/last"],
    async methodModules(card) {
      suppliedCard = card;
      return ["abstract/first", "abstract/last"];
    },
  });
  await f.run();
  assert.deepEqual(f.calls, ["first abstract"]);
  assert.equal(suppliedCard, savingCard, "method ancestry belongs to the original saving card");
});

test("callback membership uses the assigned card while explicit method ancestry can retain old modules", async () => {
  const card = { ...savingCard, typeId: 2, typeIdBeforeAct: 1, patternTypeId: 1 };
  let bodyCard;
  const f = fixture([
    { setPath: "type/old", label: "attached old body", body: value => { bodyCard = value; } },
    { setPath: "type/new", label: "new definition" },
  ], {
    card,
    setPaths: ["type/old", "type/new"],
    setMember: (setPath, conditionCard) => setPath === "type/new" && conditionCard.typeId === 2,
    methodModules: async () => ["type/old", "type/new"],
  });
  await f.run();
  assert.deepEqual(f.calls, ["attached old body"]);
  assert.equal(bodyCard, card);
  assert.equal(bodyCard.typeId, 2);
});

