import assert from "node:assert/strict";
import { test } from "node:test";
import "../../support/typescript-source-loader.mjs";
const { runModEventStage } = await import("../../../src/card/mod-loader/mod-event-dispatch.ts");
const { ModEventRegistry } = await import("../../../src/card/mod-loader/mod-event-registry.ts");
const { ModLoader } = await import("../../../src/card/mod-loader.ts");

// Run real repository sources without writing shared dist:
// node --import ./tests/support/typescript-source-loader.mjs --test ./tests/card/mod-loader/mod-event-override-precedence.source.test.mjs
//
// Expected behavior is derived from pinned Ruby sources, not a Ruby run:
// card 1.110.0 lib/card/set/pattern/all.rb:44-46 and
// mod/core/set/all/initialize.rb:61-73 determine module inclusion order;
// lib/card/set/registrar.rb:74-76 retains first Module registration position;
// lib/cardio/mod/loader.rb:61-64 and loader/set_template.rb:11-18 establish
// full normalized constant identity, independent of contributing mod;
// lib/card/set/event.rb:97-100,133-155 separates callback definition from
// method definition and sends the event/body method on the original card;
// lib/card/set/event/callbacks.rb:14-18 captures declaration conditions;
// ActiveSupport 7.2.4 callbacks.rb:273-279,645-662 deduplicates callbacks by
// target-chain/kind/symbol and :899-909 resets redefined inner chains.

const patterns = [
  { code: "self", anchorPartsCount: 1 },
  { code: "type_plus_right", anchorPartsCount: 2 },
  { code: "right", anchorPartsCount: 1 },
  { code: "rule", anchorPartsCount: 0 },
  { code: "rstar", anchorPartsCount: 0 },
  { code: "star", anchorPartsCount: 0 },
  { code: "type", anchorPartsCount: 1 },
  { code: "all_plus", anchorPartsCount: 0 },
  { code: "all", anchorPartsCount: 0 },
];
const unexpectedDependency = new Proxy({}, {
  get(_target, key) {
    throw new Error(`Precedence test unexpectedly accessed dependency ${String(key)}`);
  },
});
const savingCard = {
  name: "Topic+Field", id: 101, key: "topic+field", typeId: 2,
  changedFields: [], act: { action: "update" },
};

function fixture(declarations, options = {}) {
  const registry = new ModEventRegistry();
  const calls = [];
  for (const declaration of declarations) {
    const { label, body, ...entry } = declaration;
    registry.register({
      event: "audit",
      setPath: "all/override_probe",
      modName: "first_mod",
      ...(entry.before === undefined && entry.after === undefined ? { at: "validate" } : {}),
      ...entry,
      fn: card => {
        calls.push(label ?? entry.event ?? "audit");
        return body?.(card);
      },
    });
  }
  const { setPaths, card, ...runtimeOptions } = options;
  const runtime = {
    registry,
    setMember: () => true,
    ...(setPaths === undefined ? {} : { moduleOrder: { patterns, setPaths } }),
    ...runtimeOptions,
  };
  return {
    calls,
    async run(stage = "validate") {
      const report = await runModEventStage(runtime, stage, card ?? savingCard, {
        driver: unexpectedDependency, lexicon: unexpectedDependency,
      });
      assert.deepEqual(report.failed, [], "no integration failure may hide a resolution error");
      return report;
    },
  };
}

test("a single direct-registry declaration remains usable without module metadata", async () => {
  const f = fixture([{ label: "only" }]);
  const report = await f.run();
  assert.deepEqual(f.calls, ["only"]);
  assert.deepEqual(report.fired, ["audit"]);
});

