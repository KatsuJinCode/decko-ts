{
  "comment": "The operation sequence both drives run, in order, on copies of the same start deck. params is the nested Rails params hash; each drive encodes it the same way (bracketed form keys, or multipart when a step uploads). upload values name a file under fixtures/.",
  "steps": [
    {
      "name": "get-home",
      "mod": "core",
      "method": "get",
      "path": "/"
    },
    {
      "name": "get-missing",
      "mod": "core",
      "method": "get",
      "path": "/No_Such_Card"
    },
    {
      "name": "anon-create-card",
      "mod": "permissions",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Probe Card"
        }
      }
    },
    {
      "name": "anon-update-card",
      "mod": "permissions",
      "method": "put",
      "path": "/Parity_Probe_Card",
      "params": {
        "card": {
          "content": "x"
        }
      }
    },
    {
      "name": "anon-delete-missing",
      "mod": "core",
      "method": "delete",
      "path": "/Parity_Probe_Card"
    },
    {
      "name": "anon-create-type",
      "mod": "permissions",
      "method": "post",
      "path": "/type/Phrase",
      "params": {
        "card": {
          "name": "Parity Phrase"
        }
      }
    },
    {
      "name": "signin-blank-email",
      "mod": "account",
      "method": "patch",
      "path": "/update/*signin",
      "params": {
        "card": {
          "subcards": {
            "+*email": {
              "content": ""
            },
            "+*password": {
              "content": "Correct horse battery 1!"
            }
          }
        }
      }
    },
    {
      "name": "signin-blank-password",
      "mod": "account",
      "method": "patch",
      "path": "/update/*signin",
      "params": {
        "card": {
          "subcards": {
            "+*email": {
              "content": "parity.probe@example.com"
            },
            "+*password": {
              "content": ""
            }
          }
        }
      }
    },
    {
      "name": "signin-unknown",
      "mod": "account",
      "method": "patch",
      "path": "/update/*signin",
      "params": {
        "card": {
          "subcards": {
            "+*email": {
              "content": "nobody@example.com"
            },
            "+*password": {
              "content": "Correct horse battery 1!"
            }
          }
        }
      }
    },
    {
      "name": "signin-wrong-password",
      "mod": "account",
      "method": "patch",
      "path": "/update/*signin",
      "params": {
        "card": {
          "subcards": {
            "+*email": {
              "content": "parity.probe@example.com"
            },
            "+*password": {
              "content": "Wrong horse battery 2@"
            }
          }
        }
      }
    },
    {
      "name": "signin-success",
      "mod": "account",
      "method": "patch",
      "path": "/update/*signin",
      "params": {
        "card": {
          "subcards": {
            "+*email": {
              "content": "parity.probe@example.com"
            },
            "+*password": {
              "content": "Correct horse battery 1!"
            }
          }
        }
      }
    },
    {
      "name": "signed-in-read-home",
      "mod": "session",
      "method": "get",
      "path": "/"
    },
    {
      "name": "signed-in-delete-missing",
      "mod": "core",
      "method": "delete",
      "path": "/Never_Was"
    },
    {
      "name": "signed-in-delete-missing-json",
      "mod": "core",
      "method": "delete",
      "path": "/Never_Was.json"
    },
    {
      "name": "signed-in-create-card",
      "mod": "core",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Probe Card",
          "content": "created while signed in"
        }
      }
    },
    {
      "name": "create-duplicate-name",
      "mod": "core",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Probe Card",
          "content": "again"
        }
      }
    },
    {
      "name": "create-blank-name",
      "mod": "core",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "",
          "content": "nameless"
        }
      }
    },
    {
      "name": "create-illegal-name",
      "mod": "core",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity/Slash",
          "content": "x"
        }
      }
    },
    {
      "name": "create-unknown-type",
      "mod": "core",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Typeless",
          "type": "No Such Type"
        }
      }
    },
    {
      "name": "create-number-invalid",
      "mod": "format",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Number Bad",
          "type": "Number",
          "content": "abc"
        }
      }
    },
    {
      "name": "create-number-valid",
      "mod": "format",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Number Good",
          "type": "Number",
          "content": "42"
        }
      }
    },
    {
      "name": "create-json-invalid",
      "mod": "format",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Json Bad",
          "type": "JSON",
          "content": "{bad"
        }
      }
    },
    {
      "name": "create-json-valid",
      "mod": "format",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Json Good",
          "type": "JSON",
          "content": "{\"a\": 1}"
        }
      }
    },
    {
      "name": "create-compound",
      "mod": "core",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Probe Card+Parity Field",
          "content": "field value"
        }
      }
    },
    {
      "name": "signed-in-update-card",
      "mod": "core",
      "method": "put",
      "path": "/Parity_Probe_Card",
      "params": {
        "card": {
          "content": "updated while signed in"
        }
      }
    },
    {
      "name": "rename-to-existing",
      "mod": "core",
      "method": "put",
      "path": "/Parity_Number_Good",
      "params": {
        "card": {
          "name": "Parity Json Good"
        }
      }
    },
    {
      "name": "signed-in-read-json",
      "mod": "core",
      "method": "get",
      "path": "/Parity_Probe_Card.json"
    },
    {
      "name": "upload-file",
      "mod": "carrierwave",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity File",
          "type": "File",
          "file": {
            "upload": "parity-upload.txt",
            "mime": "text/plain"
          }
        }
      }
    },
    {
      "name": "upload-image",
      "mod": "carrierwave",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Image",
          "type": "Image",
          "image": {
            "upload": "parity-image.png",
            "mime": "image/png"
          }
        }
      }
    },
    {
      "name": "signed-in-delete-card",
      "mod": "core",
      "method": "delete",
      "path": "/Parity_Number_Good"
    },
    {
      "name": "reset-unknown-email",
      "mod": "account",
      "method": "patch",
      "path": "/update/*signin",
      "params": {
        "card": {
          "trigger": "send_reset_password_token",
          "subcards": {
            "+*email": {
              "content": "nobody@example.com"
            }
          }
        },
        "success": {
          "view": "reset_password_success"
        }
      }
    },
    {
      "name": "reset-known-email",
      "mod": "account",
      "method": "patch",
      "path": "/update/*signin",
      "params": {
        "card": {
          "trigger": "send_reset_password_token",
          "subcards": {
            "+*email": {
              "content": "parity.probe@example.com"
            }
          }
        },
        "success": {
          "view": "reset_password_success"
        }
      }
    },
    {
      "name": "signout",
      "mod": "account",
      "method": "delete",
      "path": "/delete/*signin"
    },
    {
      "name": "after-signout-write",
      "mod": "permissions",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity After Signout"
        }
      }
    },
    {
      "name": "signup",
      "mod": "account",
      "method": "post",
      "path": "/",
      "params": {
        "card": {
          "name": "Parity Joiner",
          "type": "Sign up",
          "subcards": {
            "+*account": {
              "subcards": {
                "+*email": {
                  "content": "joiner.probe@example.com"
                },
                "+*password": {
                  "content": "Joiner horse battery 4$"
                }
              }
            }
          }
        }
      }
    },
    {
