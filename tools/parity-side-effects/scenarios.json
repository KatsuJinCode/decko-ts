      "name": "restore-file-revision",
      "mod": "carrierwave",
      "method": "put",
      "path": "/Parity_Cached_File",
      "params": {
        "revert_actions": [
          "$create_action:Parity Cached File"
        ],
        "card": {
          "skip": "validate_renaming"
        }
      },
      "deliberate": {
        "why": "Ruby crashes: the history mod calls revision(action, before_action) positionally and card-mod-carrierwave's override takes a keyword (ArgumentError), so restoring an old version of any File or Image card answers 500. The port restores the version, which is what the revert was written to do. The recorded 500 is what a deployed site answers (card-mod-format's server_error view); the recording no longer runs the oracle with Rails' developer error handling, so the page carries no exception message.",
        "ruby": {
          "status": "500",
          "errors": "Wild Card! 500 Server Error Yuck, sorry about that."
        },
        "ts": {
          "status": "303",
          "errors": ""
        },
        "absentIn": "ruby",
        "consequences": [
          "location",
          "writes",
          "actions",
          "stamps",
          "stored",
          "mail",
          "mailText",
          "mailHtml",
          "files"
        ]
      }
    },
