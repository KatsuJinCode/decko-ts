    {
      "name": "admin-deny-signup",
      "mod": "account",
      "method": "delete",
      "path": "/Parity_Joiner",
      "deliberate": {
        "why": "A knock-on of restore-file-revision, not a difference of its own. The delete's configure_successful_deletion redirects to the session's *previous location (card-mod-session set/all/location_history.rb:9-17, env/location_history.rb:19-21). Ruby renders a page on the failed restore — its controller rescue shows the server_error view, whose before: :show_page fires :save_current_location — so /Parity_Cached_File joins the history at restore-file-revision and is the entry this redirect resolves to. The port does not render on that step (it restores the version, the deliberate difference pinned there), so its history still names /Parity_Pending. Every other field agrees; only the redirect target differs, and only because of the earlier step.",
        "ruby": {
          "location": "/Parity_Cached_File"
        },
        "ts": {
          "location": "/Parity_Pending"
        }
      }
    },
