import fs from 'node:fs';
import path from 'node:path';
import cp from 'node:child_process';
import crypto from 'node:crypto';
import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {fileURLToPath} from 'node:url';
import test from 'node:test';
import {scratchDir,removeScratchDir} from '../support/scratch-dir.mjs';
const esbuild=createRequire(import.meta.url)('esbuild');
const repo=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'../..');
const generator=process.env.SEED_CENSUS_GENERATOR_SOURCE??path.join(repo,'tools/oracle/seed-corpus-census.rb');
test('seed census headers preserve synthetic data and exclude private metadata',()=>{
const dir=scratchDir('seed-census-header-');
try {
const sha=b=>crypto.createHash('sha256').update(b).digest('hex');
const records=[],failures=[],outputs=[];
function write(p,b){fs.mkdirSync(path.dirname(p),{recursive:true});fs.writeFileSync(p,b);}
function run(args){const r=cp.spawnSync(process.env.RUBY??'ruby',args,{windowsHide:true,encoding:'utf8',maxBuffer:Infinity});const record={command:[process.env.RUBY??'ruby',...args],status:r.status,signal:r.signal,error:r.error?String(r.error):null,stdout:r.stdout,stderr:r.stderr};records.push(record);assert.equal(r.status,0,r.stderr);assert.equal(r.signal,null);assert.equal(record.error,null);return r.stdout;}
function check(id,fn){try{fn();}catch(e){failures.push({id,message:e.message});}}
const expectedOrder=['defaults','core'];
let referenceCode,referenceData,baseReport;
for(const name of ['private-origin-alpha','private-origin-beta']){
 const gems=path.join(dir,name).replaceAll('\\','/');
 write(gems+'/card-1.110.0/lib/cardio/railtie.rb','config.seed_mods = [:core]\nconfig.seed_type = :real\n');
 write(gems+'/card-mod-defaults-0.20.0/lib/card/mod/defaults.rb','Cardio::Railtie.config.seed_mods.unshift :defaults\n');
 write(gems+'/card-mod-style-0.20.0/set/type/style.rb','read_path(seed_mods.first)\n');
 write(gems+'/card-1.110.0/mod/core/data/fixtures/real/cards.yml','cards_001:\n  name: synthetic one\ncards_002:\n  name: synthetic two\n');
 write(gems+'/card-mod-defaults-0.20.0/data/fixtures/real/cards.yml','cards_001:\ncards_002:\ncards_003:\n');
 write(gems+'/card-mod-defaults-0.20.0/data/fixtures/test/cards.yml','cards_001:\n');
 const jsonText=run([generator,gems]),report=JSON.parse(jsonText),target=path.join(dir,name+'.ts');
 run([generator,gems,target]);const text=fs.readFileSync(target,'utf8');
 check(name+'-private-binding',()=>assert.equal(report.generated_from,gems));
 check(name+'-order',()=>assert.deepEqual(report.seed_mods_order,expectedOrder));
 check(name+'-data',()=>{assert.equal(report.indexed_corpora[0].real.tables.cards,3);assert.equal(report.indexed_corpora[0].test.tables.cards,1);assert.equal(report.indexed_corpora[1].real.tables.cards,2);assert.equal(report.indexed_corpora[1].test,null);});
 check(name+'-privacy',()=>assert.ok(!text.includes(gems)&&!text.includes(name),'Generated header leaks private provenance path'));
 check(name+'-header',()=>assert.equal(text.split(/\r?\n/).slice(0,2).join('\n'),'// GENERATED by tools/oracle/seed-corpus-census.rb from the pinned gemset\n// (the pinned Ruby gem directory); do not edit. Regenerate:'));
 const compiled=esbuild.transformSync(text,{loader:'ts',format:'cjs',legalComments:'none'}).code;
 const data={...report};delete data.generated_from;
 if(referenceCode===undefined){referenceCode=compiled;referenceData=data;baseReport=report;write(dir+'/writer-report.json',jsonText);}
 else{check(name+'-stable-runtime',()=>assert.equal(compiled,referenceCode));check(name+'-stable-data',()=>assert.deepEqual(data,referenceData));}
 outputs.push({id:name,typescriptSha256:sha(text),compiledSha256:sha(compiled),privateReport:report});
}
const writer=fs.readFileSync(generator,'utf8').split('# Emitting TypeScript, not JSON,')[1];assert.ok(writer);
const wrapper=`require 'json'\nsource=File.read(ARGV[0]); marker='# Emitting TypeScript, not JSON,'; pos=source.index(marker); abort 'writer missing' unless pos\nreport=JSON.parse(File.read(ARGV[1])); report['generated_from']=ARGV[2]\nindexed=report['indexed_corpora']; mutations=report['mutations'].map { |m| m.transform_keys(&:to_sym) }; first_consumers=report['seed_mods_first_consumers'].map { |m| m.transform_keys(&:to_sym) }; OUT=ARGV[3]\neval(source[pos..], binding, ARGV[0], source[0...pos].count("\\n")+1)\n`;
const driveC='C'+':',driveD='D'+':';
const metadata=[driveC+'/synthetic-private/one',driveD+'/synthetic-private/two',driveC+'/synthetic-private\nexport const injected_census_metadata = true;\n// tail',driveC+'/synthetic-private\r\nexport const injected_census_metadata = true;\r\n// tail',driveC+'/synthetic-private export const injected_census_metadata = true; // tail',driveC+'/synthetic-private export const injected_census_metadata = true; // tail'];
for(const [i,value]of metadata.entries()){
 const target=path.join(dir,'metadata-'+i+'.ts');run(['-e',wrapper,generator,dir+'/writer-report.json',value,target]);const text=fs.readFileSync(target,'utf8');
 check('metadata-'+i+'-not-emitted',()=>assert.ok(!text.includes('synthetic-private')&&!text.includes('injected_census_metadata'),'Provenance metadata leaks or injects source text'));
 check('metadata-'+i+'-stable-runtime',()=>assert.equal(esbuild.transformSync(text,{loader:'ts',format:'cjs',legalComments:'none'}).code,referenceCode));
 outputs.push({id:'metadata-'+i,typescriptSha256:sha(text),metadataSha256:sha(value),writerSourceSha256:sha('# Emitting TypeScript, not JSON,'+writer)});
}
const result={generator,sourceSha256:sha(fs.readFileSync(generator)),scope:'Two complete synthetic census inputs; six exact writer-stage metadata inputs; no original fixture/capture/gem tree read',records,outputs,failures,passed:failures.length===0,scratch:dir,esbuildVersion:esbuild.version};
if(process.env.SEED_CENSUS_CONTROL_REPORT)fs.writeFileSync(process.env.SEED_CENSUS_CONTROL_REPORT,JSON.stringify(result,null,2)+'\n');
console.log(JSON.stringify({passed:result.passed,processes:records.length,failures:failures.map(f=>f.id),scratch:dir}));
assert.equal(result.passed,true,JSON.stringify(failures));
} finally {
 removeScratchDir(dir);
 assert.equal(fs.existsSync(dir),false,'Owned seed-census scratch must be removed after its Ruby processes exit');
}
});
