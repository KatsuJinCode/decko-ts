test('regression: a partial config write failure retires its owned generated file',async()=>{
 const f=virtualCommand({writeFailure:true}),api=await loadCandidate(f.overrides);
 await assert.rejects(api.command(),/owned partial config write failure/);
 assert.equal(f.writes.size,0,'Failed write left a partially created generated config');
 assert.deepEqual(f.events,['config:create','config:remove']);
});

test('partial write plus failed retirement preserves both errors and starts no framework',async()=>{
 const f=virtualCommand(),writeError=Error('original partial write'),cleanupError=Error('owned cleanup failure');
 f.overrides.writeFileSync=(file,contents)=>{f.events.push('config:create');f.writes.set(file,contents);throw writeError;};
 f.overrides.unlinkSync=file=>{assert(f.writes.has(file));f.events.push('config:remove-failed');throw cleanupError;};
 const api=await loadCandidate(f.overrides);
 await assert.rejects(api.command(),error=>{
  assert(error instanceof AggregateError);
  assert.equal(error.cause,writeError);
  assert.deepEqual(error.errors,[writeError,cleanupError]);
  return true;
 });
 assert.deepEqual(f.events,['config:create','config:remove-failed']);
 assert.equal(f.writes.size,1);
});

test('failed write before creation preserves original error when cleanup finds no file',async()=>{
 const f=virtualCommand(),writeError=Error('write never created config');
 f.overrides.writeFileSync=()=>{f.events.push('config:create-failed');throw writeError;};
 f.overrides.unlinkSync=()=>{f.events.push('config:absent');throw Object.assign(Error('no owned config'),{code:'ENOENT'});};
 const api=await loadCandidate(f.overrides);
 await assert.rejects(api.command(),error=>error===writeError);
 assert.deepEqual(f.events,['config:create-failed','config:absent']);
 assert.equal(f.writes.size,0);
});

test('partial write and falsy cleanup throw retain both thrown values',async()=>{
 const f=virtualCommand();
 f.overrides.writeFileSync=()=>{f.events.push('config:create-failed');throw null;};
 f.overrides.unlinkSync=()=>{f.events.push('config:remove-failed');throw false;};
 const api=await loadCandidate(f.overrides);
 await assert.rejects(api.command(),error=>{
  assert(error instanceof AggregateError);
  assert.equal(error.cause,null);
  assert.deepEqual(error.errors,[null,false]);
  return true;
 });
 assert.deepEqual(f.events,['config:create-failed','config:remove-failed']);
});

test('regression: actual command must fail when its generated config cannot be retired',async()=>{
 const f=virtualCommand();
 f.overrides.unlinkSync=()=>{f.events.push('config:remove-failed');throw Object.assign(Error('owned generated config is locked'),{code:'EBUSY'});};
 const api=await loadCandidate(f.overrides),pending=api.command();
 f.child.emit('close',0,null);f.node.resolve({pass:true,filesExecuted:1});await pending;
 console.log(JSON.stringify({control:'actual-cli-cleanup-failure',exitCode:f.fakeProcess.exitCode??0,remainingConfigs:f.writes.size,logs:f.logs}));
 assert.equal(f.fakeProcess.exitCode,1,'Actual command reports success despite EBUSY and a remaining generated config');
});

for(const phase of ['vitest','node'])for(const payload of [null,undefined,false,0,''])test('independent: synchronous '+phase+' throw '+String(payload)+' still settles the other phase',async()=>{
 const f=fixture();
 if(phase==='vitest')f.dependencies.spawnVitest=()=>{f.events.push('vitest:start');throw payload;};
 else f.dependencies.runNode=()=>{f.events.push('node:start');throw payload;};
 const pending=f.start();await flush();
 assert.deepEqual(f.events,['vitest:start','node:start']);
 f.child.emit('close',0,null);f.node.resolve({pass:true,filesExecuted:1});
 assert.deepEqual(await pending,{vitestStatus:phase==='vitest'?1:0,nodePass:phase==='vitest',cleanupPass:true});
 assert.equal(f.events.at(-1),'cleanup');
});

