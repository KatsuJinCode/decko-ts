import { afterEach, beforeEach, expect, it } from 'vitest';
import { copyFileSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { runRubyRuleProbeOnVm } from "../../support/ruby-source-probe-vm.js";
import { LocalSqliteDriver } from '../../../src/server/drivers/local-sqlite.js';
import { openSameDatabase } from '../../../src/server/same-database.js';
import { FetchEngine } from '../../../src/card/fetch.js';
import { CardActionEngine } from '../../../src/card/actions/card-action-engine.js';
import { actorBot } from '../../../src/card/auth/actor.js';
import { defaultDeckLoader } from '../../../src/card/mod-loader/default-mod-deck.js';
import { observedModEventRuntime } from '../../../src/server/write-routes.js';
import { ModEventRegistry } from '../../../src/card/mod-loader/mod-event-registry.js';
import { ModLoader } from '../../../src/card/mod-loader.js';
import cardModRecaptcha, { recaptchaModEventPredicates } from '../../../src/card/mod-loader/mods/card-mod-recaptcha.js';
import { ruleContentForCard } from '../../../src/card/actions/rule-content-walk.js';
import { scratchDir } from '../../support/scratch-dir.mjs';

// Synthetic local validation with a rejecting fake verifier. These tests use
// two actual local SQLite connections and ordinary administrative saves.
// No live challenge, network request, browser, or external service is used.
let dir: string, database: string, driver: LocalSqliteDriver, other: LocalSqliteDriver;
let fetcher: FetchEngine, reader: FetchEngine, admin: CardActionEngine, book: number, trunk: number;
let loader: ModLoader | undefined;
const observations: unknown[] = [];
const observationDir = scratchDir('rule163-visibility-observations-');
beforeEach(async () => {
  mkdirSync(resolve('tmp'), { recursive: true });
  dir = mkdtempSync(resolve('tmp/security-rule163-visibility-'));
  database = resolve(dir, 'deck.sqlite3');
  copyFileSync(resolve('reference-harness/fixtures/synthetic-v1/deck/deck.sqlite3'), database);
  driver = new LocalSqliteDriver({ path: database });
  await openSameDatabase(driver); defaultDeckLoader();
  fetcher = new FetchEngine(driver); fetcher.installNameEnvironment();
  admin = new CardActionEngine(fetcher, { actor: await actorBot(driver),
    modEvents: await observedModEventRuntime({ driver, fetcher }) });
  book = (await admin.createCard({ name: 'Independent Local Validation', typeName: 'Cardtype' })).cardId;
  const create = await fetcher.fetchByName('*all+*create');
  await admin.updateCard({ cardId: create!.id!, content: '[[Anyone]]' });
  const global = await fetcher.fetchByName('*all+*captcha');
  if (global) await admin.updateCard({ cardId: global.id!, content: '1' });
  else await admin.createCard({ name: '*all+*captcha', content: '1' });
  await admin.createCard({ name: 'Independent Local Validation+*type+*captcha', content: '0' });
  trunk = (await fetcher.fetchByName('Independent Local Validation+*type'))!.id!;
  other = new LocalSqliteDriver({ path: database });
  reader = new FetchEngine(other);
});
afterEach(() => {
  loader?.reset(); loader = undefined;
  other?.close(); driver?.close();
  if (dir) rmSync(dir, { recursive: true });
  writeFileSync(resolve(observationDir, 'visibility.json'), JSON.stringify(observations, null, 2) + '\n');
});
function input() {
  return { name: 'Independent validation attempt', isNew: true,
    typeId: book, typeName: 'Independent Local Validation' };
}
async function anonymousSave(fetch: FetchEngine, connection: LocalSqliteDriver) {
  loader = new ModLoader([{ manifest: cardModRecaptcha }]);
  loader.resolveOrder({ gemMods: ['recaptcha'] }); loader.load();
  let calls = 0;
  const engine = new CardActionEngine(fetch, { actor: null, ipAddress: '192.0.2.7',
    modEvents: { registry: loader.eventRegistry(), predicates: recaptchaModEventPredicates },
    recaptcha: { siteKey: 'synthetic', secretKey: 'synthetic', verify: async () => {
      calls++; return JSON.stringify({ success: false });
    } } });
  let error: unknown;
  try { await engine.createCard({ name: input().name, typeName: input().typeName,
    content: 'synthetic', recaptchaToken: 'synthetic' }); } catch (caught) { error = caught; }
  const rows = (await connection.query('SELECT id FROM cards WHERE name=? AND trash=0', [input().name])).rows;
  observations.push({ test: expect.getState().currentTestName, calls, stored: rows.length,
    error: error instanceof Error ? error.message : null });
  expect(error).toBeInstanceOf(Error);
  expect((error as Error).message).toMatch(/human/);
  expect(calls).toBe(1);
  expect(rows).toEqual([]);
}
it('synthetic local validation: a separate warm reader observes committed administrator retyping', async () => {
  expect(await ruleContentForCard(reader, input(), 'captcha')).toBe('0');
  await admin.updateCard({ cardId: trunk, typeName: 'RichText' });
  expect(await ruleContentForCard(reader, input(), 'captcha')).toBe('1');
  await anonymousSave(reader, other);
});
it('synthetic local validation: a separate warm reader enforces a committed rule content change', async () => {
  expect(await ruleContentForCard(reader, input(), 'captcha')).toBe('0');
  const specific = await fetcher.fetchByName('Independent Local Validation+*type+*captcha');
  await admin.updateCard({ cardId: specific!.id!, content: '1' });
  expect((await other.query<{ db_content: string }>('SELECT db_content FROM cards WHERE id=?', [specific!.id])).rows[0]!.db_content).toBe('1');
  const reference = await runRubyRuleProbeOnVm(database, JSON.stringify({ mode: 'captcha', keys: [`${book}+type`, 'all'], setting: 'captcha' }));
  expect(reference.status, reference.stderr).toBe(0);
  const native = JSON.parse(reference.stdout);
  expect(native.result.value).toBe('1'); expect(native.result.enabled).toBe(true);
  observations.push({ test: expect.getState().currentTestName, native });
  await anonymousSave(reader, other);
}, 120_000);
it('synthetic local validation: explicit receiving-engine refresh sees a committed content change', async () => {
  expect(await ruleContentForCard(reader, input(), 'captcha')).toBe('0');
  const specific = await fetcher.fetchByName('Independent Local Validation+*type+*captcha');
  await admin.updateCard({ cardId: specific!.id!, content: '1' });
  reader.resetCaches();
  await anonymousSave(reader, other);
});
it('synthetic local validation: the saving engine expires its own warmed rule content', async () => {
  expect(await ruleContentForCard(fetcher, input(), 'captcha')).toBe('0');
  const specific = await fetcher.fetchByName('Independent Local Validation+*type+*captcha');
  await admin.updateCard({ cardId: specific!.id!, content: '1' });
  await anonymousSave(fetcher, driver);
});
it('synthetic local validation: rolled-back retyping is isolated and does not poison warm rule state', async () => {
  expect(await ruleContentForCard(fetcher, input(), 'captcha')).toBe('0');
  expect(await ruleContentForCard(reader, input(), 'captcha')).toBe('0');
  const runtime = await observedModEventRuntime({ driver, fetcher });
  const registry = new ModEventRegistry();
  for (const event of runtime.registry.all()) registry.register(event);
  let observed = false;
  registry.register({ event: 'independent_validation_rollback', at: 'finalize', on: ['update'],
    changed: ['type'], setPath: 'all/local_validation', modName: 'local_validation',
    fn: async card => {
      if (card.name !== 'Independent Local Validation+*type') return;
      observed = true;
      expect(await ruleContentForCard(fetcher, input(), 'captcha')).toBe('1');
      expect(await ruleContentForCard(reader, input(), 'captcha')).toBe('0');
      throw new Error('synthetic local rollback');
    } });
  const failing = new CardActionEngine(fetcher, { actor: await actorBot(driver),
    modEvents: { ...runtime, registry } });
  await expect(failing.updateCard({ cardId: trunk, typeName: 'RichText' })).rejects.toThrow('synthetic local rollback');
  expect(observed).toBe(true);
  expect((await driver.query<{ type_id: number }>('SELECT type_id FROM cards WHERE id=?', [trunk])).rows[0]!.type_id)
    .toBe(await fetcher.codenames.id('set'));
  expect(await ruleContentForCard(fetcher, input(), 'captcha')).toBe('0');
  expect(await ruleContentForCard(reader, input(), 'captcha')).toBe('0');
});
