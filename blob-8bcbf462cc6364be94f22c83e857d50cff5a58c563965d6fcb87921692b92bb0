// Coderay-highlighting byte-identity tests.
//
// Each HTML fixture read by loadOracle below was produced by
// `CodeRay.scan(card-content, :LANG).div` on a local Ruby reference (the
// gem at coderay-1.1.3, the card-mod-format/layout/style cardtypes). This
// port must reproduce those bytes exactly for every seeded card; this file
// is the gate.
//
// DECKO-818 mechanical separation: the two shard-gated byte-identity gates
// moved to coderay-byte-identity.corpus.test.ts (the existing on-demand
// corpus gate); the always-runnable unit pins below are unchanged.

import { describe, expect, it } from "vitest";

import {
  highlight,
  langForTypeCode,
  wrapDiv,
} from "../../../../src/card/render/code-highlighting/index.js";
import { coderayEscape } from "../../../../src/card/render/code-highlighting/escape.js";
import { ALPHA_STYLES } from "../../../../src/card/render/code-highlighting/alpha-style.js";

describe("code-highlighting: langForTypeCode dispatch", () => {
  it.each([
    ["json", "json"],
    ["css", "css"],
    ["scss", "css"],
    ["layout_type", "html"],
    ["head", "html"],
    ["java_script", "java_script"],
    ["coffee_script", undefined],
    ["basic", undefined],
    ["search_type", undefined],
    [undefined, undefined],
  ] as const)("maps type_code %s -> %s", (input, expected) => {
    expect(langForTypeCode(input)).toBe(expected);
  });
});

describe("code-highlighting: the java_script :core seam (Corpus Script)", () => {
  // Ground truth: the committed synthetic-v2 oracle capture
  // (reference-harness/fixtures/synthetic-v2/expected/render.jsonl.gz, op
  // core:anonymous:Corpus Script). Ruby: card-mod-script
  // set/abstract/00_script.rb:73-76 `view :core { process_content
  // highlight(render_raw) }` with highlight = `::CodeRay.scan(script,
  // :js).div`; the content carries no [[link]]/{{nest}} chunks, so the
  // highlighted DIV is the whole view body and a full-block pin is exact.
  const CORPUS_SCRIPT_CONTENT = "/* corpus script */\nwindow.corpusMarker = 1;\n";
  const CORPUS_SCRIPT_ORACLE_DIV =
    '<div class="CodeRay">\n  <div class="code"><pre><span style="color:#777">/* corpus script */</span>\nwindow.corpusMarker = <span style="color:#00D">1</span>;\n</pre></div>\n</div>\n';

  it("highlight(content, :java_script) reproduces the committed oracle DIV byte-for-byte", () => {
    expect(highlight(CORPUS_SCRIPT_CONTENT, "java_script")).toBe(CORPUS_SCRIPT_ORACLE_DIV);
  });

  it("the oracle bytes carry the comment and integer spans the passthrough dropped (pin sanity)", () => {
    // alpha.rb:43 .comment { color:#777 }, alpha.rb:69 .integer { color:#00D }
    expect(CORPUS_SCRIPT_ORACLE_DIV).toContain('<span style="color:#777">/* corpus script */</span>');
    expect(CORPUS_SCRIPT_ORACLE_DIV).toContain("<span style=\"color:#00D\">1</span>");
  });
});

describe("code-highlighting: escape + DIV template shape", () => {
  it("escapes HTML entities and control codes per CodeRay", () => {
    expect(coderayEscape("<&>\"")).toBe("&lt;&amp;&gt;&quot;");
    expect(coderayEscape("\n")).toBe("\n"); // 0x0A not in the escape set
    expect(coderayEscape("\x00")).toBe(" ");
    expect(coderayEscape("\t")).toBe("        "); // tab -> 8 spaces
  });

  it("wraps a scan in the CodeRay DIV template", () => {
    expect(wrapDiv("XYZ")).toBe(
      "<div class=\"CodeRay\">\n  <div class=\"code\"><pre>XYZ</pre></div>\n</div>\n",
    );
  });

  it("alpha theme table covers the kinds the corpus fixtures exercise", () => {
    const kinds = new Set(ALPHA_STYLES.map((e) => e.kind));
    expect(kinds.has("error")).toBe(true);
    expect(kinds.has("tag")).toBe(true);
    expect(kinds.has("doctype")).toBe(true);
    expect(kinds.has("inline")).toBe(true);
  });
});
