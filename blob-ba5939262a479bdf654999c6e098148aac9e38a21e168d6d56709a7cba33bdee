// Check that the loader's TypeScript transform can handle every tracked source file the
// capture could load, before a capture is attempted.
//
//   node precheck-transform.mjs
//
// Run it from the checkout being measured. It applies the same transform the source
// loader uses — oxc through rolldown/utils, lang ts, target es2022 — to every tracked
// .ts file, and reports any file the transform cannot handle or would need helpers for.
// It reads only, changes no file, and contacts no service.
import { execFileSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { pathToFileURL } from 'node:url';

const repo = process.cwd();
const require = createRequire(process.env.DECKO_COMPARISON_DEPENDENCY_ROOT
  ? pathToFileURL(process.env.DECKO_COMPARISON_DEPENDENCY_ROOT + '/package.json') : pathToFileURL(repo + '/package.json'));
const { transformSync } = require('rolldown/utils');
const files = execFileSync('git', ['ls-files', '--', 'src', 'tests', 'deploy', 'tools', 'db', 'reference-harness'],
  { cwd: repo, encoding: 'utf8', windowsHide: true }).split('\n').filter(file => file.endsWith('.ts'));
const failures = [];
const helpers = [];
for (const file of files) {
  try {
    const result = transformSync(file, readFileSync(repo + '/' + file, 'utf8'), { lang: 'ts', target: 'es2022' });
    if (result.errors?.length) failures.push({ file, message: JSON.stringify(result.errors).slice(0, 200) });
    else if (result.helpersUsed?.length) helpers.push({ file, helpers: result.helpersUsed });
  } catch (error) {
    failures.push({ file, message: error.message.split('\n')[0] });
  }
}
console.log(JSON.stringify({ checked: files.length, failed: failures.length, helperNeeding: helpers.length,
  failures: failures.slice(0, 20), helpers: helpers.slice(0, 10) }, null, 2));
if (failures.length || helpers.length) process.exitCode = 1;
