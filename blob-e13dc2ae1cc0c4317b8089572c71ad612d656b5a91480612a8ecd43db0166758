// Reproducible, allowlisted extraction of the official free npm distribution.
import { createHash } from "node:crypto";
import { gunzipSync } from "node:zlib";
import { mkdirSync, writeFileSync } from "node:fs";
const version = "6.7.2";
const url = `https://registry.npmjs.org/@fortawesome/fontawesome-free/-/fontawesome-free-${version}.tgz`;
const integrity = "JUOtgFW6k9u4Y+xeIaEiLr3+cjoUPiAuLXoyKOJSia6Duzb7pq+A76P9ZdPDoAoxHdHzq6gE9/jKBGXlZT8FbA==";
const response = await fetch(url);
if (!response.ok) throw new Error(`official package HTTP ${response.status}`);
const archive = Buffer.from(await response.arrayBuffer());
if (createHash("sha512").update(archive).digest("base64") !== integrity) throw new Error("package integrity mismatch");
const wanted = new Set(["LICENSE.txt", "css/all.min.css", ...["brands-400", "regular-400", "solid-900", "v4compatibility"].flatMap(face => ["woff2", "ttf"].map(ext => `webfonts/fa-${face}.${ext}`))]);
const tar = gunzipSync(archive), assets = {}, files = [];
const root = new URL(`../../vendor/fontawesome-free-${version}/`, import.meta.url);
mkdirSync(root, { recursive: true });
for (let offset = 0; offset + 512 <= tar.length;) {
  const name = tar.subarray(offset, offset + 100).toString().replace(/\0.*$/, "");
  if (!name) break;
  const size = parseInt(tar.subarray(offset + 124, offset + 136).toString().replace(/\0.*$/, "").trim(), 8) || 0;
  const relative = name.replace(/^package\//, "");
  if (wanted.has(relative)) {
    const bytes = tar.subarray(offset + 512, offset + 512 + size);
    const sha256 = createHash("sha256").update(bytes).digest("hex");
    files.push({ path: relative, bytes: size, sha256 });
    wanted.delete(relative);
    if (relative === "LICENSE.txt") writeFileSync(new URL(relative, root), bytes);
    else assets[relative] = { base64: bytes.toString("base64"), sha256, contentType: relative.endsWith(".css") ? "text/css; charset=utf-8" : relative.endsWith(".woff2") ? "font/woff2" : "font/ttf" };
  }
  offset += 512 + Math.ceil(size / 512) * 512;
}
if (wanted.size) throw new Error(`missing package files: ${[...wanted]}`);
writeFileSync(new URL("assets.js", root), `// Exact official package bytes, generated by tools/assets/vendor-fontawesome.mjs.\nexport const assets = ${JSON.stringify(assets)};\n`);
writeFileSync(new URL("assets.d.ts", root), "export const assets: Readonly<Record<string, {base64: string; sha256: string; contentType: string}>>;\n");
writeFileSync(new URL("provenance.json", root), JSON.stringify({ package: "@fortawesome/fontawesome-free", version, url, integrity: `sha512-${integrity}`, files }, null, 2) + "\n");
console.log(JSON.stringify({ version, files: files.length, bytes: files.reduce((n, file) => n + file.bytes, 0) }));
