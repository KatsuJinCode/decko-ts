# TEMPLATE — the public reverse proxy in front of the decko-bunny-origin
# Node service running on 127.0.0.1:3200. The one deployment-specific value
# is a placeholder documented where it appears; everything else is the shape
# the origin needs.
#
# The Bunny CDN pull zone's origin URL points at this listener (for status
# checks and page pulls alike, e.g. http://ORIGIN_PUBLIC_ADDRESS:3001/_status).
# Keep the upstream loopback-only; this listener is the only external surface.

server {
    listen 3001 default_server;
    listen [::]:3001 default_server;
    server_name _;

    access_log /var/log/nginx/bunny-origin.access.log;
    error_log  /var/log/nginx/bunny-origin.error.log;

    location / {
        proxy_pass http://127.0.0.1:3200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        # Path safety — the upstream decodes the URL the engine-canonical
        # way; keep the proxy dumb.
    }
}

# ORIGIN_PUBLIC_ADDRESS (named above): the origin host's public IP or DNS
# name — the address configured as the pull zone's origin URL in the Bunny
# dashboard. The cloud firewall / security list must allow inbound TCP to
# this port from Bunny's edge address range.
