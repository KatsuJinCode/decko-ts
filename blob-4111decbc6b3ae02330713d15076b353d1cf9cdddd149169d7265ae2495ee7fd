import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import net from 'node:net';
import {spawn} from 'node:child_process';
import {createHash, randomBytes} from 'node:crypto';
import {fileURLToPath, pathToFileURL} from 'node:url';
import Database from 'better-sqlite3';

const root = fileURLToPath(new URL('../..', import.meta.url));
const fixture = path.join(root, 'reference-harness/fixtures/synthetic-v1/deck/deck.sqlite3');
const digest = bytes => createHash('sha256').update(bytes).digest('hex');

for (const kind of ['record', 'autocomplete', 'signed visitor']) test(`the actual Node ${kind} path observes permission freshness inside its error boundary`, async () => {
  const isRecord = kind !== 'autocomplete';
  const signedVisitor = kind === 'signed visitor';
  const fixtureHash = digest(fs.readFileSync(fixture));
  const directory = fs.mkdtempSync(path.join(root, '.runtime/staging-request-freshness-'));
  const databasePath = path.join(directory, 'deck.sqlite3');
  fs.copyFileSync(fixture, databasePath);
  const seeded = new Database(databasePath);
  seeded.prepare('UPDATE cards SET db_content=? WHERE name=?').run('PRIVATE-FRESHNESS-CONTROL', 'Topic 001');
  if (signedVisitor) seeded.prepare('INSERT INTO cards(id,name,key,type_id,db_content,trash,creator_id,updater_id,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?,?)').run(990001, 'Freshness Synthetic Actor', 'freshness_synthetic_actor', 2, '', 0, 1, 1, '2026-10-29 12:00:00', '2026-10-29 12:00:00');
  seeded.close();
  const reservation = net.createServer();
  await new Promise((resolve, reject) => { reservation.once('error', reject); reservation.listen(0, '127.0.0.1', resolve); });
  const port = reservation.address().port;
  await new Promise((resolve, reject) => reservation.close(error => error ? reject(error) : resolve()));
  const base = `http://127.0.0.1:${port}`;
  const environment = {...process.env};
  for (const name of Object.keys(environment)) if (/^(DECKO_|HARNESS_)/.test(name) || name === 'COMPILED_ASSETS_DIR') delete environment[name];
  Object.assign(environment, { DECKO_DECK_PROFILE: 'stock', DECKO_ASSET_REFRESH: 'never', DECKO_WRITE_PATH: '0', DECKO_ORIGIN: base, DECKO_FILES_DIR: path.join(directory, 'files') });
  let requestHeaders;
  if (signedVisitor) {
    const {encodeAuthToken} = await import(pathToFileURL(path.join(root, 'dist/src/card/auth/token.js')).href);
    const {visitorSessionCookie} = await import(pathToFileURL(path.join(root, 'dist/src/card/session/visitor-session.js')).href);
    const secret = randomBytes(32).toString('hex');
    environment.DECKO_TOKEN_SECRET = secret;
    requestHeaders = {authorization: 'Token ' + await encodeAuthToken({secret}, 990001), cookie: visitorSessionCookie({cards: {_card_synthetic_unused: 'synthetic-selection'}}).split(';')[0]};
  }
  const arguments_ = ['--import', pathToFileURL(path.join(root, 'tests/support/loopback-fetch-only.mjs')).href, path.join(root, 'vm-staging-server.mjs'), databasePath, String(port)];
  const child = spawn(process.execPath, arguments_, { cwd: root, env: environment, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] });
  let output = '', listening = false;
  const closed = new Promise((resolve, reject) => { child.once('error', reject); child.once('exit', (code, signal) => resolve({code, signal})); });
  const ready = new Promise((resolve, reject) => {
    const deadline = setTimeout(() => reject(Error('Node host failed to announce listening')), 30000);
    child.stdout.on('data', bytes => { output += bytes; if (!listening && output.includes('listening on')) { listening = true; clearTimeout(deadline); resolve(); } });
    child.stderr.on('data', bytes => { output += bytes; });
    child.once('error', error => { clearTimeout(deadline); reject(error); });
    child.once('exit', code => { if (!listening) { clearTimeout(deadline); reject(Error(`Node host exited before listening: ${code}\n${output}`)); } });
  });
  let database;
  const responses = [];
  async function probe() {
    const resource = isRecord ? '/Topic_001.json' : '/*all+by_name.json?view=name_match&term=Topic';
    const response = await fetch(base + resource, {headers: requestHeaders, redirect: 'manual', signal: AbortSignal.timeout(10000)});
    const body = await response.text();
    const receipt = {resource, status: response.status, body};
    responses.push(receipt);
    return receipt;
  }
  function setParty(codename) {
    const party = database.prepare('SELECT id,name FROM cards WHERE codename=?').get(codename);
    const rule = database.prepare('SELECT read_rule_id FROM cards WHERE name=?').get('Topic 001').read_rule_id;
    database.transaction(() => {
      database.prepare('UPDATE cards SET db_content=? WHERE id=?').run(party.name, rule);
      database.prepare('DELETE FROM card_references WHERE referer_id=?').run(rule);
      database.prepare("INSERT INTO card_references(referer_id,referee_id,referee_key,ref_type) VALUES(?,?,?,'L')").run(rule, party.id, party.name.toLowerCase().replaceAll(' ', '_'));
    })();
  }
  try {
    await ready;
    database = new Database(databasePath);
    const before = await probe();
    assert.equal(before.status, 200, JSON.stringify(before));
    if (isRecord) {
      assert.equal(JSON.parse(before.body).name, 'Topic 001');
      assert.equal(JSON.parse(before.body).db_content, 'PRIVATE-FRESHNESS-CONTROL');
    }
    else assert.ok(JSON.parse(before.body).length > 0, before.body);
    if (!signedVisitor) {
      setParty('anyone_signed_in');
      const revoked = await probe();
      if (isRecord) {
        assert.equal(revoked.status, 403, JSON.stringify(revoked));
        assert.equal(JSON.parse(revoked.body).db_content, undefined);
        assert.equal(revoked.body.includes('PRIVATE-FRESHNESS-CONTROL'), false);
      } else {
        assert.equal(revoked.status, 200);
        assert.deepEqual(JSON.parse(revoked.body), []);
      }
      setParty('anyone');
      const restored = await probe();
      assert.equal(restored.status, 200);
      if (isRecord) assert.equal(JSON.parse(restored.body).name, 'Topic 001');
      else assert.ok(JSON.parse(restored.body).length > 0);
    }
    database.exec('DROP TABLE deck_data_version');
    const missingStamp = await probe();
    assert.equal(missingStamp.status, 500, 'Missing freshness state must fail visibly inside the request boundary');
    assert.equal(missingStamp.body.includes('PRIVATE-FRESHNESS-CONTROL'), false);
    assert.equal((await probe()).status, 500, 'Host must remain running after the caught error');
  } finally {
    database?.close();
    let shutdownFailure;
    if (child.exitCode === null) {
      try {
        const response = await fetch(base + '/_shutdown', {method: 'POST', headers: {origin: base}, signal: AbortSignal.timeout(10000)});
        assert.equal(response.status, 200, 'Own Node host must accept graceful shutdown');
      } catch (error) {
        shutdownFailure = error;
        if (child.exitCode === null) {
          assert.deepEqual(child.spawnargs, [process.execPath, ...arguments_]);
          process.kill(child.pid, 0);
          child.kill('SIGTERM'); // This session's exact owned synthetic host.
        }
      }
    }
    const exit = await closed;
    console.log(JSON.stringify({kind, owner: {pid: child.pid, executable: process.execPath, arguments: arguments_, windowsHide: true}, credentials: signedVisitor ? 'Ephemeral fixture token and visitor cookie not recorded' : 'anonymous', source: digest(fs.readFileSync(path.join(root, 'vm-staging-server.mjs'))), dist: JSON.parse(fs.readFileSync(path.join(root, '.runtime/browser-build.json'), 'utf8')), exit, shutdownFailure: shutdownFailure?.message ?? null, responses}));
    assert.equal(digest(fs.readFileSync(fixture)), fixtureHash, 'Original fixture must remain unchanged');
    assert.equal(path.dirname(directory), path.resolve(root, '.runtime'));
    assert.ok(path.basename(directory).startsWith('staging-request-freshness-'));
    fs.rmSync(directory, {recursive: true});
    assert.deepEqual(exit, {code: 0, signal: null}, output);
    if (shutdownFailure) throw shutdownFailure;
  }
});
