#!/usr/bin/env node
// benchmarks/speed/render-docs.mjs — write docs/speed.md from a run record
// of benchmarks/speed/run.mjs. The numbers in that page come only from the
// record named on the command line.
//
//   node benchmarks/speed/render-docs.mjs benchmarks/speed/runs/<run>.json

import { readFileSync, writeFileSync } from "node:fs";
import { join, relative, resolve } from "node:path";
import { ROOT } from "./servers.mjs";

const file = resolve(process.argv[2]);
const rec = JSON.parse(readFileSync(file, "utf8"));
const rel = relative(ROOT, file).replace(/\\/g, "/");
const NAME = { ruby: "Ruby Decko 0.20.0 (Puma, production)", node: "port, Node host", workerd: "port, workerd + D1" };
const n = (x) => (x === null || x === undefined ? "–" : Number(x).toFixed(x >= 100 ? 0 : 1));
const median = (xs) => {
  const s = xs.filter((x) => x !== null && x !== undefined).sort((a, b) => a - b);
  return s.length ? s[Math.floor((s.length - 1) / 2)] : null;
};

const hops = [...new Set(rec.runs.map((r) => r.hop_ms))];
const L = [];
L.push("# Speed: the port against Ruby Decko");
L.push("");
L.push(`Generated by \`benchmarks/speed/render-docs.mjs\` from the run record \`${rel}\` (measured ${rec.started.slice(0, 10)}, commit ${rec.commit?.slice(0, 10)}${rec.dirty ? ", with uncommitted changes" : ""}). Every number below is from that file.`);
L.push("");
L.push("## What was measured");
L.push("");
L.push(`The same ${rec.pages.length} pages of the synthetic-v1 deck (\`reference-harness/fixtures/synthetic-v1\`), requested anonymously: ${rec.pages.map((p) => `\`${p}\``).join(", ")}.`);
L.push("");
L.push("Three servers, each on its own copy of the deck:");
L.push("");
L.push("- **Ruby Decko 0.20.0** (card 1.110.0), the stock oracle app (`reference-harness/oracle/app`) under Puma in production mode, through `benchmarks/speed/ruby/config.ru`.");
L.push("- **The port's Node host** (`benchmarks/speed/node-host.ts`): the edge deck boot and edge request handler over node:sqlite.");
L.push("- **The port in workerd** (`benchmarks/speed/worker-entry.ts`, built with the deploy bundle's esbuild settings) over a local D1 in Miniflare: Cloudflare's runtime and Cloudflare's database API, on this machine.");
L.push("");
L.push(`One client (${rec.client.kind}; Node ${rec.client.node}) on the same machine (${rec.machine.cpu}, ${rec.machine.cpus} logical CPUs, ${rec.machine.mem_gb} GB, ${rec.machine.platform}). For each server:`);
L.push("");
L.push("- **first request**: the first request after the server listens (for the port, the deck boot).");
L.push("- **cold**: each page once, the first time it is asked for.");
L.push(`- **warm**: each page ${rec.client.warm} times in sequence; p50 and p95.`);
L.push(`- **throughput**: ${rec.client.concurrency} concurrent clients cycling through the pages for ${rec.client.duration_s} s.`);
L.push("");
L.push("**Simulated database distance.** At the edge the application runs near the visitor and the database does not, so every database round trip crosses a network. Each server holds every round trip a fixed time before it is sent: the port per driver call (a batch of statements is one trip, as on D1 and libSQL), Ruby per SQL statement ActiveRecord sends. `trips` is the count each server reports in `X-Decko-Db-Trips`. Hop 0 is a database on the same machine.");
L.push("");
for (const hop of hops) {
  const runs = rec.runs.filter((r) => r.hop_ms === hop);
  L.push(`## ${hop === null ? "Hosted" : `Database hop ${hop} ms`}`);
  L.push("");
  L.push("| server | first request ms | cold median ms | warm p50 median ms | warm p95 max ms | throughput req/s | throughput p50 / p95 ms | errors |");
  L.push("|---|---:|---:|---:|---:|---:|---:|---:|");
  for (const r of runs) {
    L.push(
      `| ${NAME[r.target] ?? r.target} | ${n(r.first_request_ms)} | ${n(median(r.cold.map((c) => c.ms)))} | ${n(median(r.warm.map((w) => w.p50_ms)))} | ${n(Math.max(...r.warm.map((w) => w.p95_ms)))} | ${n(r.throughput.rps)} | ${n(r.throughput.p50_ms)} / ${n(r.throughput.p95_ms)} | ${r.throughput.errors} |`,
    );
  }
  L.push("");
  L.push("Per page (cold ms / warm p50 ms / trips per warm request):");
  L.push("");
  L.push(`| page | ${runs.map((r) => NAME[r.target] ?? r.target).join(" | ")} |`);
  L.push(`|---|${runs.map(() => "---:").join("|")}|`);
  for (const page of rec.pages) {
    const cells = runs.map((r) => {
      const c = r.cold.find((x) => x.page === page);
      const w = r.warm.find((x) => x.page === page);
      return `${n(c?.ms)} / ${n(w?.p50_ms)} / ${w?.trips ?? "–"}`;
    });
    L.push(`| \`${page}\` | ${cells.join(" | ")} |`);
  }
  L.push("");
}

// Bytes: the two port targets must serve identical bodies (slot ids masked).
const portRuns = rec.runs.filter((r) => r.target === "node" || r.target === "workerd");
const shas = new Map();
for (const r of portRuns) for (const w of r.warm) (shas.get(w.page) ?? shas.set(w.page, new Set()).get(w.page)).add(w.sha);
const portSame = [...shas.values()].every((s) => s.size === 1);
L.push("## Bytes served");
L.push("");
L.push(`The Node host and the workerd Worker served ${portSame ? "byte-identical bodies on every page, at every hop" : "DIFFERENT bodies on at least one page"} (sha256 with the per-render \`data-slot-id\` masked, recorded per page in the run record).`);
L.push("");
L.push("Ruby here runs in production mode, whose pages differ from the development-mode captures the parity grade compares against (asset links and the production head, for example), so its byte counts are not the port's. Rendering parity is measured separately: `reference-harness/grade-reports/` and `docs/parity-method.md`.");
L.push("");
L.push("## Reproduce");
L.push("");
L.push("```");
L.push("npm ci --ignore-scripts          # the port needs no native addon here (node:sqlite)");
L.push("node benchmarks/speed/build.mjs");
L.push("# Ruby: GEM_HOME/GEM_PATH must hold the gems of benchmarks/speed/ruby/Gemfile.lock");
L.push("#   (the oracle's gems plus Puma: gem install puma; bundle install)");
L.push(rec.command);
L.push(`node benchmarks/speed/render-docs.mjs ${rel}`);
L.push("```");
L.push("");
L.push("## Running it against a hosted edge");
L.push("");
L.push("The same client measures a deployed Worker or edge script with `--url name=<base url>` (repeatable; no hop is simulated, the network is real). The deck must be synthetic-v1:");
L.push("");
L.push("```");
L.push("# Cloudflare: the Worker of benchmarks/speed/worker-entry.ts over a D1 holding synthetic-v1");
L.push("npx wrangler d1 create decko-speed");
L.push("npx wrangler d1 execute decko-speed --remote --file <synthetic-v1 deck dumped as SQL>");
L.push("npx wrangler deploy tmp/speed/worker.mjs --name decko-speed --compatibility-date 2026-09-01 \\");
L.push("  --compatibility-flags nodejs_compat --no-bundle    # with the D1 binding DB in its wrangler config");
L.push("node benchmarks/speed/run.mjs --url cloudflare=https://decko-speed.<account>.workers.dev \\");
L.push("  --url bunny=https://<pull zone>.b-cdn.net --warm 20 --duration 10 --concurrency 8");
L.push("```");
L.push("");
L.push("A hosted run spends the account's request and database quota; it is not run by this repository's tests.");
L.push("");
writeFileSync(join(ROOT, "docs/speed.md"), L.join("\n"));
console.log("docs/speed.md");
