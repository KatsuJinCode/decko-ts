import { expect, it } from "vitest";
import { BunnyDbDriver } from "../../../src/card/drivers/bunny-db.js";
import { startMockHranaServer } from "../../server/drivers/mock-hrana-server.js";
import { DatabaseOutcomeUnknownError } from "../../../src/server/driver.js";

it.each(["query", "batch"] as const)("keeps read-only %s retries after a consumed response is lost", async (method) => {
  const server = await startMockHranaServer();
  let attempts = 0;
  try {
    const faultFetch: typeof fetch = async (url, init) => {
      attempts += 1;
      const response = await fetch(url, init);
      if (attempts === 1) {
        await response.arrayBuffer();
        throw new TypeError("injected read response reset");
      }
      return response;
    };
    const driver = new BunnyDbDriver({ url: server.url, fetchImpl: faultFetch });
    const result = method === "query" ? await driver.query("SELECT 7 AS n", []) :
      (await driver.batch([{ sql: "SELECT 7 AS n", params: [] }]))[0];
    expect(result.rows).toEqual([{ n: 7 }]);
    expect(attempts).toBe(2);
  } finally { await server.close(); }
});

it("invalidates a read phase after an unknown standalone mutation", async () => {
  const server = await startMockHranaServer();
  try {
    let loseWriteReply = false;
    const faultFetch: typeof fetch = async (url, init) => {
      const response = await fetch(url, init);
      if (loseWriteReply && String(init?.body).includes("UPDATE phase_counter")) {
        loseWriteReply = false;
        await response.arrayBuffer();
        throw new TypeError("injected reset after mutation");
      }
      return response;
    };
    const driver = new BunnyDbDriver({ url: server.url, fetchImpl: faultFetch });
    await driver.query("CREATE TABLE phase_counter (n INTEGER)", []);
    await driver.query("INSERT INTO phase_counter VALUES (0)", []);
    await driver.readPhase(async () => {
      expect((await driver.query("SELECT n FROM phase_counter", [])).rows).toEqual([{ n: 0 }]);
      loseWriteReply = true;
      await expect(driver.query("UPDATE phase_counter SET n = n + 1", [])).rejects.toBeInstanceOf(DatabaseOutcomeUnknownError);
      expect((await driver.query("SELECT n FROM phase_counter", [])).rows).toEqual([{ n: 1 }]);
    });
  } finally { await server.close(); }
});
