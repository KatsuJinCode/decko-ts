// The defaults seed corpus ASSET loader: reads
// deploy/seed/defaults-seed-corpus.json (generated by
// tools/oracle/defaults-seed-corpus.rb from the pinned gem tree,
// card-mod-defaults-0.20.0/data/fixtures/real/*.yml) into the typed tables
// bootstrapFreshDeck inserts.
//
// NODE-ONLY BY CONTRACT, AND NEVER AN ENGINE-GRAPH IMPORT. This module
// exists so the corpus is boot-time data rather than compiled code: the
// corpus rode src/card/auth/defaults-seed-corpus.ts into the engine bundle
// and crossed the boot-safe budget (the v21 roll's refused build,
// tools/vendor/edge-bundle-budget.mjs, decision 0009). The loader's only
// callers are the boot host (vm-staging-server.mjs, which imports it from
// dist/) and the tests that pin the corpus row for row - nothing under
// src/card may import it, or the asset's bytes ride a bundle again. The
// static node:fs import is the loud marker of that boundary: an import of
// this module from bundle-graph code would put node:fs into a bundle whose
// entry headers inventory every node: import with a stated dependency.
//
// The asset path resolves by walking UP from this module to the nearest
// directory that carries deploy/seed/defaults-seed-corpus.json - the
// checkout root. The walk works from both layouts the loader runs in
// (src/card/auth/ under vitest, dist/src/card/auth/ under the host: tsc
// emits dist/src/... one level deeper, so no fixed climb serves both).
// A missing or malformed asset throws: a boot that cannot read its seed
// corpus must stop, not seed a partial deck (the same fail-closed rule
// boot-seed.ts states for a half-seeded deck).

import { readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import type {
  DefaultsFixtureActionRow,
  DefaultsFixtureActRow,
  DefaultsFixtureCardRow,
  DefaultsFixtureChangeRow,
  DefaultsFixtureReferenceRow,
  DefaultsSeedCorpusTables,
} from "./boot-seed.js";

/** The asset's on-disk shape: the generator's envelope around the five
 *  Cardio::Seed::TABLES tables (Ruby table names). */
interface DefaultsSeedCorpusAssetFile {
  readonly source: string;
  readonly generator: string;
  readonly seedModsIndex: number;
  readonly env: string;
  readonly rowNote: string;
  readonly tables: {
    readonly cards: readonly DefaultsFixtureCardRow[];
    readonly card_actions: readonly DefaultsFixtureActionRow[];
    readonly card_acts: readonly DefaultsFixtureActRow[];
    readonly card_changes: readonly DefaultsFixtureChangeRow[];
    readonly card_references: readonly DefaultsFixtureReferenceRow[];
  };
}

const ASSET_RELPATH = join("deploy", "seed", "defaults-seed-corpus.json");

/** The checkout root's copy of the asset, read by climbing from this
 *  module's directory (at most eight levels: src/card/auth and
 *  dist/src/card/auth both sit well inside that bound). Reading IS the
 *  probe: the first climb step whose candidate opens wins, so there is no
 *  exists-then-read race and every miss just keeps climbing. */
function readAssetRaw(): string {
  const start = dirname(fileURLToPath(import.meta.url));
  let dir = start;
  let lastTried = "";
  for (let up = 0; up < 8; up++, dir = dirname(dir)) {
    lastTried = join(dir, ASSET_RELPATH);
    try {
      return readFileSync(lastTried, "utf8");
    } catch {
      // keep climbing
    }
  }
  throw new Error(
    `the defaults seed corpus asset was not found climbing up from ` +
      `${start} (last tried ${lastTried})`,
  );
}

/** The repo's deploy seed asset, parsed and shape-checked. Table-by-table
 *  row counts are NOT re-pinned here (the census owns the counts, and the
 *  generator refuses a drifted corpus); a truncated or hand-mangled asset
 *  fails the array checks below instead of seeding partial tables. */
export function loadDefaultsSeedCorpusAsset(): DefaultsSeedCorpusTables {
  const raw = readAssetRaw();
  let parsed: unknown;
  try {
    parsed = JSON.parse(raw);
  } catch (error) {
    throw new Error(
      "the defaults seed corpus asset is unreadable JSON: " +
        `${error instanceof Error ? error.message : String(error)}`,
    );
  }
  const file = parsed as DefaultsSeedCorpusAssetFile;
  if (
    !file ||
    typeof file !== "object" ||
    file.env !== "real" ||
    file.seedModsIndex !== 0 ||
    !file.tables ||
    typeof file.tables !== "object"
  ) {
    throw new Error(
      "the defaults seed corpus asset is not the file " +
        "tools/oracle/defaults-seed-corpus.rb emits; regenerate it from the " +
        "pinned gem tree",
    );
  }
  const tables = file.tables;
  for (const rubyName of [
    "cards",
    "card_actions",
    "card_acts",
    "card_changes",
    "card_references",
  ] as const) {
    if (!Array.isArray(tables[rubyName])) {
      throw new Error(
        `the defaults seed corpus asset carries no ${rubyName} table array`,
      );
    }
  }
  return {
    cards: tables.cards,
    actions: tables.card_actions,
    acts: tables.card_acts,
    changes: tables.card_changes,
    references: tables.card_references,
  };
}
